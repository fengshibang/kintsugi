//===========================================================================
// Trigger: 未命名触发器 065
//===========================================================================
function Trig____________________065Actions takes nothing returns nothing
    if ( ( GetUnitTypeId(GetAttacker()) == 'n02Q' ) ) then
        call DisableTrigger(GetTriggeringTrigger())
        call CreateTextTagUnitBJ("刀阵旋风！！！", GetAttacker(), 0, 20.00, 100.00, 0.00, 0.00, 0)
        call YDWETimerDestroyTextTag(2 , GetLastCreatedTextTag())
        call YDWEPolledWaitNull(1.00)
        call UnitAddAbility(GetAttacker(), 'A0ID')
        call IssueImmediateOrder(GetAttacker(), "fanofknives")
        call YDWEPolledWaitNull(1.00)
        call UnitRemoveAbility(GetAttacker(), 'A0ID')
        call YDWEPolledWaitNull(8.00)
        call EnableTrigger(GetTriggeringTrigger())
    else
    endif
    if ( ( GetUnitTypeId(GetAttacker()) == 'n00H' ) ) then
        call DisableTrigger(GetTriggeringTrigger())
        call CreateTextTagUnitBJ("地刺！！！", GetAttacker(), 0, 20.00, 100.00, 0.00, 0.00, 0)
        call YDWETimerDestroyTextTag(3.00 , GetLastCreatedTextTag())
        call YDWEPolledWaitNull(1.00)
        call CreateNUnitsAtLocFacingLocBJ(1, 'e00D', Player(4), PolarProjectionBJ(GetUnitLoc(GetAttacker()), 300.00, GetUnitFacing(GetAttacker())), GetUnitLoc(GetAttacker()))
        call CreateUnitAtLoc(Player(4), 'e00D', PolarProjectionBJ(GetUnitLoc(GetAttacker()), 400.00, GetUnitFacing(GetAttacker())), 0)
        call CreateUnitAtLoc(Player(4), 'e00D', PolarProjectionBJ(GetUnitLoc(GetAttacker()), 500.00, GetUnitFacing(GetAttacker())), 0)
        call CreateUnitAtLoc(Player(4), 'e00D', PolarProjectionBJ(GetUnitLoc(GetAttacker()), 600.00, GetUnitFacing(GetAttacker())), 0)
        call DYCImpaleLinear(GetAttacker() , 300 , 600.00 , 100.00 , GetUnitX(GetAttacker()) , GetUnitY(GetAttacker()) , 2000 , AngleBetweenPoints(GetUnitLoc(GetAttacker()), GetUnitLoc(bj_lastCreatedUnit)) , GetOwningPlayer(GetAttacker()) , 1 , 'AEsh' , 'e00D' , "thunderbolt")
        call YDWEPolledWaitNull(9.00)
        call EnableTrigger(GetTriggeringTrigger())
    else
    endif
    if ( ( GetUnitTypeId(GetAttacker()) == 'n02R' ) ) then
        call DisableTrigger(GetTriggeringTrigger())
        call CreateTextTagUnitBJ("生命吸取！！！", GetAttacker(), 0, 20.00, 100.00, 0.00, 0.00, 0)
        call YDWETimerDestroyTextTag(2 , GetLastCreatedTextTag())
        call YDWEPolledWaitNull(1.00)
        call CreateNUnitsAtLocFacingLocBJ(1, 'e00K', Player(4), GetUnitLoc(GetAttacker()), GetUnitLoc(GetAttacker()))
        call IssueTargetOrder(bj_lastCreatedUnit, "drain", GetTriggerUnit())
        call YDWEPolledWaitNull(9.00)
        call EnableTrigger(GetTriggeringTrigger())
    else
    endif
    if ( ( GetUnitTypeId(GetAttacker()) == 'n027' ) ) then
        call DisableTrigger(GetTriggeringTrigger())
        call CreateTextTagUnitBJ("捆绑！！！", GetAttacker(), 0, 20.00, 100.00, 0.00, 0.00, 0)
        call YDWETimerDestroyTextTag(2 , GetLastCreatedTextTag())
        call YDWEPolledWaitNull(1.00)
        call UnitAddAbility(GetAttacker(), 'A0JK')
        call IssueTargetOrder(GetAttacker(), "entanglingroots", GetTriggerUnit())
        call YDWEPolledWaitNull(1.00)
        call UnitRemoveAbility(GetAttacker(), 'A0JK')
        call YDWEPolledWaitNull(8.00)
        call EnableTrigger(GetTriggeringTrigger())
    else
