//===========================================================================
// Trigger: 未命名触发器 099 复制 
//===========================================================================
function Trig____________________099_______uActions takes nothing returns nothing
    if ( ( GetUnitTypeId(GetAttacker()) == 'n04Y' ) ) then
        call DisableTrigger(GetTriggeringTrigger())
        call CreateTextTagUnitBJ("缠绕根须！！！", GetAttacker(), 0, 20.00, 100.00, 0.00, 0.00, 0)
        call YDWETimerDestroyTextTag(2 , GetLastCreatedTextTag())
        call YDWEPolledWaitNull(1.00)
        call CreateNUnitsAtLocFacingLocBJ(1, 'e02A', Player(4), GetRandomLocInRect(gg_rct______________001), GetUnitLoc(GetAttacker()))
        call CreateNUnitsAtLocFacingLocBJ(1, 'e02A', Player(4), GetRandomLocInRect(gg_rct______________001), GetUnitLoc(GetAttacker()))
        call CreateNUnitsAtLocFacingLocBJ(1, 'e02A', Player(4), GetRandomLocInRect(gg_rct______________001), GetUnitLoc(GetAttacker()))
        call UnitAddAbility(GetAttacker(), 'A0PE')
        call IssueTargetOrder(GetAttacker(), "entanglingroots", GetTriggerUnit())
        call YDWEPolledWaitNull(1.00)
        call UnitRemoveAbility(GetAttacker(), 'A0PE')
        call YDWEPolledWaitNull(3.00)
        call EnableTrigger(GetTriggeringTrigger())
    else
    endif
    if ( ( GetUnitTypeId(GetAttacker()) == 'n058' ) ) then
        call DisableTrigger(GetTriggeringTrigger())
        call CreateTextTagUnitBJ("分身！！！", GetAttacker(), 0, 20.00, 100.00, 0.00, 0.00, 0)
        call YDWETimerDestroyTextTag(1.00 , GetLastCreatedTextTag())
        call CreateUnitAtLoc(Player(4), 'h04E', GetRandomLocInRect(gg_rct______________001), 0)
        call YDWEPolledWaitNull(1.00)
        call EnableTrigger(GetTriggeringTrigger())
    else
    endif
    if ( ( GetUnitTypeId(GetAttacker()) == 'n06Z' ) ) then
        call DisableTrigger(GetTriggeringTrigger())
        set udg_lvlong=GetAttacker()
        call CreateTextTagUnitBJ("出来吧，弓箭手！！！", GetAttacker(), 0, 20.00, 100.00, 0.00, 0.00, 0)
        call YDWETimerDestroyTextTag(1.00 , GetLastCreatedTextTag())
        call CreateNUnitsAtLocFacingLocBJ(1, 'h06T', Player(4), GetRandomLocInRect(gg_rct______________001), GetRectCenter(gg_rct______________001))
        call CreateNUnitsAtLocFacingLocBJ(1, 'h06T', Player(4), GetRandomLocInRect(gg_rct______________001), GetRectCenter(gg_rct______________001))
        call CreateNUnitsAtLocFacingLocBJ(1, 'h06T', Player(4), GetRandomLocInRect(gg_rct______________001), GetRectCenter(gg_rct______________001))
        call YDWEPolledWaitNull(5.00)
        call EnableTrigger(GetTriggeringTrigger())
    else
    endif
endfunction
