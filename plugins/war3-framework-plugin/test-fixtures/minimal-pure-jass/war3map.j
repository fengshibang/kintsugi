        call AdjustPlayerStateBJ(10, GetOwningPlayer(GetEventDamageSource()), PLAYER_STATE_RESOURCE_GOLD)
    else
    endif
    if ( ( GetUnitAbilityLevel(GetEventDamageSource(), 'A0UI') >= 1 ) ) then
        call AdjustPlayerStateBJ(20, GetOwningPlayer(GetEventDamageSource()), PLAYER_STATE_RESOURCE_GOLD)
    else
    endif
    call EnableTrigger(GetTriggeringTrigger())
endfunction
