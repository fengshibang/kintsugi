function Trig____________________254_______uConditions takes nothing returns boolean
    return ( ( GetOwningPlayer(GetTriggerUnit()) == Player(4) ) )
endfunction
function Trig____________________254_______uActions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    if ( ( GetUnitAbilityLevel(GetEventDamageSource(), 'A0UE') >= 1 ) ) then
        call AdjustPlayerStateBJ(1, GetOwningPlayer(GetEventDamageSource()), PLAYER_STATE_RESOURCE_GOLD)
    else
    endif
    if ( ( GetUnitAbilityLevel(GetEventDamageSource(), 'A0UF') >= 1 ) ) then
        call AdjustPlayerStateBJ(3, GetOwningPlayer(GetEventDamageSource()), PLAYER_STATE_RESOURCE_GOLD)
    else
