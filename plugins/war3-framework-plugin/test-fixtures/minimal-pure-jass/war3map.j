function Trig____________________016_______uConditions takes nothing returns boolean
    return ( ( IsUnitType(GetManipulatingUnit(), UNIT_TYPE_HERO) == true ) and ( GetItemTypeId(GetManipulatedItem()) == 'I00A' ) )
endfunction
function Trig____________________016_______uActions takes nothing returns nothing
    local integer ydl_localvar_step= LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76)
 set ydl_localvar_step=ydl_localvar_step + 3
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76, ydl_localvar_step)
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7, ydl_localvar_step)
    call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x9E12DCCD, GetManipulatingUnit())
    call UnitAddItemByIdSwapped(udg_zhuangbei[GetRandomInt(( ( LoadInteger(YDHT, GetHandleId(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x9E12DCCD)), 0xFA1F6AB3) ) * ( 3 ) ), ( ( ( LoadInteger(YDHT, GetHandleId(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x9E12DCCD)), 0xFA1F6AB3) ) * ( 3 ) ) + 12 ))], GetManipulatingUnit())
    call AddSpecialEffectTargetUnitBJ("origin", GetManipulatingUnit(), "Abilities\\Spells\\Human\\ReviveHuman\\ReviveHuman.mdl")
    call FlushChildHashtable(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step)
endfunction
