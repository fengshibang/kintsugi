//===========================================================================
// Trigger: 未命名触发器 185 复制
//===========================================================================
function Trig____________________185_______uActions takes nothing returns nothing
    if ( ( GetItemTypeId(GetSoldItem()) == 'I0BW' ) and ( GetHeroStr(GetBuyingUnit(), false) > 100 ) ) then
        call CreateTextTagUnitBJ("力量转换敏捷！！", GetBuyingUnit(), 0, 20.00, 100.00, 0.00, 0.00, 0)
        call YDWETimerDestroyTextTag(2.00 , GetLastCreatedTextTag())
        call ModifyHeroStat(bj_HEROSTAT_STR, GetBuyingUnit(), bj_MODIFYMETHOD_SUB, 100)
        call ModifyHeroStat(bj_HEROSTAT_AGI, GetBuyingUnit(), bj_MODIFYMETHOD_ADD, 100)
        call AddSpecialEffectLocBJ(GetUnitLoc(GetBuyingUnit()), "Abilities\\Spells\\Human\\Polymorph\\PolyMorphDoneGround.mdl")
    else
        if ( ( GetItemTypeId(GetSoldItem()) == 'I0BW' ) and ( GetHeroStr(GetBuyingUnit(), false) <= 100 ) ) then
            call AdjustPlayerStateBJ(100, GetOwningPlayer(GetBuyingUnit()), PLAYER_STATE_RESOURCE_GOLD)
            call DisplayTextToPlayer(GetOwningPlayer(GetBuyingUnit()), 0, 0, "|cffffff00你的属性不够了，转换失败！|r")
        else
        endif
    endif
    if ( ( GetItemTypeId(GetSoldItem()) == 'I0BX' ) and ( GetHeroStr(GetBuyingUnit(), false) > 100 ) ) then
        call CreateTextTagUnitBJ("力量转换智力！！", GetBuyingUnit(), 0, 20.00, 100.00, 0.00, 0.00, 0)
        call YDWETimerDestroyTextTag(2.00 , GetLastCreatedTextTag())
        call ModifyHeroStat(bj_HEROSTAT_STR, GetBuyingUnit(), bj_MODIFYMETHOD_SUB, 100)
        call ModifyHeroStat(bj_HEROSTAT_INT, GetBuyingUnit(), bj_MODIFYMETHOD_ADD, 100)
        call AddSpecialEffectLocBJ(GetUnitLoc(GetBuyingUnit()), "Abilities\\Spells\\Human\\Polymorph\\PolyMorphDoneGround.mdl")
    else
        if ( ( GetItemTypeId(GetSoldItem()) == 'I0BX' ) and ( GetHeroStr(GetBuyingUnit(), false) <= 100 ) ) then
            call AdjustPlayerStateBJ(100, GetOwningPlayer(GetBuyingUnit()), PLAYER_STATE_RESOURCE_GOLD)
            call DisplayTextToPlayer(GetOwningPlayer(GetBuyingUnit()), 0, 0, "|cffffff00你的属性不够了，转换失败！|r")
        else
        endif
    endif
    if ( ( GetItemTypeId(GetSoldItem()) == 'I0BY' ) and ( GetHeroAgi(GetBuyingUnit(), false) > 100 ) ) then
        call CreateTextTagUnitBJ("敏捷转换力量！！", GetBuyingUnit(), 0, 20.00, 0.00, 100.00, 0.00, 0)
        call YDWETimerDestroyTextTag(2.00 , GetLastCreatedTextTag())
        call ModifyHeroStat(bj_HEROSTAT_AGI, GetBuyingUnit(), bj_MODIFYMETHOD_SUB, 100)
        call ModifyHeroStat(bj_HEROSTAT_STR, GetBuyingUnit(), bj_MODIFYMETHOD_ADD, 100)
        call AddSpecialEffectLocBJ(GetUnitLoc(GetBuyingUnit()), "Abilities\\Spells\\Human\\Polymorph\\PolyMorphDoneGround.mdl")
    else
        if ( ( GetItemTypeId(GetSoldItem()) == 'I0BY' ) and ( GetHeroAgi(GetBuyingUnit(), false) <= 100 ) ) then
            call AdjustPlayerStateBJ(100, GetOwningPlayer(GetBuyingUnit()), PLAYER_STATE_RESOURCE_GOLD)
            call DisplayTextToPlayer(GetOwningPlayer(GetBuyingUnit()), 0, 0, "|cffffff00你的属性不够了，转换失败！|r")
        else
        endif
    endif
    if ( ( GetItemTypeId(GetSoldItem()) == 'I0C5' ) and ( GetHeroAgi(GetBuyingUnit(), false) > 100 ) ) then
        call CreateTextTagUnitBJ("敏捷转换智力！！", GetBuyingUnit(), 0, 20.00, 0.00, 100.00, 0.00, 0)
        call YDWETimerDestroyTextTag(2.00 , GetLastCreatedTextTag())
        call ModifyHeroStat(bj_HEROSTAT_AGI, GetBuyingUnit(), bj_MODIFYMETHOD_SUB, 100)
        call ModifyHeroStat(bj_HEROSTAT_INT, GetBuyingUnit(), bj_MODIFYMETHOD_ADD, 100)
        call AddSpecialEffectLocBJ(GetUnitLoc(GetBuyingUnit()), "Abilities\\Spells\\Human\\Polymorph\\PolyMorphDoneGround.mdl")
    else
        if ( ( GetItemTypeId(GetSoldItem()) == 'I0C5' ) and ( GetHeroAgi(GetBuyingUnit(), false) <= 100 ) ) then
            call AdjustPlayerStateBJ(100, GetOwningPlayer(GetBuyingUnit()), PLAYER_STATE_RESOURCE_GOLD)
            call DisplayTextToPlayer(GetOwningPlayer(GetBuyingUnit()), 0, 0, "|cffffff00你的属性不够了，转换失败！|r")
        else
        endif
    endif
    if ( ( GetItemTypeId(GetSoldItem()) == 'I0C6' ) and ( GetHeroInt(GetBuyingUnit(), false) > 100 ) ) then
        call CreateTextTagUnitBJ("智力转换力量！！", GetBuyingUnit(), 0, 20.00, 0.00, 0.00, 100.00, 0)
        call YDWETimerDestroyTextTag(2.00 , GetLastCreatedTextTag())
        call ModifyHeroStat(bj_HEROSTAT_INT, GetBuyingUnit(), bj_MODIFYMETHOD_SUB, 100)
        call ModifyHeroStat(bj_HEROSTAT_STR, GetBuyingUnit(), bj_MODIFYMETHOD_ADD, 100)
        call AddSpecialEffectLocBJ(GetUnitLoc(GetBuyingUnit()), "Abilities\\Spells\\Human\\Polymorph\\PolyMorphDoneGround.mdl")
