//===========================================================================
// Trigger: 未命名触发器 039 复制
//===========================================================================
function Trig____________________039_______uFunc003Func005A takes nothing returns nothing
    call KillUnit(GetEnumUnit())
endfunction
function Trig____________________039_______uFunc003Func006A takes nothing returns nothing
    call KillUnit(GetEnumUnit())
endfunction
function Trig____________________039_______uFunc003Func007A takes nothing returns nothing
    call KillUnit(GetEnumUnit())
endfunction
function Trig____________________039_______uActions takes nothing returns nothing
    local group ydl_group
    local unit ydl_unit
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'H00W' ) ) then
        call DisableTrigger(GetTriggeringTrigger())
        call DYCdmgdodge(( ( (I2R(GetUnitAbilityLevel((GetTriggerUnit() ), ( 'A0II')))) ) * ( 0.05 ) )) // INLINED!!
        call EnableTrigger(GetTriggeringTrigger())
    else
        call DoNothing()
    endif
    if ( ( GetUnitAbilityLevel(GetTriggerUnit(), 'A0JN') >= 1 ) ) then
        call DisableTrigger(GetTriggeringTrigger())
        call DYCdmgdodge(1.00)
        call EnableTrigger(GetTriggeringTrigger())
    else
        call DoNothing()
    endif
    if ( ( GetUnitAbilityLevel(GetTriggerUnit(), 'A0JN') >= 1 ) ) then
        call DisableTrigger(GetTriggeringTrigger())
        call CreateTextTagUnitBJ("全图抹杀！！！", GetTriggerUnit(), 0, 30.00, 100.00, 0.00, 0.00, 0)
        call YDWETimerDestroyTextTag(10.00 , GetLastCreatedTextTag())
        call ForGroupBJ(YDWEGetUnitsInRectOfPlayerNull(GetPlayableMapRect() , Player(0)), function Trig____________________039_______uFunc003Func005A)
        call ForGroupBJ(YDWEGetUnitsInRectOfPlayerNull(GetPlayableMapRect() , Player(1)), function Trig____________________039_______uFunc003Func006A)
        call ForGroupBJ(YDWEGetUnitsInRectOfPlayerNull(GetPlayableMapRect() , Player(2)), function Trig____________________039_______uFunc003Func007A)
        call YDWEPolledWaitNull(1.00)
        call EnableTrigger(GetTriggeringTrigger())
    else
        call DoNothing()
    endif
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'n05F' ) ) then
        call DisableTrigger(GetTriggeringTrigger())
        call DYCdmgdodge(0.90)
        call EnableTrigger(GetTriggeringTrigger())
    else
        call DoNothing()
    endif
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'n06Q' ) ) then
        call DisableTrigger(GetTriggeringTrigger())
        call DYCdmgdodge(0.90)
        call EnableTrigger(GetTriggeringTrigger())
    else
        call DoNothing()
    endif
    set ydl_group=null
    set ydl_unit=null
endfunction
//===========================================================================
function InitTrig____________________039_______u takes nothing returns nothing
    set gg_trg____________________039_______u=CreateTrigger()
    call YDWESyStemAnyUnitDamagedRegistTrigger(gg_trg____________________039_______u)
    call TriggerAddAction(gg_trg____________________039_______u, function Trig____________________039_______uActions)
endfunction
