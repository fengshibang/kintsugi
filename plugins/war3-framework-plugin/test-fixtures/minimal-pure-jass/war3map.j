    set s=( 350.00 * GetUnitTurnSpeed(d1) ) + 35
    call SetUnitFlyHeight(dan, s, 100000.00)
    set danE=CreateUnit(GetOwningPlayer(d1), z2, GetUnitX(d1), GetUnitY(d1), 0)
    set s=( 3.00 * GetUnitTurnSpeed(d1) )
    call SetUnitScale(danE, s, s, s)
    set s=( 350.00 * GetUnitTurnSpeed(d1) )
    call SetUnitFlyHeight(danE, s, 100000.00)
    call SaveBoolean(YDHT, GetHandleId(d1), 0x37FDCE3D, true)
    call SaveUnitHandle(YDHT, GetHandleId(j), 1, d1)
    call SaveUnitHandle(YDHT, GetHandleId(j), 2, dan)
    call SaveUnitHandle(YDHT, GetHandleId(j), 3, danE)
    call SaveReal(YDHT, GetHandleId(j), 4, 0)
    call TimerStart(j, 0.03, true, function ZEROZAG28A)
    else
    endif
    
    set j=null
endfunction
