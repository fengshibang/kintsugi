    //平移镜头到坐标
    //平移(玩家)的镜头到 (X轴坐标 , Y轴坐标), 持续 (实数) 秒
    function SoMoveCamera takes player whichPlayer,real x,real y,real duration returns nothing
        if ( GetLocalPlayer() == whichPlayer ) then
            call PanCameraToTimed(x, y, duration)
        endif
    endfunction
