//===========================================================================
// Trigger: 未命名触发器 072
//===========================================================================
function Trig____________________072Conditions takes nothing returns boolean
    return ( ( GetOwningPlayer(GetTriggerUnit()) == Player(4) ) )
endfunction
function Trig____________________072Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    if ( ( GetUnitAbilityLevel(GetEventDamageSource(), 'A0D2') >= 1 ) ) then
        if ( ( (GetRandomInt(1, 100)) <= ( ( GetUnitAbilityLevel(GetEventDamageSource(), 'A0D2') ) * ( 10 ) ) ) ) then // INLINED!!
            call SoHeroStateAmend(GetEventDamageSource() , 1 , 1 , 1)
        else
        endif
    else
    endif
    if ( ( GetUnitAbilityLevel(GetEventDamageSource(), 'A0D3') >= 1 ) ) then
        if ( ( (GetRandomInt(1, 100)) <= ( ( GetUnitAbilityLevel(GetEventDamageSource(), 'A0D3') ) * ( 10 ) ) ) ) then // INLINED!!
            call SoAddUnitState(GetEventDamageSource() , 3.00 , UNIT_STATE_MAX_LIFE)
            call SoAddUnitState(GetEventDamageSource() , 3.00 , UNIT_STATE_LIFE)
        else
        endif
    else
    endif
    if ( ( GetUnitAbilityLevel(GetEventDamageSource(), 'A0J4') >= 1 ) ) then
        if ( ( (GetRandomInt(1, 100)) <= ( ( GetUnitAbilityLevel(GetEventDamageSource(), 'A0J4') ) * ( 10 ) ) ) ) then // INLINED!!
            call AdjustPlayerStateBJ(1, GetOwningPlayer(GetEventDamageSource()), PLAYER_STATE_RESOURCE_GOLD)
        else
        endif
    else
    endif
    if ( ( GetUnitAbilityLevel(GetEventDamageSource(), 'A007') >= 1 ) ) then
        if ( ( (GetRandomInt(1, 100)) <= ( ( GetUnitAbilityLevel(GetEventDamageSource(), 'A007') ) * ( 1 ) ) ) ) then // INLINED!!
            call UnitResetCooldown(GetEventDamageSource())
            call CreateTextTagUnitBJ("刷新！！！", GetEventDamageSource(), 0, 20.00, 100.00, 0.00, 0.00, 0)
            call YDWETimerDestroyTextTag(2 , GetLastCreatedTextTag())
            call YDWEPolledWaitNull(2)
        else
        endif
    else
    endif
    call EnableTrigger(GetTriggeringTrigger())
endfunction
//===========================================================================
function InitTrig____________________072 takes nothing returns nothing
    set gg_trg____________________072=CreateTrigger()
    call YDWESyStemAnyUnitDamagedRegistTrigger(gg_trg____________________072)
    call TriggerAddCondition(gg_trg____________________072, Condition(function Trig____________________072Conditions))
    call TriggerAddAction(gg_trg____________________072, function Trig____________________072Actions)
endfunction
