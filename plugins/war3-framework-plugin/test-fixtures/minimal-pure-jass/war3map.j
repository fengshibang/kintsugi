function ZEROZAG21 takes integer z1,unit d,integer z2 returns nothing
    local integer array Z
    local unit array danT
        if ( ( IsUnitType(d, UNIT_TYPE_HERO) == true ) ) then
        if ( ( ( z1 == 1 ) or ( ( z1 == 3 ) and ( z2 > GetHeroXP(d) ) ) ) ) then
        if ( ( z1 == 1 ) ) then
            call AddHeroXP(d, z2, true)
        else
            set z2=( z2 - GetHeroXP(d) )
            call AddHeroXP(d, z2, true)
        endif
    else
        set danT[1]=CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'Hpal', 0, 0, 0)
        if ( ( z1 == 2 ) ) then
            set Z[2]=( GetHeroXP(d) - z2 )
        else
        endif
        if ( ( z1 == 3 ) ) then
            set Z[2]=z2
        else
        endif
        if ( ( z1 >= 2 ) ) then
            call SaveBoolean(YDHT, GetHandleId(d), 0xD2E27949, true)
            if ( ( Z[2] < 0 ) ) then
                set Z[2]=0
            else
            endif
            call SetHeroXP(danT[1], Z[2], false)
            set Z[3]=GetHeroLevel(danT[1])
            if ( ( Z[3] == 1 ) ) then
                set Z[4]=( Z[3] + 1 )
            else
                set Z[4]=( Z[3] - 1 )
            endif
            call SetHeroLevelBJ(d, Z[4], false)
            call SetHeroLevelBJ(d, Z[3], false)
            call SetHeroXP(d, Z[2], false)
            call SaveBoolean(YDHT, GetHandleId(d), 0xD2E27949, false)
        else
        endif
        call RemoveUnit(danT[1])
    endif
    else
    endif
    
endfunction
function ZEROZAG20 takes unit d,integer z1,integer z2,integer z3,integer z4 returns nothing
    
    if ( z1 == 1 ) then
    call UnitAddAbility(d, z2)
    call SetUnitAbilityLevel(d, z2, z3)
    else
    call UnitRemoveAbility(d, z2)
    endif
    if ( ( z4 != 0 ) ) then
    call SaveInteger(ZEROZAG___jnhhtt, 1, z4, ( z2 ))
    call SaveInteger(ZEROZAG___jnhhtt, 2, ( z2 ), z4)
    else
    endif
endfunction
function ZEROZAG19 takes integer z1,unit d,integer z2,integer z3 returns nothing
    if ( ( z1 == 1 ) ) then
        call ModifyHeroStat(bj_HEROSTAT_STR, d, z2, z3)
    else
        if ( ( z1 == 2 ) ) then
            call ModifyHeroStat(bj_HEROSTAT_AGI, d, z2, z3)
        else
            if ( ( z1 == 3 ) ) then
                call ModifyHeroStat(bj_HEROSTAT_INT, d, z2, z3)
            else
                call ModifyHeroStat(bj_HEROSTAT_STR, d, z2, z3)
                call ModifyHeroStat(bj_HEROSTAT_AGI, d, z2, z3)
                call ModifyHeroStat(bj_HEROSTAT_INT, d, z2, z3)
            endif
        endif
    endif
endfunction
