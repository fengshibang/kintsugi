// endfunction
// [END_ECS_MIGRATED]
//===========================================================================
// Trigger: 未命名触发器 171
//===========================================================================
function Trig____________________171Actions takes nothing returns nothing
    if ( ( IsUnitType(GetManipulatingUnit(), UNIT_TYPE_HERO) == true ) and ( GetItemTypeId(GetManipulatedItem()) == 'I0A8' ) ) then
        call UnitAddItemByIdSwapped(udg_qixingshi[GetRandomInt(1, 32)], GetManipulatingUnit())
        call AddSpecialEffectTargetUnitBJ("origin", GetManipulatingUnit(), "Abilities\\Spells\\Demon\\DarkPortal\\DarkPortalTarget.mdl")
        call RemoveItem(GetManipulatedItem())
    else
    endif
    if ( ( IsUnitType(GetManipulatingUnit(), UNIT_TYPE_HERO) == true ) and ( GetItemTypeId(GetManipulatedItem()) == 'I0A9' ) ) then
        call UnitAddItemByIdSwapped('I006', GetManipulatingUnit())
        call AddSpecialEffectTargetUnitBJ("origin", GetManipulatingUnit(), "Abilities\\Spells\\Demon\\DarkPortal\\DarkPortalTarget.mdl")
        call RemoveItem(GetManipulatedItem())
    else
    endif
endfunction
