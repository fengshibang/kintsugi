//===========================================================================
// Trigger: 未命名触发器 026
//===========================================================================
function Trig____________________026Conditions takes nothing returns boolean
    return ( ( GetOwningPlayer(GetTriggerUnit()) == Player(4) ) )
endfunction
function Trig____________________026Actions takes nothing returns nothing
    if ( ( GetUnitAbilityLevel(GetEventDamageSource(), 'A00G') <= 9 ) and ( GetUnitAbilityLevel(GetEventDamageSource(), 'A00G') >= 1 ) ) then
        if ( ( GetRandomInt(1, 100) <= 1 ) ) then
            call IncUnitAbilityLevel(GetEventDamageSource(), 'A00G')
            call DisplayTextToPlayer(GetOwningPlayer(GetEventDamageSource()), 0, 0, "英雄经过长时间的战斗，|cffff0000破甲击|r等级提升了！！")
        else
        endif
    else
    endif
    if ( ( GetUnitAbilityLevel(GetEventDamageSource(), 'A00E') <= 9 ) and ( GetUnitAbilityLevel(GetEventDamageSource(), 'A00E') >= 1 ) ) then
        if ( ( GetRandomInt(1, 100) <= 1 ) ) then
            call IncUnitAbilityLevel(GetEventDamageSource(), 'A00E')
            call DisplayTextToPlayer(GetOwningPlayer(GetEventDamageSource()), 0, 0, "英雄经过长时间的战斗，|cffff0000吸血光环|r等级提升了！！")
        else
        endif
    else
    endif
    if ( ( GetUnitAbilityLevel(GetEventDamageSource(), 'A00F') <= 9 ) and ( GetUnitAbilityLevel(GetEventDamageSource(), 'A00F') >= 1 ) ) then
        if ( ( GetRandomInt(1, 100) <= 1 ) ) then
            call IncUnitAbilityLevel(GetEventDamageSource(), 'A00F')
            call DisplayTextToPlayer(GetOwningPlayer(GetEventDamageSource()), 0, 0, "英雄经过长时间的战斗，|cffff0000耐久光环|r等级提升了！！")
        else
        endif
    else
    endif
    if ( ( GetUnitAbilityLevel(GetEventDamageSource(), 'A01F') <= 9 ) and ( GetUnitAbilityLevel(GetEventDamageSource(), 'A01F') >= 1 ) ) then
        if ( ( GetRandomInt(1, 100) <= 1 ) ) then
            call IncUnitAbilityLevel(GetEventDamageSource(), 'A01F')
            call DisplayTextToPlayer(GetOwningPlayer(GetEventDamageSource()), 0, 0, "英雄经过长时间的战斗，|cffff0000命令光环|r等级提升了！！")
        else
        endif
    else
    endif
    if ( ( GetUnitAbilityLevel(GetEventDamageSource(), 'A01H') <= 9 ) and ( GetUnitAbilityLevel(GetEventDamageSource(), 'A01H') >= 1 ) ) then
        if ( ( GetRandomInt(1, 100) <= 1 ) ) then
            call IncUnitAbilityLevel(GetEventDamageSource(), 'A01H')
            call DisplayTextToPlayer(GetOwningPlayer(GetEventDamageSource()), 0, 0, "英雄经过长时间的战斗，|cffff0000强击光环|r等级提升了！！")
        else
        endif
    else
    endif
endfunction
//===========================================================================
function InitTrig____________________026 takes nothing returns nothing
    set gg_trg____________________026=CreateTrigger()
    call YDWESyStemAnyUnitDamagedRegistTrigger(gg_trg____________________026)
    call TriggerAddCondition(gg_trg____________________026, Condition(function Trig____________________026Conditions))
    call TriggerAddAction(gg_trg____________________026, function Trig____________________026Actions)
endfunction
