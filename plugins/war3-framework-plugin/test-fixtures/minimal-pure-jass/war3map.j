//===========================================================================
// Trigger: 未命名触发器 248
//===========================================================================
function Trig____________________248Conditions takes nothing returns boolean
    return ( ( GetOwningPlayer(GetTriggerUnit()) == Player(4) ) )
endfunction
function Trig____________________248Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    if ( ( YDWEUnitHasItemOfTypeBJNull(GetEventDamageSource() , 'I0LQ') == true ) and ( GetPlayerState(GetOwningPlayer(GetEventDamageSource()), PLAYER_STATE_RESOURCE_GOLD) > 0 ) ) then
        call SoAddUnitState(GetEventDamageSource() , ( ( I2R(GetPlayerState(GetOwningPlayer(GetEventDamageSource()), PLAYER_STATE_RESOURCE_GOLD)) ) * ( 3.00 ) ) , UNIT_STATE_MAX_LIFE)
        call SoAddUnitState(GetEventDamageSource() , ( ( I2R(GetPlayerState(GetOwningPlayer(GetEventDamageSource()), PLAYER_STATE_RESOURCE_GOLD)) ) * ( 3.00 ) ) , UNIT_STATE_LIFE)
        call YDWEPolledWaitNull(0.10)
        call SetPlayerStateBJ(GetOwningPlayer(GetEventDamageSource()), PLAYER_STATE_RESOURCE_GOLD, 0)
    else
    endif
    if ( ( YDWEUnitHasItemOfTypeBJNull(GetEventDamageSource() , 'I0MI') == true ) and ( GetPlayerState(GetOwningPlayer(GetEventDamageSource()), PLAYER_STATE_RESOURCE_GOLD) > 0 ) ) then
        call SoAddUnitState(GetEventDamageSource() , ( ( I2R(GetPlayerState(GetOwningPlayer(GetEventDamageSource()), PLAYER_STATE_RESOURCE_GOLD)) ) * ( 1.00 ) ) , ConvertUnitState(0x13))
        call YDWEPolledWaitNull(0.10)
        call SetPlayerStateBJ(GetOwningPlayer(GetEventDamageSource()), PLAYER_STATE_RESOURCE_GOLD, 0)
    else
    endif
    call YDWEPolledWaitNull(3.00)
    call EnableTrigger(GetTriggeringTrigger())
endfunction
//===========================================================================
function InitTrig____________________248 takes nothing returns nothing
    set gg_trg____________________248=CreateTrigger()
    call YDWESyStemAnyUnitDamagedRegistTrigger(gg_trg____________________248)
    call TriggerAddCondition(gg_trg____________________248, Condition(function Trig____________________248Conditions))
    call TriggerAddAction(gg_trg____________________248, function Trig____________________248Actions)
endfunction
//===========================================================================
// Trigger: 未命名触发器 248 复制
//===========================================================================
function Trig____________________248_______uConditions takes nothing returns boolean
    return ( ( GetOwningPlayer(GetTriggerUnit()) == Player(4) ) )
endfunction
function Trig____________________248_______uActions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    if ( ( YDWEUnitHasItemOfTypeBJNull(GetEventDamageSource() , 'I0M3') == true ) ) then
        if ( ( (GetRandomInt(1, 100)) <= 10 ) ) then // INLINED!!
            call UnitDamageTarget(GetEventDamageSource(), GetTriggerUnit(), Xcallf(GetEventDamageSource() , UNIT_STATE_MAX_LIFE , 1), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS)
            call CreateTextTagUnitBJ("生命冲击！！！", GetEventDamageSource(), 0, 20.00, 100.00, 0.00, 0.00, 0)
            call YDWETimerDestroyTextTag(2 , GetLastCreatedTextTag())
        else
        endif
    else
    endif
    if ( ( YDWEUnitHasItemOfTypeBJNull(GetEventDamageSource() , 'I0PU') == true ) ) then
        if ( ( (GetRandomInt(1, 100)) <= 10 ) ) then // INLINED!!
            call UnitDamageTarget(GetEventDamageSource(), GetTriggerUnit(), Xcallf(GetEventDamageSource() , UNIT_STATE_MAX_MANA , 1), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS)
            call CreateTextTagUnitBJ("魔法冲击！！！", GetEventDamageSource(), 0, 20.00, 100.00, 0.00, 0.00, 0)
            call YDWETimerDestroyTextTag(2 , GetLastCreatedTextTag())
        else
        endif
    else
    endif
    if ( ( YDWEUnitHasItemOfTypeBJNull(GetEventDamageSource() , 'I0N8') == true ) ) then
        if ( ( (GetRandomInt(1, 100)) <= 10 ) ) then // INLINED!!
            call UnitDamageTarget(GetEventDamageSource(), GetTriggerUnit(), Xcalld(GetEventDamageSource() , (LoadInteger(XGGetHeroMainAttr__htb, GetUnitTypeId((GetEventDamageSource())), 0)) , true , 10.00), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS) // INLINED!!
            call CreateTextTagUnitBJ("属性暴击！！！", GetEventDamageSource(), 0, 20.00, 100.00, 0.00, 0.00, 0)
            call YDWETimerDestroyTextTag(2 , GetLastCreatedTextTag())
        else
        endif
    else
    endif
    call EnableTrigger(GetTriggeringTrigger())
endfunction
//===========================================================================
function InitTrig____________________248_______u takes nothing returns nothing
    set gg_trg____________________248_______u=CreateTrigger()
    call YDWESyStemAnyUnitDamagedRegistTrigger(gg_trg____________________248_______u)
    call TriggerAddCondition(gg_trg____________________248_______u, Condition(function Trig____________________248_______uConditions))
    call TriggerAddAction(gg_trg____________________248_______u, function Trig____________________248_______uActions)
endfunction
