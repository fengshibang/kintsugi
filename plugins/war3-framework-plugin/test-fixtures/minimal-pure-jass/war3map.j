//library SoMagicPatch:
	//野怪复活
 function Creeps_initXY takes nothing returns nothing
		if ( GetOwningPlayer(GetEnumUnit()) == Player(12) ) then
    		call SaveReal(hst, GetHandleId(GetEnumUnit()), StringHash("X"), GetUnitX(GetEnumUnit()))
    		call SaveReal(hst, GetHandleId(GetEnumUnit()), StringHash("Y"), GetUnitY(GetEnumUnit()))
		endif
	endfunction
 function Creeps_FalseXY takes nothing returns nothing
		if ( GetOwningPlayer(GetEnumUnit()) == Player(12) ) then
    		call SaveReal(hst, GetHandleId(GetEnumUnit()), StringHash("XX"), GetUnitX(GetEnumUnit()))
    		call SaveReal(hst, GetHandleId(GetEnumUnit()), StringHash("YY"), GetUnitY(GetEnumUnit()))
		endif
	endfunction
 function CreepsRenew_Timer takes nothing returns nothing
  local timer t= GetExpiredTimer()
  local unit c= LoadUnitHandle(hst, GetHandleId(t), 1)
  local player p= GetOwningPlayer(c)
  local group Creeps= LoadGroupHandle(hst, GetHandleId(Player(12)), StringHash("Creeps"))
  local real x= 0
  local real y= 0
  local unit n
    	call DestroyTimer(t)
    	if SoRenewMode == false then
        	set x=LoadReal(hst, GetHandleId(c), StringHash("X"))
        	set y=LoadReal(hst, GetHandleId(c), StringHash("Y"))
        	set n=CreateUnit(p, GetUnitTypeId(c), x, y, GetRandomReal(0, 360.0))
        	call GroupAddUnit(Creeps, n)
        	call SaveReal(hst, GetHandleId(n), StringHash("X"), x)
        	call SaveReal(hst, GetHandleId(n), StringHash("Y"), y)
        	elseif SoRenewMode == true then
            	set x=LoadReal(hst, GetHandleId(c), StringHash("XX"))
            	set y=LoadReal(hst, GetHandleId(c), StringHash("YY"))
            	set n=CreateUnit(p, GetUnitTypeId(c), x, y, GetRandomReal(0, 360.0))
            	call GroupAddUnit(Creeps, n)
            	call SaveReal(hst, GetHandleId(n), StringHash("XX"), x)
            	call SaveReal(hst, GetHandleId(n), StringHash("YY"), y)
    	endif
    	if SoRenewHomingEffect != "null" then
        	call DestroyEffect(AddSpecialEffect(SoRenewHomingEffect, x, y))
    	endif
		set t=null
		set Creeps=null
		set c=null
		set n=null
		set p=null
	endfunction
 function RenewCreepsActions takes nothing returns nothing
  local unit c= GetTriggerUnit()
  local player p= GetOwningPlayer(c)
  local group Creeps
  local timer t
		if SoRenewStatus == true then
			set Creeps=LoadGroupHandle(hst, GetHandleId(Player(12)), StringHash("Creeps"))
			if IsUnitInGroup(c, Creeps) == true then
    			set t=CreateTimer()
    			call SaveUnitHandle(hst, GetHandleId(t), 1, c)
    			call TimerStart(t, SoRenewTime, false, function CreepsRenew_Timer)
    			set t=null
			endif
		endif
		set c=null
		set p=null
		set Creeps=null
	endfunction
	//启动野怪复活
 function SoSetCreepsRenew takes real time,boolean TF returns nothing
  local group Creeps= LoadGroupHandle(hst, GetHandleId(Player(12)), StringHash("Creeps"))
    	set SoRenewMode=TF
    	if TF == true then
        	call ForGroupBJ(Creeps, function Creeps_FalseXY)
    	endif
    	set SoRenewStatus=true
    	set SoRenewTime=time
    	set Creeps=null
	endfunction
	//关闭野怪复活 
 function SoDisCreepsRenew takes nothing returns nothing
		set SoRenewStatus=false
	endfunction
	//设置野怪复活特效
	//设置后才能显示特效 
 function SoSetRenewHoming takes string s returns nothing
		set SoRenewHomingEffect=s
	endfunction
	//关闭野怪复活特效
 function SoDisRenewHoming takes nothing returns nothing
		set SoRenewHomingEffect="null"
	endfunction
	//野怪复活状态
 function SoGetRenewStatus takes nothing returns boolean
	    return SoRenewStatus
	endfunction
//***********************************************End*********************************************************
    function SoGetUcfiDefaultValue takes nothing returns integer
        return UCFI_Quantity_DefaultValue
    endfunction
//掉落物品
 function SoMagicPatch___UCFI_Actions_SouL takes nothing returns nothing
     local unit c= GetTriggerUnit()
     local item FI= null
     local integer iz= GetUnitTypeId(c) + SoMagicPatch___UFallI_HashValue
     local integer in= 0
     local integer io= 0
     local integer pid= 0
     local integer k= 0
     local integer ngz= 0
     local integer ngk= GetRandomInt(1, 100)
     local integer SF_K= LoadInteger(hst, iz, StringHash("UCFI_SFK"))
    	if SF_K != 0 then
    		if ( SF_K == 1 ) then
        		set pid=LoadInteger(hst, iz, StringHash("Fall Itemcode"))
        		set k=LoadInteger(hst, iz, StringHash("Fall Itemcode number"))
        		set ngz=LoadInteger(hst, iz, StringHash("Fall Itemcode Maybe"))
        		if ( ngk <= ngz and ngz > 0 ) then
            		set FI=CreateItem(pid, GetUnitX(c), GetUnitY(c))
            		if ( k != - 1 ) then
                		call SetItemCharges(FI, k)
             		endif
        		endif
    		elseif ( SF_K == 2 ) then
        		set io=LoadInteger(hst, iz, StringHash("Fall Itemtype"))
        		set in=LoadInteger(hst, iz, StringHash("Fall Itemcode level"))
        		set pid=ChooseRandomItemEx(SoGetItemTypeForVal(io), in)
        		set k=LoadInteger(hst, iz, StringHash("Fall Itemcode number"))
        		set ngz=LoadInteger(hst, iz, StringHash("Fall Itemcode Maybe"))
        		if ( ngk <= ngz and ngz > 0 ) then
            		set FI=CreateItem(pid, GetUnitX(c), GetUnitY(c))
            		if ( k != - 1 ) then
                		call SetItemCharges(FI, k)
            		endif
        		endif
    		endif
    	endif
    	set c=null
    	set FI=null
	endfunction
	//添加掉落物
 function SoSetUnitCodeFallItem takes integer uid,integer iid,integer kn,integer ngz returns nothing
     local integer iz= uid + SoMagicPatch___UFallI_HashValue
    	call SaveInteger(hst, iz, StringHash("Fall Itemcode"), iid)
    	call SaveInteger(hst, iz, StringHash("UCFI_SFK"), 1)
    	call SaveInteger(hst, iz, StringHash("Fall Itemcode number"), kn)
    	call SaveInteger(hst, iz, StringHash("Fall Itemcode Maybe"), ngz)
	endfunction
	
	//添加掉落物(随机)
 function SoSetUnitCodeFallRandomItem takes integer uid,integer in,itemtype io,integer kn,integer ngz returns nothing
     local integer iz= uid + SoMagicPatch___UFallI_HashValue
    	call SaveInteger(hst, iz, StringHash("Fall Itemcode level"), in)
    	call SaveInteger(hst, iz, StringHash("Fall Itemtype"), SoGetValForItemType(io))
    	call SaveInteger(hst, iz, StringHash("UCFI_SFK"), 2)
    	call SaveInteger(hst, iz, StringHash("Fall Itemcode number"), kn)
    	call SaveInteger(hst, iz, StringHash("Fall Itemcode Maybe"), ngz)
	endfunction
	//清除掉落物设置
 function SoRemoveUnitCodeFallItem takes integer uid returns nothing
  local integer iz= uid + SoMagicPatch___UFallI_HashValue
	    call RemoveSavedInteger(hst, iz, StringHash("UCFI_SFK"))
	    call RemoveSavedInteger(hst, iz, StringHash("Fall Itemcode Maybe"))
	    call RemoveSavedInteger(hst, iz, StringHash("Fall Itemcode number"))
	    call RemoveSavedInteger(hst, iz, StringHash("Fall Itemtype"))
	    call RemoveSavedInteger(hst, iz, StringHash("Fall Itemcode level"))
	    call RemoveSavedInteger(hst, iz, StringHash("Fall Itemcode"))
	endfunction
 function SoMagicPatch___StackedActions takes nothing returns nothing
  local integer i= 0
		if SoMagicPatch___SoStackStatus == 1 then
    		if ( ( ( GetItemType(GetManipulatedItem()) == ITEM_TYPE_CHARGED ) or ( GetItemType(GetManipulatedItem()) == ITEM_TYPE_PURCHASABLE ) ) ) then
        		set i=0
        		loop
            		exitwhen i > 5
            		if ( ( ( GetItemTypeId(GetManipulatedItem()) == GetItemTypeId(UnitItemInSlot(GetTriggerUnit(), i)) ) and ( GetManipulatedItem() != UnitItemInSlot(GetTriggerUnit(), i) ) ) ) then
                		call SetItemCharges(UnitItemInSlot(GetTriggerUnit(), i), ( GetItemCharges(UnitItemInSlot(GetTriggerUnit(), i)) + GetItemCharges(GetManipulatedItem()) ))
                		call RemoveItem(GetManipulatedItem())
                		set i=6
            		endif
            		set i=i + 1
        		endloop
        	endif
    	endif
	endfunction
	//打开物品叠加(仅可充类和可购买类)
 function SoSetItemStack takes nothing returns nothing
    	set SoMagicPatch___SoStackStatus=1
	endfunction
	//关闭物品叠加
 function SoRemoveItemStack takes nothing returns nothing
		set SoMagicPatch___SoStackStatus=0
	endfunction
	//*************************************************************************************************************
	//击杀奖励
 function UDRG_Actions_SouL takes nothing returns nothing
     local integer uid= GetUnitTypeId(GetTriggerUnit())
     local integer iz= uid + SoMagicPatch___UDRG_HashValue
     local integer k= LoadInteger(hst, iz, StringHash("SUR_K"))
     local boolean zt= LoadBoolean(hst, iz, StringHash("SUR_ZTX"))
     local integer gmin= 0
     local integer gmax= 0
     local integer grg= 0
     local texttag tt= null
    	if ( k == 1 ) then
        	set gmin=LoadInteger(hst, iz, StringHash("SUR_Gmin"))
        	set gmax=LoadInteger(hst, iz, StringHash("SUR_Gmax"))
        	if ( gmin == gmax ) then
            	call AdjustPlayerStateBJ(gmax, GetOwningPlayer(GetKillingUnit()), PLAYER_STATE_RESOURCE_GOLD)
        	elseif ( gmin < gmax ) then
            	set grg=GetRandomInt(gmin, gmax)
            	call AdjustPlayerStateBJ(grg, GetOwningPlayer(GetKillingUnit()), PLAYER_STATE_RESOURCE_GOLD)
        	elseif ( gmin > gmax ) then
            	set grg=GetRandomInt(gmax, gmin)
            	call AdjustPlayerStateBJ(grg, GetOwningPlayer(GetKillingUnit()), PLAYER_STATE_RESOURCE_GOLD)
        	endif
        	if ( zt == true ) then
            	set tt=CreateTextTagUnitBJ("+" + I2S(grg), GetTriggerUnit(), 0, 10, 100, 86.27, 0, 0)
            	call SetTextTagColor(tt, 255, 220, 0, 255)
            	call SetTextTagVelocityBJ(tt, 32, 90)
            	call SetTextTagPermanent(tt, false)
            	call SetTextTagLifespan(tt, 3)
            	call SetTextTagFadepoint(tt, 2)
            	set tt=null
        	endif
    	endif
	endfunction
 function SoSetUnitCodeReward takes integer uid,integer gmin,integer gmax,boolean ztx returns nothing
     local integer iz= uid + SoMagicPatch___UDRG_HashValue
    	call SaveInteger(hst, iz, StringHash("SUR_K"), 1)
    	if ( gmax >= gmin ) then
        	call SaveInteger(hst, iz, StringHash("SUR_Gmin"), gmin)
        	call SaveInteger(hst, iz, StringHash("SUR_Gmax"), gmax)
    	elseif ( gmax < gmin ) then
        	call SaveInteger(hst, iz, StringHash("SUR_Gmin"), gmax)
        	call SaveInteger(hst, iz, StringHash("SUR_Gmax"), gmin)
    	endif
    	call SaveBoolean(hst, iz, StringHash("SUR_ZTX"), ztx)
	endfunction
 function SoRemoveUnitCodeReward takes integer uid returns nothing
     local integer iz= uid + SoMagicPatch___UDRG_HashValue
	    if ( LoadInteger(hst, iz, StringHash("SUR_K")) == 1 ) then
	        call RemoveSavedInteger(hst, iz, StringHash("SUR_K"))
	        call RemoveSavedInteger(hst, iz, StringHash("SUR_ZTX"))
	        call RemoveSavedInteger(hst, iz, StringHash("SUR_Gmin"))
	        call RemoveSavedInteger(hst, iz, StringHash("SUR_Gmax"))
	    endif
	endfunction
	//漂浮文字相关
 function SoGetLastCreatedTexttag takes nothing returns texttag
	    return So_lastTextTag
	endfunction
 function SoTextTagPosUnit takes texttag tt,unit whichUnit,real zOffset returns nothing
    	call SetTextTagPosUnit(tt, whichUnit, zOffset)
	endfunction
 function SoTextTagColor takes texttag tt,real r,real g,real b,real t returns nothing
	    call SetTextTagColor(tt, PercentTo255(r), PercentTo255(g), PercentTo255(b), PercentTo255(100.0 - t))
	endfunction
 function SoTextTagText takes texttag tt,string s,real size returns nothing
	    call SetTextTagText(tt, s, TextTagSize2Height(size))
	endfunction
 function SoSetTextTagLife takes texttag tt,real Stime,real MaxStime returns nothing
	    call SetTextTagPermanent(tt, false)
	    call SetTextTagFadepoint(tt, Stime)
    	call SetTextTagLifespan(tt, MaxStime)
	endfunction
 function SoNewTextTagUnit takes string s,unit whichUnit,real zOffset,real size,real red,real green,real blue,real transparency returns texttag
	    set So_lastTextTag=CreateTextTag()
	    call SetTextTagText((So_lastTextTag ), ( s ), TextTagSize2Height((( size)*1.0))) // INLINED!!
	    call SetTextTagPosUnit((So_lastTextTag ), ( whichUnit ), (( zOffset)*1.0)) // INLINED!!
	    call SoTextTagColor(So_lastTextTag , red , green , blue , transparency)
	    return So_lastTextTag
	endfunction
 function SoTextTagForUnit takes string s,unit whichUnit,real zOffset,real size,real red,real green,real blue,real spd,real ang,real Stime,real MaxStime returns texttag
	    set So_lastTextTag=SoNewTextTagUnit(s , whichUnit , zOffset , size , red , green , blue , 0)
	    call SetTextTagPermanent(So_lastTextTag, false)
	    call SetTextTagVelocityBJ(So_lastTextTag, spd, ang)
	    call SetTextTagFadepoint(So_lastTextTag, Stime)
    	call SetTextTagLifespan(So_lastTextTag, MaxStime)
	    return So_lastTextTag
	endfunction
 function SoNewTextTag takes string s,real HowX,real HowY,real zOffset,real size,real red,real green,real blue,real transparency returns texttag
	    set So_lastTextTag=CreateTextTag()
	    call SetTextTagText((So_lastTextTag ), ( s ), TextTagSize2Height((( size)*1.0))) // INLINED!!
	    call SetTextTagPos(So_lastTextTag, HowX, HowY, zOffset)
	    call SoTextTagColor(So_lastTextTag , red , green , blue , transparency)
	    return So_lastTextTag
	endfunction
 function SoMagicPatch___SoTurn_TimerLow takes nothing returns nothing
     local timer t= GetExpiredTimer()
     local integer hi= GetHandleId(t)
     local real tvl= LoadReal(hst, hi, 0)
     local real size= LoadReal(hst, hi, 1) - tvl
     local real trm= LoadReal(hst, hi, 2)
     local texttag tt= LoadTextTagHandle(hst, hi, 3)
     local string s= LoadStr(hst, hi, 4)
     local real sp= LoadReal(hst, hi, 5)
     local real ang= LoadReal(hst, hi, 6)
     local real time= LoadReal(hst, hi, 9)
	    if size < trm then
	    	call SetTextTagVelocityBJ(tt, sp, ang)
	    	call FlushChildHashtable(hst, hi)
	    	call SetTextTagPermanent(tt, false)
	    	call SetTextTagFadepoint(tt, time - 1)
    		call SetTextTagLifespan(tt, time)
	    	call DestroyTimer(t)
	    else
	    	call SetTextTagText((tt ), ( s ), TextTagSize2Height((( size)*1.0))) // INLINED!!
	    	call SaveReal(hst, hi, 1, size)
	    endif
	    	set tt=null
	    	set t=null
	endfunction
 function SoMagicPatch___SoTurn_TimerBig takes nothing returns nothing
     local timer t= GetExpiredTimer()
     local integer hi= GetHandleId(t)
     local real tvl= LoadReal(hst, hi, 0)
     local real size= LoadReal(hst, hi, 1) + tvl
     local real trm= LoadReal(hst, hi, 2)
     local texttag tt= LoadTextTagHandle(hst, hi, 3)
     local string s= LoadStr(hst, hi, 4)
     local real sp= LoadReal(hst, hi, 5)
     local real ang= LoadReal(hst, hi, 6)
     local real time= LoadReal(hst, hi, 9)
	    if size > trm then
	    	call SetTextTagVelocityBJ(tt, sp, ang)
	    	call FlushChildHashtable(hst, hi)
	    	call SetTextTagPermanent(tt, false)
	    	call SetTextTagFadepoint(tt, time - 1)
    		call SetTextTagLifespan(tt, time)
	    	call DestroyTimer(t)
	    else
	    	call SetTextTagText((tt ), ( s ), TextTagSize2Height((( size)*1.0))) // INLINED!!
	    	call SaveReal(hst, hi, 1, size)
	    endif
	    	set tt=null
	    	set t=null
	endfunction
 function SoMagicPatch___SoTurn_TimerBTL takes nothing returns nothing
     local timer t= GetExpiredTimer()
     local integer hi= GetHandleId(t)
     local real tvl= LoadReal(hst, hi, 0)
     local real size= LoadReal(hst, hi, 1)
     local real trm= LoadReal(hst, hi, 2)
     local texttag tt= LoadTextTagHandle(hst, hi, 3)
     local string s= LoadStr(hst, hi, 4)
     local real sp= LoadReal(hst, hi, 5)
     local real ang= LoadReal(hst, hi, 6)
     local integer du= LoadInteger(hst, hi, 7)
     local real msize= LoadReal(hst, hi, 8)
     local real time= LoadReal(hst, hi, 9)
	    if du == 1 then
	        if ( size + tvl ) < trm then
	        	set size=size + tvl
	        elseif ( size + tvl ) >= trm then
	    		call SaveInteger(hst, hi, 7, - 1)
	    		set size=trm
	    	endif
	    elseif du == - 1 then
	    	if ( size - tvl ) > msize then
	        	set size=size - tvl
	        elseif ( size - tvl ) < msize then
	    		call SaveInteger(hst, hi, 7, 0)
	    		set size=msize
	    	endif
	    endif
	    if du == 0 then
	    	call SetTextTagVelocityBJ(tt, sp, ang)
	    	call FlushChildHashtable(hst, hi)
	    	call SetTextTagPermanent(tt, false)
	    	call SetTextTagFadepoint(tt, time - 1)
    		call SetTextTagLifespan(tt, time)
	    	call DestroyTimer(t)
	    else
	    	call SetTextTagText((tt ), ( s ), TextTagSize2Height((( size)*1.0))) // INLINED!!
	    	call SaveReal(hst, hi, 1, size)
	    endif
	    	set tt=null
	    	set t=null
	endfunction
 function SoTurnTextTagToUnit takes string s,unit whichUnit,real zOs,real size,real red,real green,real blue,real tmm,real tvl,real modu,real ppl,real trm,real sp,real ang,real time returns texttag
     local timer t
	    set So_lastTextTag=CreateTextTag()
	    call SetTextTagText((So_lastTextTag ), ( s ), TextTagSize2Height((( size)*1.0))) // INLINED!!
	    call SetTextTagPosUnit((So_lastTextTag ), ( whichUnit ), (( zOs)*1.0)) // INLINED!!
	    call SoTextTagColor(So_lastTextTag , red , green , blue , tmm)
	    if modu != So_TURN_NO then
	    	set t=CreateTimer()
	    	call SaveReal(hst, GetHandleId(t), 0, tvl)
	    	call SaveReal(hst, GetHandleId(t), 1, size)
	    	call SaveReal(hst, GetHandleId(t), 2, trm)
	    	call SaveTextTagHandle(hst, GetHandleId(t), 3, So_lastTextTag)
	    	call SaveStr(hst, GetHandleId(t), 4, s)
	    	call SaveReal(hst, GetHandleId(t), 5, sp)
	    	call SaveReal(hst, GetHandleId(t), 6, ang)
	    	call SaveReal(hst, GetHandleId(t), 9, time)
	    	if modu == So_TURN_Low then
	    		call TimerStart(t, ppl, true, function SoMagicPatch___SoTurn_TimerLow)
	    	elseif modu == So_TURN_Big then
	    	    call TimerStart(t, ppl, true, function SoMagicPatch___SoTurn_TimerBig)
	    	elseif modu == So_TURN_BigToLow then
	    		call SaveInteger(hst, GetHandleId(t), 7, 1)
	    		call SaveReal(hst, GetHandleId(t), 8, size)
	    	    call TimerStart(t, ppl, true, function SoMagicPatch___SoTurn_TimerBTL)
	    	endif
	    endif
	    return So_lastTextTag
	endfunction
 function PickUpTimerActions_ChooseItems takes nothing returns nothing
     local integer wid= GetItemTypeId(GetEnumItem())
     local integer wtid= LoadInteger(hst, wid, StringHash("pick up SoUI type false"))
     local item it= null
	    if ( wtid != 0 and ( IsItemOwned(GetEnumItem()) == false ) ) then
	        set it=CreateItem(wtid, GetItemX(GetEnumItem()), GetItemY(GetEnumItem()))
	        if ( GetItemCharges(GetEnumItem()) > 0 ) then
	            call SetItemCharges(it, GetItemCharges(GetEnumItem()))
	        endif
	        call RemoveItem(GetEnumItem())
	        set it=null
	    endif
	endfunction
 function PickUpTimerActions takes nothing returns nothing
	    call EnumItemsInRectBJ(GetPlayableMapRect(), function PickUpTimerActions_ChooseItems)
	endfunction
 function SoAddFullPickUpForBag takes integer tType,integer fType returns integer
		if ( So_PickUpTimerData == null ) then
		    set So_PickUpTimerData=CreateTimer()
		    call TimerStart(So_PickUpTimerData, 0.02, true, function PickUpTimerActions)
		endif
	    if ( LoadInteger(hst, fType, StringHash("pick up SoUI type true")) != 0 or LoadInteger(hst, tType, StringHash("pick up SoUI type false")) != 0 ) then
	        return - 1
	    else
	    	call SaveInteger(hst, tType, StringHash("pick up SoUI type false"), fType)
	    	call SaveInteger(hst, fType, StringHash("pick up SoUI type true"), tType)
	    	return 0
	    endif
	endfunction
 function SoRemoveFullPickUp takes integer te returns integer
  local integer id=0
	    if ( LoadInteger(hst, te, StringHash("pick up SoUI type true")) != 0 ) then
	    	set id=LoadInteger(hst, te, StringHash("pick up SoUI type true"))
	    	call RemoveSavedInteger(hst, te, StringHash("pick up SoUI type true"))
	    	call RemoveSavedInteger(hst, id, StringHash("pick up SoUI type flase"))
	    endif
	    if ( LoadInteger(hst, te, StringHash("pick up SoUI type false")) != 0 ) then
	        set id=LoadInteger(hst, te, StringHash("pick up SoUI type false"))
	        call RemoveSavedInteger(hst, te, StringHash("pick up SoUI type false"))
	    	call RemoveSavedInteger(hst, id, StringHash("pick up SoUI type true"))
	    endif
	    if id == 0 then
	    	return - 1
	    else
	    	return 0
	    endif
	endfunction
 function SoMagicPatch___SoGetInventoryIndexOfItemType takes unit whichUnit,integer itemId returns integer
     local integer index
     local item indexItem
	    set index=0
	    loop
	        set indexItem=UnitItemInSlot(whichUnit, index)
	        if ( indexItem != null ) and ( GetItemTypeId(indexItem) == itemId ) then
		            return index + 1
	        endif
	        set index=index + 1
	        exitwhen index >= bj_MAX_INVENTORY
	    endloop
	    return 0
	endfunction
 function SoMagicPatch___SoUnitHasItemOfType takes unit whichUnit,integer itemId returns boolean
    	return SoMagicPatch___SoGetInventoryIndexOfItemType(whichUnit , itemId) > 0
	endfunction
 function SoObtrinItemsActions takes nothing returns nothing
     local item wp= GetManipulatedItem()
     local integer wid= GetItemTypeId(wp)
     local integer wtid= LoadInteger(hst, wid, StringHash("pick up SoUI type true"))
     local integer i= 0
     local unit c= GetTriggerUnit()
     local integer has= 0
	    if wtid != 0 then
	    	if (SoMagicPatch___SoGetInventoryIndexOfItemType((c ) , ( wtid)) > 0) == true then // INLINED!!
	    		loop
	    	    	exitwhen i > 5
	    	    	if GetItemTypeId(UnitItemInSlot(c, i)) == wtid and GetItemCharges(UnitItemInSlot(c, i)) + GetItemCharges(wp) != 0 then
	    	    	    call SetItemCharges(UnitItemInSlot(c, i), GetItemCharges(UnitItemInSlot(c, i)) + GetItemCharges(wp))
	    	    	    call RemoveItem(wp)
	    	    	endif
	    	    	set i=i + 1
	    		endloop
	    	else
	    		set i=0
	    		loop
	    	    	exitwhen i > 5
	    	    	if UnitItemInSlot(c, i) == null then
	    	    		set has=1
	    	    		set i=10
	    	    	endif
	    	    	set i=i + 1
	    		endloop
		    	if has == 0 then
		    		call CreateItem(wid, GetItemX(wp), GetItemY(wp))
		    	elseif has == 1 then
		    	    call UnitAddItemByIdSwapped(wtid, c)
		    	    if GetItemCharges(wp) > 0 then
		    	    	call SetItemCharges(UnitItemInSlot(c, wtid), GetItemCharges(wp))
		    	    endif
		    	    call RemoveItem(wp)
		    	endif
		    endif
		endif
	    set c=null
	    set wp=null
	endfunction
	//[公式]技能等级系数: (实数) + (单位)的(技能)等级 × (实数)
 function SoAbiltyFormula takes real a,unit b,integer c,real d returns real
	    return a + ( GetUnitAbilityLevel(b, c) * d )
	endfunction
	//[公式]属性相关系数: (实数) + (单位)的(力量)×(实数) + (单位)的(敏捷)×(实数) + (单位)的(智力)×(实数), (包括/不包括)加成
 function SoHeroStateFormula takes real a,unit b1,real c1,unit b2,real c2,unit b3,real c3,boolean e returns real
	    return a + ( GetHeroStr(b1, e) * c1 ) + ( GetHeroAgi(b2, e) * c2 ) + ( GetHeroInt(b3, e) * c3 )
	endfunction
	//[公式]单位全属性相关: (实数) + (单位)的(属性)×(实数)
 function SoHeroAllStateFormula takes real a,unit b1,real c1,boolean e returns real
	    return a + ( GetHeroStr(b1, e) * c1 ) + ( GetHeroAgi(b1, e) * c1 ) + ( GetHeroInt(b1, e) * c1 )
	endfunction
	//[公式]单位属性相关: (实数) + (单位)的(属性)×(实数) + (单位)的(属性)×(实数) + (单位)的(属性)×(实数)
 function SoUnitStateFormula takes real a,unit b1,unitstate c1,real d1,unit b2,unitstate c2,real d2 returns real
	    return a + ( GetUnitState(b1, c1) * d1 ) + ( GetUnitState(b2, c2) * d2 )
	endfunction
	//[公式]英雄等级+技能等级: (实数) + (单位)的(技能)等级 × (实数) + (单位)的等级 × (实数)
 function SoAbilityLevelFormula takes real a,unit b,integer c,real d,unit e,real f returns real
	    return a + ( GetUnitAbilityLevel(b, c) * d ) + ( GetUnitLevel(e) * f )
	endfunction
	//[简化]玩家属性(实数)
 function SoGetPlayerRealState takes player p,playerstate pts returns real
	    return I2R(GetPlayerState(p, pts))
	endfunction
	//[简化]单位组中单位的数量(Real)
 function SoGroupRealCount takes group g returns real
     local boolean wantDestroy= bj_wantDestroyGroup
	    set bj_wantDestroyGroup=false
	    set bj_groupCountUnits=0
	    call ForGroup(g, function CountUnitsInGroupEnum)
	    if ( wantDestroy ) then
	        call DestroyGroup(g)
	    endif
	    return I2R(bj_groupCountUnits)
	endfunction
 function SoGetUnitRealLevel takes unit whichUnit returns real
	    return I2R(GetUnitLevel(whichUnit))
	endfunction
	//[简化]增加物品使用次数
 function SoAddItemCharges takes item itm,integer cut returns boolean
	    if ( GetItemCharges(itm) - cut > 0 ) then
	        call SetItemCharges(itm, GetItemCharges(itm) + cut)
	        return true
	    else
	    	call RemoveItem(itm)
	    	return false
	    endif
	endfunction
	//[简化]单位等级(String)
 function SoGetUnitStringLevel takes unit hu returns string
	    return I2S(GetUnitLevel(hu))
	endfunction
	//[简化]增加单位的生命值
 function SoAddUnitLife takes unit hu,real hm returns boolean
	    if ( GetUnitState(hu, UNIT_STATE_LIFE) + hm <= GetUnitState(hu, UNIT_STATE_MAX_LIFE) ) then
	    	call SetUnitState(hu, UNIT_STATE_LIFE, GetUnitState(hu, UNIT_STATE_LIFE) + hm)
	        return false
	    else
	    	call SetUnitState(hu, UNIT_STATE_LIFE, GetUnitState(hu, UNIT_STATE_MAX_LIFE))
	    	return true
	    endif
	endfunction
 function SoAddUnitMana takes unit hu,real hm returns boolean
	    if ( GetUnitState(hu, UNIT_STATE_MANA) + hm <= GetUnitState(hu, UNIT_STATE_MAX_MANA) ) then
	    	call SetUnitState(hu, UNIT_STATE_MANA, GetUnitState(hu, UNIT_STATE_MANA) + hm)
	        return false
	    else
	    	call SetUnitState(hu, UNIT_STATE_MANA, GetUnitState(hu, UNIT_STATE_MAX_MANA))
	    	return true
	    endif
	endfunction
 function SoAddUnitState takes unit whichUnit,real AddVal,unitstate whichUnitState returns nothing
	    call SetUnitState(whichUnit, whichUnitState, GetUnitState(whichUnit, whichUnitState) + AddVal)
	endfunction
	//叠加(上限)
 function SoAddItemStack takes integer wid,integer max returns boolean
		if ( LoadInteger(hst, StringHash("SoUI Type Stacked"), GetItemTypeId(GetManipulatedItem())) == 1 ) then
			call SaveInteger(hst, StringHash("SoUI Type Stacked Max Count"), wid, max)
		    return false
		else
			call SaveInteger(hst, StringHash("SoUI Type Stacked"), wid, 1)
	    	call SaveInteger(hst, StringHash("SoUI Type Stacked Max Count"), wid, max)
	    	return true
		endif
	endfunction
 function SoRemoveStack takes integer wid returns boolean
	    if ( LoadInteger(hst, StringHash("SoUI Type Stacked"), GetItemTypeId(GetManipulatedItem())) == 1 ) then
	    	call SaveInteger(hst, StringHash("SoUI Type Stacked"), wid, 0)
	    	return true
	    else
	    	return false
	    endif
	endfunction
	
 function SoMagicPatch___SoGetItemOfTypeFromUnit takes unit whichUnit,integer itemId returns item
     local integer index= SoMagicPatch___SoGetInventoryIndexOfItemType(whichUnit , itemId)
    	if ( index == 0 ) then
    	    return null
    	else
    	    return UnitItemInSlot(whichUnit, index - 1)
    	endif
	endfunction
 function SoMagicPatch___StackedForTypeActions takes nothing returns nothing
  local integer i= 0
		if LoadInteger(hst, StringHash("SoUI Type Stacked"), GetItemTypeId(GetManipulatedItem())) == 1 then
    		if ( LoadInteger(hst, StringHash("SoUI Type Stacked Max Count"), GetItemTypeId(GetManipulatedItem())) > 0 ) then
    		if GetItemCharges(GetManipulatedItem()) != 0 and GetItemCharges(SoMagicPatch___SoGetItemOfTypeFromUnit(GetTriggerUnit() , GetItemTypeId(GetManipulatedItem()))) != 0 then
        		set i=0
        		loop
            		exitwhen i > 5
            		if ( ( ( GetItemTypeId(GetManipulatedItem()) == GetItemTypeId(UnitItemInSlot(GetTriggerUnit(), i)) ) and ( GetManipulatedItem() != UnitItemInSlot(GetTriggerUnit(), i) ) ) ) then
                		call SetItemCharges(UnitItemInSlot(GetTriggerUnit(), i), ( GetItemCharges(UnitItemInSlot(GetTriggerUnit(), i)) + GetItemCharges(GetManipulatedItem()) ))
                		call RemoveItem(GetManipulatedItem())
                		set i=6
            		endif
            		set i=i + 1
        		endloop
        	endif
        	endif
    	endif
	endfunction
	//*************************************************************************************************************
 function SoMagicPatch___BuildSten takes nothing returns nothing
     local group Creeps
     local integer s= StringHash("Creeps")
    	//Init_CreepsXY
    	set Creeps=EnumUnits(99999999 , 0 , 0 , null)
    	call ForGroup(Creeps, function Creeps_initXY)
    	call SaveGroupHandle(hst, GetHandleId(Player(12)), s, Creeps)
    	call TriggerAddAction(SOTRI_UNIT_DIE, function RenewCreepsActions)
    	call TriggerAddAction(SOTRI_UNIT_DIE, function SoMagicPatch___UCFI_Actions_SouL)
    	call TriggerAddAction(SOTRI_UNIT_DIE, function UDRG_Actions_SouL)
    	call TriggerAddAction(SOTRI_UNIT_GETITEM, function SoMagicPatch___StackedActions)
    	call TriggerAddAction(SOTRI_UNIT_GETITEM, function SoMagicPatch___StackedForTypeActions)
    	call TriggerAddAction(SOTRI_UNIT_GETITEM, function SoObtrinItemsActions)
    	set Creeps=null
	endfunction

//library SoMagicPatch ends
//library SoUnitAbtL:
	
	//新建马甲
	//创建一个(单位类型)给(玩家)在(x,y),设置生命周期为(实数),为马甲添加(技能),这个技能的等级为(整数),并隐藏该马甲 
 function SoCreateMaJia takes integer unitid,player wj,real x,real y,real life,integer spellid,integer dgj returns unit
    	set So_LastMaJia=CreateUnit(wj, unitid, x, y, GetRandomDirectionDeg())
    	if spellid != 0 and dgj > 0 then
    		call UnitAddAbility(So_LastMaJia, spellid)
    		call UnitMakeAbilityPermanent(So_LastMaJia, true, spellid)
    		call SetUnitAbilityLevel(So_LastMaJia, spellid, dgj)
    	endif
    	if life != 0 then
    		call UnitApplyTimedLife(So_LastMaJia, 'BTIF', life)
    	endif
    	call ShowUnit(So_LastMaJia, false)
    	return So_LastMaJia
	endfunction
    //新建马甲
    //创建一个(单位类型)给(玩家)在(x,y),设置生命周期为(实数),为马甲添加(技能),这个技能的等级为(整数)
    //这条动作创建的马甲不会被隐藏
    function SoCreateMaJiaShow takes integer unitid,player wj,real x,real y,real life,integer spellid,integer dgj returns unit
        set So_LastMaJia=CreateUnit(wj, unitid, x, y, GetRandomDirectionDeg())
        if spellid != 0 and dgj > 0 then
            call UnitAddAbility(So_LastMaJia, spellid)
            call UnitMakeAbilityPermanent(So_LastMaJia, true, spellid)
            call SetUnitAbilityLevel(So_LastMaJia, spellid, dgj)
        endif
        if life != 0 then
            call UnitApplyTimedLife(So_LastMaJia, 'BTIF', life)
        endif
        return So_LastMaJia
    endfunction
    //新建马甲
    //创建一个(单位类型)给(玩家)在(点),设置生命周期为(实数),为马甲添加(技能),这个技能的等级为(整数),并隐藏该马甲
    function SoCreateMaJiaAtLoc takes integer unitid,player wj,location poi,real life,integer spellid,integer dgj returns unit
        set So_LastMaJia=CreateUnit(wj, unitid, GetLocationX(poi), GetLocationY(poi), GetRandomDirectionDeg())
        if spellid != 0 and dgj > 0 then
            call UnitAddAbility(So_LastMaJia, spellid)
            call UnitMakeAbilityPermanent(So_LastMaJia, true, spellid)
            call SetUnitAbilityLevel(So_LastMaJia, spellid, dgj)
        endif
        if life != 0 then
            call UnitApplyTimedLife(So_LastMaJia, 'BTIF', life)
        endif
        call ShowUnit(So_LastMaJia, false)
        return So_LastMaJia
    endfunction
    //新建马甲
    //创建一个(单位类型)给(玩家)在(点),设置生命周期为(实数),为马甲添加(技能),这个技能的等级为(整数)
    //这条动作创建的马甲不会被隐藏
    function SoCreateMaJiaAtLocShow takes integer unitid,player wj,location poi,real life,integer spellid,integer dgj returns unit
        set So_LastMaJia=CreateUnit(wj, unitid, GetLocationX(poi), GetLocationY(poi), GetRandomDirectionDeg())
        if spellid != 0 and dgj > 0 then
            call UnitAddAbility(So_LastMaJia, spellid)
            call UnitMakeAbilityPermanent(So_LastMaJia, true, spellid)
            call SetUnitAbilityLevel(So_LastMaJia, spellid, dgj)
        endif
        if life != 0 then
            call UnitApplyTimedLife(So_LastMaJia, 'BTIF', life)
        endif
        return So_LastMaJia
    endfunction
	//马甲改造
	//设置(单位): 生命周期为(实数); 添加(技能),这个技能的等级为(整数), 状态为(隐藏/显示)
 function SoSetMaJia takes unit WhichUnit,real lf,integer sid,integer dgj,boolean sh returns nothing
	    if sid != 0 and dgj > 0 then
    		call UnitAddAbility(WhichUnit, sid)
    		call UnitMakeAbilityPermanent(WhichUnit, true, sid)
    		call SetUnitAbilityLevel(WhichUnit, sid, dgj)
    	endif
    	if lf != 0 then
    		call UnitApplyTimedLife(WhichUnit, 'BTIF', lf)
    	endif
    	call ShowUnit(WhichUnit, sh)
	endfunction
	//添加技能并设置等级
	//为(单位)添加 (技能), 这个技能的等级为(整数)
	//技能永久性会被打开
    function SoUnitAddAbilityMake takes unit WhichUnit,integer aid,integer dn returns nothing
        if aid != 0 then
            call UnitAddAbility(WhichUnit, aid)
            call UnitMakeAbilityPermanent(WhichUnit, true, aid)
            call SetUnitAbilityLevel(WhichUnit, aid, dn)
        endif
    endfunction
    //单位拥有技能
    //(单位) 拥有 (技能)
    //拥有技能则返回true.可用'单位技能等级 大于 0'来实现相同的效果
    function SoUnitHasAbility takes unit WhichUnit,integer sid returns boolean
        if ( GetUnitAbilityLevel(WhichUnit, sid) > 0 ) then
            return true
        else
        	return false
        endif
    endfunction
    //包含坐标
    //(区域) 内含有 (X, Y)
    function SoRectHasCoord takes rect r,real x,real y returns boolean
        return ( GetRectMinX(r) <= x ) and ( x <= GetRectMaxX(r) ) and ( GetRectMinY(r) <= y ) and ( y <= GetRectMaxY(r) )
    endfunction
    //使用次数
    //(物品)的使用次数
    function SoItemUseCountReal takes item isc returns real
        return I2R(GetItemCharges(isc))
    endfunction
    //玩家id
    //(玩家)的ID
    function SoGetPlayerIdReal takes player p returns real
        return I2R(GetPlayerId(p))
    endfunction
    //自增
    //(整数)+=1
    function SoAddIntSelf takes integer i returns integer
        return ( i + 1 )
    endfunction
    //自增
    //(实数)+=1
    function SoAddRealSelf takes real r returns real
        return ( r + 1. )
    endfunction
    //自减
    //(整数)-=1
    function SoLessIntSelf takes integer i returns integer
        return ( i - 1 )
    endfunction
    //自减
    //(实数)-=1
    function SoLessRealSelf takes real r returns real
        return ( r - 1. )
    endfunction
    //持有物品数量
    //(单位)物品栏中拥有的物品数量,关联的物品栏技能为 (技能)
    //需要指定物品栏技能
    function SoUnitHatm takes unit c,integer s returns integer
        local integer i= 0
        local integer n= 0
        if ( GetUnitAbilityLevel(c, s) > 0 ) then
            loop
                exitwhen i > 5
                if ( UnitItemInSlot(c, i) != null ) then
                    set n=n + 1
                endif
                set i=i + 1
            endloop
        endif
        return n
    endfunction
    //英雄持有物品数量
    //(单位)物品栏中拥有的物品数量
    //目标单位需要拥有'物品栏(英雄' 技能
    function SoHeroHatm takes unit c returns integer
        local integer i= 0
        local integer n= 0
        if ( GetUnitAbilityLevel(c, 'AInv') > 0 ) then
            loop
                exitwhen i > 5
                if ( UnitItemInSlot(c, i) != null ) then
                set n=n + 1
                endif
                set i=i + 1
            endloop
        endif
        return n
    endfunction
    //修改英雄属性
    //输入负数来减少,不需要添加的属性可以输入0
    function SoHeroStateAmend takes unit hero,integer Power,integer Agile,integer Intelligence returns nothing
        if Power != 0 then
            call ModifyHeroStat(bj_HEROSTAT_STR, hero, bj_MODIFYMETHOD_ADD, Power)
        endif
        if Agile != 0 then
            call ModifyHeroStat(bj_HEROSTAT_AGI, hero, bj_MODIFYMETHOD_ADD, Agile)
        endif
        if Intelligence != 0 then
            call ModifyHeroStat(bj_HEROSTAT_INT, hero, bj_MODIFYMETHOD_ADD, Intelligence)
        endif
    endfunction
    //给予物品
    //创建(物品类型)给 (单位) ,这个物品的使用次数为(整数)
    //永久物品请设置使用次数为0,使用'最后创建的物品'来获得被创建的物品,英雄物品栏已满或者没有物品栏技能的情况下会创建到英雄脚下.
    function SoGiveItems takes integer iid,unit hero,integer number returns item
        set So_LastGiveHeroItem=CreateItem(iid, GetUnitX(hero), GetUnitY(hero))
        if GetUnitAbilityLevel(hero, 'AInv') > 0 then
            call UnitAddItem(hero, So_LastGiveHeroItem)
        endif
        if number > 0 then
            call SetItemCharges(So_LastGiveHeroItem, number)
        endif
        return So_LastGiveHeroItem
    endfunction
 function SoInvincible_Timer takes nothing returns nothing
        local timer t= GetExpiredTimer()
        local unit u= LoadUnitHandle(Hx, GetHandleId(t), 1)
        call SetUnitInvulnerable(u, false)
        call FlushChildHashtable(Hx, GetHandleId(t))
        call DestroyTimer(t)
        set t=null
        set u=null
    endfunction
    
    //无敌单位
    //为(单位)设置 (实数) 秒的无敌时间
    //0.00秒并不是永久无敌
    function SoInvincible takes unit u,real time returns nothing
        local timer t= CreateTimer()
        call SetUnitInvulnerable(u, true)
        call SaveUnitHandle(Hx, GetHandleId(t), 1, u)
        call TimerStart(t, time, false, function SoInvincible_Timer)
        set t=null
    endfunction
    //暂时添加技能
    //为(单位) 添加 (技能) 持续 (实数) 秒
    function SoUnitAddSpell_timer takes nothing returns nothing
        local timer t= GetExpiredTimer()
        local unit u= LoadUnitHandle(Hx, GetHandleId(t), 1)
        local integer id= LoadInteger(Hx, GetHandleId(t), 2)
        call FlushChildHashtable(Hx, GetHandleId(t))
        call DestroyTimer(t)
        set t=null
        call UnitRemoveAbility(u, id)
        set u=null
    endfunction
    //重置单个技能的冷却时间
    //为(单位)的(技能)重置冷却时间
    function SoUnitClearAbilityCD takes unit WhichUnit,integer spellid returns boolean
     local integer lv= 0
     local integer id= spellid
   		if GetUnitAbilityLevel(WhichUnit, spellid) == 0 then
			return false
		else
			set lv=GetUnitAbilityLevel(WhichUnit, id)
			call UnitRemoveAbility(WhichUnit, id)
			call UnitAddAbility(WhichUnit, id)
			call SetUnitAbilityLevel(WhichUnit, id, lv)
			call UnitMakeAbilityPermanent(WhichUnit, true, id)
			return true
		endif
    endfunction
    function SoUnitAddSpell takes unit u,integer spellid,real time returns nothing
        local timer t
        if GetUnitAbilityLevel(u, spellid) > 0 then
        else
            call UnitAddAbility(u, spellid)
            call UnitMakeAbilityPermanent(u, true, spellid)
        endif
        if time != 0 then
            set t=CreateTimer()
            call SaveUnitHandle(Hx, GetHandleId(t), 1, u)
            call SaveInteger(Hx, GetHandleId(t), 2, spellid)
            call TimerStart(t, time, false, function SoUnitAddSpell_timer)
            set t=null
        endif
    endfunction
    function SoSlowDown_Timer takes nothing returns nothing
        local timer EXDT= GetExpiredTimer()
        local integer p1= GetHandleId(EXDT)
        local unit u= LoadUnitHandle(Hx, p1, 1)
        local integer p2= GetHandleId(u)
        local real sd= LoadReal(Hx, p2, 1)
        local real b= LoadReal(Hx, p2, 2)
        call SetUnitMoveSpeed(u, sd / b)
        call SaveReal(Hx, p2, 1, sd / b)
        call DestroyEffect(LoadEffectHandle(Hx, p1, 2))
        set u=null
        call FlushChildHashtable(Hx, p1)
        call DestroyTimer(EXDT)
        set EXDT=null
    endfunction
    function SoSlowDown takes unit WhichUnit,real t,real b returns nothing
        local timer SDT=CreateTimer()
        local integer p1=GetHandleId(SDT)
        local integer p2=GetHandleId(WhichUnit)
        local real sd= 0
        local effect ee= null
        set b=1 - b
        if ( LoadReal(Hx, p2, 1) != 0 ) then
            set sd=LoadReal(Hx, p2, 1) * b
        else
            set sd=GetUnitMoveSpeed(WhichUnit) * b
        endif
        call SaveUnitHandle(Hx, p1, 1, WhichUnit)
        call SaveReal(Hx, p2, 1, sd)
        call SaveReal(Hx, p2, 2, b)
        call SetUnitMoveSpeed(WhichUnit, sd)
        set ee=AddSpecialEffectTargetUnitBJ("Abilities\\Spells\\Human\\slow\\slowtarget.mdl", WhichUnit, "origin")
        call SaveEffectHandle(Hx, p1, 2, ee)
        call TimerStart(SDT, t, false, function SoSlowDown_Timer)
        set SDT=null
        set ee=null
    endfunction
    //获取(英雄)第一个空的物品栏位置
    //物品栏位置取值0到5.当英雄物品栏已满时返回-1,当目标没有'物品栏(英雄)'时返回-2.
    function SoGetFreeBagForNum takes unit hero returns integer
        local integer i= 0
        if ( GetUnitAbilityLevel(hero, 'AInv') == 0 ) then
            return - 2
        endif
        loop
            exitwhen i > 5
            if ( UnitItemInSlot(hero, i) == null ) then
                return i
            endif
            set i=i + 1
        endloop
        return - 1
    endfunction
    //获取(英雄)第一个空的物品栏位置,其物品栏技能为(技能)
    //物品栏位置取值0到5.当英雄物品栏已满时返回-1,当目标没有'物品栏(英雄)'时返回-2.
    function SoGetFreeBagAbilityForNum takes unit hero,integer sid returns integer
        local integer i= 0
        if ( GetUnitAbilityLevel(hero, sid) == 0 ) then
            return - 2
        endif
        loop
            exitwhen i > 5
            if ( UnitItemInSlot(hero, i) == null ) then
                return i
            endif
            set i=i + 1
        endloop
        return - 1
    endfunction
    //技能释放位置的X坐标
    //技能释放位置的X轴坐标,关键: (技能释放目标)
    //如果是单位目标技能则返回技能释放目标的坐标,如果是点目标技能则返回技能目标点的坐标.在通魔技能中选择'点目标'的技能无效.
    function SoSpellTargetX takes unit target returns real
        if ( target == null ) then
            return GetSpellTargetX()
        else
        	return GetUnitX(target)
        endif
    endfunction
    //技能释放位置的Y坐标
    //技能释放位置的Y轴坐标,关键: (技能释放目标)
    //如果是单位目标技能则返回技能释放目标的坐标,如果是点目标技能则返回技能目标点的坐标.在通魔技能中选择'点目标'的技能无效.
    function SoSpellTargetY takes unit target returns real
        if ( target == null ) then
            return GetSpellTargetY()
        else
        	return GetUnitY(target)
        endif
    endfunction
    //技能释放位置
    //技能释放位置,关键: (技能释放目标)
    //点目标技能返回技能释放点,单位目标技能返回'技能释放目标'的位置.在通魔技能中选择'点目标'的技能无效.
    function SoSpellTargetLoc takes unit target returns location
        if ( target == null ) then
            return GetSpellTargetLoc()
        else
            return GetUnitLoc(target)
        endif
    endfunction
    
    function SoUnitHurtRect takes unit from,real ppr,real ppx,real ppy,integer pft,real da,boolean b,boolean b2,attacktype attackType,damagetype damageType,weapontype weaponType,boolean b3 returns boolean
        local group g= CreateGroup()
        local unit eu= null
        local real pmx= GetRectMinX(GetWorldBounds())
        local real pmxx= GetRectMaxX(GetWorldBounds())
        local real pmy= GetRectMinY(GetWorldBounds())
        local real pmyy= GetRectMaxY(GetWorldBounds())
        if ( ppr <= 0 or da <= 0 or ppx < pmx or ppx > pmxx or ppy < pmy or ppy > pmyy ) then
            return false
        else
            call GroupEnumUnitsInRange(g, ppx, ppy, ppr, null)
            loop
                set eu=FirstOfGroup(g)
                call GroupRemoveUnit(g, eu)
                if ( pft == 1 ) then
                    if ( IsUnitEnemy(eu, GetOwningPlayer(from)) == true and IsUnitType(eu, UNIT_TYPE_STRUCTURE) == b3 ) then
                        call UnitDamageTarget(from, eu, da, b, b2, attackType, damageType, weaponType)
                    endif
                elseif ( pft == 0 ) then
                    if ( IsUnitAlly(eu, GetOwningPlayer(from)) == true and IsUnitType(eu, UNIT_TYPE_STRUCTURE) == b3 ) then
                        call UnitDamageTarget(from, eu, da, b, b2, attackType, damageType, weaponType)
                    endif
                elseif ( pft == 2 and IsUnitType(eu, UNIT_TYPE_STRUCTURE) == b3 ) then
                    call UnitDamageTarget(from, eu, da, b, b2, attackType, damageType, weaponType)
                endif
                exitwhen FirstOfGroup(g) == null
            endloop
            call DestroyGroup(g)
            set eu=null
            return true
        endif
    endfunction

//library SoUnitAbtL ends
//library XGsysZhiLiao:
function Xg_Reg_ZhiLiao takes trigger trg returns nothing
	set XGsysZhiLiao___Num[0]=XGsysZhiLiao___Num[0] + 1
	set XGsysZhiLiao___Trigger[XGsysZhiLiao___Num[0]]=trg
endfunction
function Xg_ZLsource takes nothing returns unit
return LoadUnitHandle(XGsysZhiLiao___htb, XGsysZhiLiao___Num[1], 1)
endfunction
function Xg_ZLunit takes nothing returns unit
return LoadUnitHandle(XGsysZhiLiao___htb, XGsysZhiLiao___Num[1], 2)
endfunction
function Xg_ZLval takes nothing returns real
return LoadReal(XGsysZhiLiao___htb, XGsysZhiLiao___Num[1], 3)
endfunction
function Xg_setZLval takes real val returns nothing
call SaveReal(XGsysZhiLiao___htb, XGsysZhiLiao___Num[1], 3, val)
endfunction
function Xg_ZLForYLB takes nothing returns boolean
	return LoadInteger(XGsysZhiLiao___htb, XGsysZhiLiao___Num[1], 5) > 1
endfunction
function Xg_Get_YLBNum takes nothing returns integer
	return LoadInteger(XGsysZhiLiao___htb, XGsysZhiLiao___Num[1], 5)
endfunction
function Xg_Get_YLB takes nothing returns integer
	return LoadInteger(XGsysZhiLiao___htb, XGsysZhiLiao___Num[1], 4)
endfunction
function Xg_ExcSysZhiLiao takes unit us,unit ue,real val returns real
 local integer i= 1
 local real r
	set XGsysZhiLiao___Num[1]=XGsysZhiLiao___Num[1] + 1
	call SaveUnitHandle(XGsysZhiLiao___htb, XGsysZhiLiao___Num[1], 1, us)
	call SaveUnitHandle(XGsysZhiLiao___htb, XGsysZhiLiao___Num[1], 2, ue)
	call SaveReal(XGsysZhiLiao___htb, XGsysZhiLiao___Num[1], 3, val)
	loop
		exitwhen i > XGsysZhiLiao___Num[0]
		if IsTriggerEnabled(XGsysZhiLiao___Trigger[i]) then
			if TriggerEvaluate(XGsysZhiLiao___Trigger[i]) then
				call TriggerExecute(XGsysZhiLiao___Trigger[i])
			endif
		endif
		set i=i + 1
	endloop
	set r=LoadReal(XGsysZhiLiao___htb, XGsysZhiLiao___Num[1], 3)
	call FlushChildHashtable(XGsysZhiLiao___htb, XGsysZhiLiao___Num[1])
	set XGsysZhiLiao___Num[1]=XGsysZhiLiao___Num[1] - 1
	return r
endfunction
function Xg_ZhiLiao takes unit us,unit ue,real hp returns nothing
 local real val= Xg_ExcSysZhiLiao(us , ue , hp)
	call SetUnitState(ue, UNIT_STATE_LIFE, GetUnitState(ue, UNIT_STATE_LIFE) + val)
endfunction
function Trig_Group_1_Cont takes nothing returns boolean
 local unit u= GetFilterUnit()
 local integer key= GetHandleId(GetExpiredTimer())
 local unit last= LoadUnitHandle(XGsysZhiLiao___htb, key, 4)
 local unit us= LoadUnitHandle(XGsysZhiLiao___htb, key, 10)
 local real life= GetUnitState(u, UNIT_STATE_LIFE)
 local boolean b=IsUnitAlly(u, GetOwningPlayer(us)) and not ( IsUnitType(u, UNIT_TYPE_STRUCTURE) ) and life > 0.405 and life < GetUnitState(u, UNIT_STATE_MAX_LIFE) and u != last and not ( IsUnitInGroup(u, LoadGroupHandle(XGsysZhiLiao___htb, key, 11)) )
	set u=null
	set last=null
	set us=null
	return b
endfunction
function XGsysZhiLiao___Timer_YLB takes nothing returns nothing
 local timer t= GetExpiredTimer()
 local integer key= GetHandleId(t)
 local integer tnum= LoadInteger(XGsysZhiLiao___htb, key, 7)
 local real value=LoadReal(XGsysZhiLiao___htb, key, 7)
 local unit u= LoadUnitHandle(XGsysZhiLiao___htb, key, 4)
 local group sdg=LoadGroupHandle(XGsysZhiLiao___htb, key, 11)
 local unit next
 local group g= CreateGroup()
 local boolexpr expr= Condition(function Trig_Group_1_Cont)
 local real x= GetUnitX(u)
 local real y= GetUnitY(u)
 local integer num= LoadInteger(XGsysZhiLiao___htb, key, 4)
	call GroupEnumUnitsInRange(g, x, y, LoadReal(XGsysZhiLiao___htb, key, 8), expr)
	call DestroyBoolExpr(expr)
	set expr=null
	set next=GroupPickRandomUnit(g)
	call DestroyGroup(g)
	set g=null
	if tnum <= 0 or next == null or value <= 0.00 then //判断无弹射次数+无弹射单位+治疗量过低
call FlushChildHashtable(XGsysZhiLiao___htb, key)
		call PauseTimer(t)
		call DestroyTimer(t)
		call DestroyGroup(sdg)
	else
		if sdg != null then
			call GroupAddUnit(sdg, next)
		endif
		call XG_DestroyLtByTimer(0.75 , AddLightningEx(LoadStr(XGsysZhiLiao___htb, key, 9), false, x, y, GetUnitFlyHeight(u), GetUnitX(next), GetUnitY(next), Xg_GetUnitZ(next)))
		set value=value * ( 1 + LoadReal(XGsysZhiLiao___htb, key, 6) ) //治疗递减
call SaveInteger(XGsysZhiLiao___htb, XGsysZhiLiao___Num[1] + 1, 4, num + 1)
		call SaveInteger(XGsysZhiLiao___htb, XGsysZhiLiao___Num[1] + 1, 5, num + 1)
		call Xg_ZhiLiao(LoadUnitHandle(XGsysZhiLiao___htb, key, 4) , next , value)
		call SaveUnitHandle(XGsysZhiLiao___htb, GetHandleId(t), 4, next)
		call SaveReal(XGsysZhiLiao___htb, GetHandleId(t), 7, value)
		call SaveInteger(XGsysZhiLiao___htb, GetHandleId(t), 7, tnum - 1)
	endif
	set t=null
	set next=null
	set sdg=null
endfunction
 //医疗波 :来源单位,指定单位,递减参数,弹射次数,治疗量,影响范围
function Xg_YLB takes unit us,unit ue,real rds,integer num,real value,real ran,boolean cfts,string mainlight,string minorlight returns nothing
 local timer t
 local integer key
	if value <= 0 or num <= 0 then
		return
	endif
	call XG_DestroyLtByTimer(0.75 , AddLightningEx(mainlight, false, GetUnitX(us), GetUnitY(us), GetUnitFlyHeight(us), GetUnitX(ue), GetUnitY(ue), Xg_GetUnitZ(ue)))
	call SaveInteger(XGsysZhiLiao___htb, XGsysZhiLiao___Num[1] + 1, 5, 1)
	call Xg_ZhiLiao(us , ue , value)
	if num <= 1 then
		return
	endif
	set t=CreateTimer()
	set key=GetHandleId(t)
	call SaveInteger(XGsysZhiLiao___htb, key, 7, num - 1)
	call SaveReal(XGsysZhiLiao___htb, key, 7, value)
	call SaveReal(XGsysZhiLiao___htb, key, 6, rds)
	call SaveReal(XGsysZhiLiao___htb, key, 8, ran)
	call SaveStr(XGsysZhiLiao___htb, key, 9, minorlight)
	call SaveInteger(XGsysZhiLiao___htb, key, 4, 1)
	call SaveInteger(XGsysZhiLiao___htb, key, 5, num)
	if not cfts then //不重复弹射
call SaveGroupHandle(XGsysZhiLiao___htb, key, 11, CreateGroup())
	endif
	call SaveUnitHandle(XGsysZhiLiao___htb, key, 4, ue)
	call SaveUnitHandle(XGsysZhiLiao___htb, key, 10, us)
	call TimerStart(t, 0.2, true, function XGsysZhiLiao___Timer_YLB)
	set t=null
endfunction
function XGsysZhiLiao___Init takes nothing returns nothing
	set XGsysZhiLiao___Num[0]=0
	set XGsysZhiLiao___Num[1]=0
endfunction

//library XGsysZhiLiao ends
//library XgLighting:
function Xg_Reg_SDL takes trigger trg returns nothing
	set XgLighting___Num=XgLighting___Num + 1
	set XgLighting___Trigger[XgLighting___Num]=trg
endfunction
function Xg_SDLsource takes nothing returns unit
return LoadUnitHandle(XgLighting___htb, XgLighting___Que, 1)
endfunction
function Xg_SDLunit takes nothing returns unit
return LoadUnitHandle(XgLighting___htb, XgLighting___Que, 2)
endfunction
function Xg_SDLval takes nothing returns real
return LoadReal(XgLighting___htb, XgLighting___Que, 3)
endfunction
function Xg_setSDLval takes real val returns nothing
call SaveReal(XgLighting___htb, XgLighting___Que, 3, val)
endfunction
function Xg_ExcSysSDL takes unit us,unit ue,real val returns real
 local integer i= 1
	set XgLighting___Que=XgLighting___Que + 1
	call SaveUnitHandle(XgLighting___htb, XgLighting___Que, 1, us)
	call SaveUnitHandle(XgLighting___htb, XgLighting___Que, 2, ue)
	call SaveReal(XgLighting___htb, XgLighting___Que, 3, val)
	loop
		exitwhen i > XgLighting___Num
		if IsTriggerEnabled(XgLighting___Trigger[XgLighting___Num]) then
			if TriggerEvaluate(XgLighting___Trigger[XgLighting___Num]) then
				call TriggerExecute(XgLighting___Trigger[XgLighting___Num])
			endif
		endif
		set i=i + 1
	endloop
	set val=LoadReal(XgLighting___htb, XgLighting___Que, 3)
	call FlushChildHashtable(XgLighting___htb, XgLighting___Que)
	set XgLighting___Que=XgLighting___Que - 1
	return val
endfunction
function Xg_SDLSH takes unit us,unit ue,real val returns nothing
	call SaveReal(XgLighting___htb, XgLighting___Que + 1, 3, val)
	set val=Xg_ExcSysSDL(us , ue , val)
	if val > 0 then
				call UnitDamageTarget(us, ue, val, false, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_DIVINE, WEAPON_TYPE_WHOKNOWS)
		
	endif
endfunction
function Xg_Trig_Group_2_Cont takes nothing returns boolean
local unit u= GetFilterUnit()
 local integer key= GetHandleId(GetExpiredTimer())
 local unit last= LoadUnitHandle(XgLighting___htb, key, 4)
 local unit us= LoadUnitHandle(XgLighting___htb, key, 10)
 local real life= GetUnitState(u, UNIT_STATE_LIFE)
 local boolean b= not ( IsUnitAlly(u, GetOwningPlayer(us)) ) and not ( IsUnitType(u, UNIT_TYPE_STRUCTURE) ) and life > 0.405 and u != last and not ( IsUnitInGroup(u, LoadGroupHandle(XgLighting___htb, key, 11)) )
	set u=null
	set last=null
	set us=null
	return b
endfunction
function Xg_Trig_Group_3_Cont takes nothing returns boolean
local unit u= GetFilterUnit()
 local integer key= GetHandleId(GetExpiredTimer())
 local unit last= LoadUnitHandle(XgLighting___htb, key, 4)
 local unit us= LoadUnitHandle(XgLighting___htb, key, 10)
 local real life= GetUnitState(u, UNIT_STATE_LIFE)
 local boolean b= not ( IsUnitType(u, UNIT_TYPE_STRUCTURE) ) and life > 0.405 and u != last and not ( IsUnitInGroup(u, LoadGroupHandle(XgLighting___htb, key, 11)) )
	set u=null
	set last=null
	set us=null
	return b
endfunction
function XgLighting___Timer_Lighting takes nothing returns nothing
 local timer t= GetExpiredTimer()
 local integer key= GetHandleId(t)
 local integer num= LoadInteger(XgLighting___htb, key, 7)
 local real hw= LoadReal(XgLighting___htb, key, 7)
 local unit u= LoadUnitHandle(XgLighting___htb, key, 4)
 local group sdg= LoadGroupHandle(XgLighting___htb, key, 11)
 local unit next= null
 local group g= CreateGroup()
 local boolexpr expr= Condition(function Xg_Trig_Group_2_Cont)
 local real x= GetUnitX(u)
 local real y= GetUnitY(u)
	call GroupEnumUnitsInRange(g, x, y, LoadReal(XgLighting___htb, key, 8), expr)
	call DestroyBoolExpr(expr)
	if CountUnitsInGroup(g) == 0 then
		if LoadBoolean(XgLighting___htb, key, 12) then
			set expr=Condition(function Xg_Trig_Group_3_Cont)
			call GroupEnumUnitsInRange(g, x, y, LoadReal(XgLighting___htb, key, 8), expr)
			call DestroyBoolExpr(expr)
		endif
	endif
	set expr=null
	set next=GroupPickRandomUnit(g)
	call DestroyGroup(g)
	set g=null
	if num <= 0 or next == null or hw < 1 then //判断无弹射次数+无弹射单位+闪电链量过低
call FlushChildHashtable(XgLighting___htb, key)
		call PauseTimer(t)
		call DestroyTimer(t)
		call DestroyGroup(sdg)
		set t=null
		set sdg=null
		return
	endif
	if sdg != null then
		call GroupAddUnit(sdg, next)
	endif
	call XG_DestroyLtByTimer(0.45 , AddLightningEx(LoadStr(XgLighting___htb, key, 9), false, GetUnitX(u), GetUnitY(u), Xg_GetUnitZ(u), GetUnitX(next), GetUnitY(next), Xg_GetUnitZ(next)))
	set hw=hw * ( 1 + LoadReal(XgLighting___htb, key, 6) ) //闪电链递减
call Xg_SDLSH(LoadUnitHandle(XgLighting___htb, key, 10) , next , hw)
	call SaveUnitHandle(XgLighting___htb, key, 4, next)
	call SaveReal(XgLighting___htb, key, 7, hw)
	call SaveInteger(XgLighting___htb, key, 7, num - 1)
	set t=null
	set next=null
	set sdg=null
endfunction
	//闪电链 :来源单位,指定单位,递减参数,弹射次数,闪电链量,影响范围,是否弹友军,是否重复弹射
function Xg_SDL takes unit us,unit ue,real part,integer num,real dam,real range,boolean ally,boolean rtk,string mainlight,string minorlight returns nothing
 local timer t
 local integer key
	if dam <= 0 or num <= 0 then
		return
	endif
	call XG_DestroyLtByTimer(0.75 , AddLightningEx(mainlight, false, GetUnitX(us), GetUnitY(us), Xg_GetUnitZ(us), GetUnitX(ue), GetUnitY(ue), Xg_GetUnitZ(ue)))
	call Xg_SDLSH(us , ue , dam)
	if num <= 1 then
	return
	endif
	set t=CreateTimer()
	set key=GetHandleId(t)
	call SaveInteger(XgLighting___htb, key, 7, num - 1)
	call SaveReal(XgLighting___htb, key, 7, dam)
	call SaveReal(XgLighting___htb, key, 6, part)
	call SaveReal(XgLighting___htb, key, 8, range)
	call SaveBoolean(XgLighting___htb, key, 12, ally)
	call SaveStr(XgLighting___htb, key, 9, minorlight)
	if not rtk then
	call SaveGroupHandle(XgLighting___htb, key, 11, CreateGroup())
	endif
	call SaveUnitHandle(XgLighting___htb, key, 4, ue)
	call SaveUnitHandle(XgLighting___htb, key, 10, us)
	call TimerStart(t, 0.2, true, function XgLighting___Timer_Lighting)
	set t=null
endfunction

