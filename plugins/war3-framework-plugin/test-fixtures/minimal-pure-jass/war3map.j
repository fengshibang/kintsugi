//===========================================================================
// Trigger: 未命名触发器 273 复制
//===========================================================================
function Trig____________________273_______uActions takes nothing returns nothing
    if ( ( GetItemTypeId(GetSoldItem()) == 'I0PO' ) ) then
        call YDWERPGAddKey(Player(0) , "leimu" , 1)
        call YDWERPGAddKey(Player(1) , "leimu" , 1)
        call YDWERPGAddKey(Player(2) , "leimu" , 1)
        call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_UPDATED, "|cffffff00队伍蕾姆积分 +1|r")
    else
    endif
    if ( ( GetItemTypeId(GetSoldItem()) == 'I0PP' ) ) then
        if ( ( (GetRandomInt(1, 100)) <= 90 ) ) then // INLINED!!
            call YDWERPGAddKey(Player(0) , "leimu" , 1)
            call YDWERPGAddKey(Player(1) , "leimu" , 1)
            call YDWERPGAddKey(Player(2) , "leimu" , 1)
            call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_UPDATED, "|cffffff00队伍蕾姆积分 +1|r")
        else
            call YDWERPGAddKey(Player(0) , "leimu" , 2)
            call YDWERPGAddKey(Player(1) , "leimu" , 2)
            call YDWERPGAddKey(Player(2) , "leimu" , 2)
            call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_UPDATED, "|cffffff00队伍蕾姆积分 +2|r")
        endif
    else
    endif
    if ( ( GetItemTypeId(GetSoldItem()) == 'I0PQ' ) ) then
        if ( ( (GetRandomInt(1, 100)) <= 90 ) ) then // INLINED!!
            call YDWERPGAddKey(Player(0) , "leimu" , 2)
            call YDWERPGAddKey(Player(1) , "leimu" , 2)
            call YDWERPGAddKey(Player(2) , "leimu" , 2)
            call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_UPDATED, "|cffffff00队伍蕾姆积分 +2|r")
        else
            call YDWERPGAddKey(Player(0) , "leimu" , 3)
            call YDWERPGAddKey(Player(1) , "leimu" , 3)
            call YDWERPGAddKey(Player(2) , "leimu" , 3)
            call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_UPDATED, "|cffffff00队伍蕾姆积分 +3|r")
        endif
    else
    endif
endfunction
//===========================================================================
function InitTrig____________________273_______u takes nothing returns nothing
    set gg_trg____________________273_______u=CreateTrigger()
    call DisableTrigger(gg_trg____________________273_______u)
    call TriggerRegisterAnyUnitEventBJ(gg_trg____________________273_______u, EVENT_PLAYER_UNIT_SELL_ITEM)
    call TriggerAddAction(gg_trg____________________273_______u, function Trig____________________273_______uActions)
endfunction
