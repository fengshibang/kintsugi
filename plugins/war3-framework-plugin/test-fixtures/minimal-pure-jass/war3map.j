//===========================================================================
// Trigger: 未命名触发器 231
//===========================================================================
function Trig____________________231Conditions takes nothing returns boolean
    return ( ( GetOwningPlayer(GetTriggerUnit()) == Player(4) ) )
endfunction
function Trig____________________231Actions takes nothing returns nothing
    if ( ( GetUnitAbilityLevel(GetEventDamageSource(), 'A0PG') >= 1 ) and ( LoadInteger(YDHT, GetHandleId(GetEventDamageSource()), 0x765D5D5C) < 1 ) ) then
        call DisableTrigger(GetTriggeringTrigger())
        call SaveInteger(YDHT, GetHandleId(GetEventDamageSource()), 0x765D5D5C, ( ( LoadInteger(YDHT, GetHandleId(GetEventDamageSource()), 0x765D5D5C) ) + ( 1 ) ))
        call UnitAddAbility(GetEventDamageSource(), 'A0AW')
        call DisplayTextToPlayer(GetOwningPlayer(GetEventDamageSource()), 0, 0, "英雄经过战斗，激发了自己的天赋！！")
        call AddSpecialEffectLocBJ(GetUnitLoc(GetEventDamageSource()), "Abilities\\Spells\\Undead\\DarkRitual\\DarkRitualTarget.mdl")
        call EnableTrigger(GetTriggeringTrigger())
    else
    endif
    if ( ( GetUnitAbilityLevel(GetEventDamageSource(), 'A0PH') >= 1 ) and ( LoadInteger(YDHT, GetHandleId(GetEventDamageSource()), 0x765D5D5C) < 1 ) ) then
        call DisableTrigger(GetTriggeringTrigger())
        call SaveInteger(YDHT, GetHandleId(GetEventDamageSource()), 0x765D5D5C, ( ( LoadInteger(YDHT, GetHandleId(GetEventDamageSource()), 0x765D5D5C) ) + ( 1 ) ))
        call UnitAddAbility(GetEventDamageSource(), 'A01S')
        call DisplayTextToPlayer(GetOwningPlayer(GetEventDamageSource()), 0, 0, "英雄经过战斗，激发了自己的天赋！！")
        call AddSpecialEffectLocBJ(GetUnitLoc(GetEventDamageSource()), "Abilities\\Spells\\Undead\\DarkRitual\\DarkRitualTarget.mdl")
        call EnableTrigger(GetTriggeringTrigger())
    else
    endif
    if ( ( GetUnitAbilityLevel(GetEventDamageSource(), 'A0PL') >= 1 ) and ( LoadInteger(YDHT, GetHandleId(GetEventDamageSource()), 0x765D5D5C) < 1 ) ) then
        call DisableTrigger(GetTriggeringTrigger())
        call SaveInteger(YDHT, GetHandleId(GetEventDamageSource()), 0x765D5D5C, ( ( LoadInteger(YDHT, GetHandleId(GetEventDamageSource()), 0x765D5D5C) ) + ( 1 ) ))
        call UnitAddAbility(GetEventDamageSource(), 'A05V')
        call DisplayTextToPlayer(GetOwningPlayer(GetEventDamageSource()), 0, 0, "英雄经过战斗，激发了自己的天赋！！")
        call AddSpecialEffectLocBJ(GetUnitLoc(GetEventDamageSource()), "Abilities\\Spells\\Undead\\DarkRitual\\DarkRitualTarget.mdl")
        call EnableTrigger(GetTriggeringTrigger())
    else
    endif
    if ( ( GetUnitAbilityLevel(GetEventDamageSource(), 'A0PM') >= 1 ) and ( LoadInteger(YDHT, GetHandleId(GetEventDamageSource()), 0x765D5D5C) < 1 ) ) then
        call DisableTrigger(GetTriggeringTrigger())
        call SaveInteger(YDHT, GetHandleId(GetEventDamageSource()), 0x765D5D5C, ( ( LoadInteger(YDHT, GetHandleId(GetEventDamageSource()), 0x765D5D5C) ) + ( 1 ) ))
        call UnitAddAbility(GetEventDamageSource(), 'A01L')
        call DisplayTextToPlayer(GetOwningPlayer(GetEventDamageSource()), 0, 0, "英雄经过战斗，激发了自己的天赋！！")
        call AddSpecialEffectLocBJ(GetUnitLoc(GetEventDamageSource()), "Abilities\\Spells\\Undead\\DarkRitual\\DarkRitualTarget.mdl")
        call EnableTrigger(GetTriggeringTrigger())
    else
    endif
    if ( ( GetUnitAbilityLevel(GetEventDamageSource(), 'A0UT') >= 1 ) and ( LoadInteger(YDHT, GetHandleId(GetEventDamageSource()), 0x765D5D5C) < 1 ) ) then
        call DisableTrigger(GetTriggeringTrigger())
        call SaveInteger(YDHT, GetHandleId(GetEventDamageSource()), 0x765D5D5C, ( ( LoadInteger(YDHT, GetHandleId(GetEventDamageSource()), 0x765D5D5C) ) + ( 1 ) ))
        call UnitAddAbility(GetEventDamageSource(), 'A0P2')
        call DisplayTextToPlayer(GetOwningPlayer(GetEventDamageSource()), 0, 0, "英雄经过战斗，激发了自己的天赋！！")
        call AddSpecialEffectLocBJ(GetUnitLoc(GetEventDamageSource()), "Abilities\\Spells\\Undead\\DarkRitual\\DarkRitualTarget.mdl")
        call EnableTrigger(GetTriggeringTrigger())
    else
    endif
endfunction
