//===========================================================================
// Trigger: 未命名触发器 143
//===========================================================================
function Trig____________________143Actions takes nothing returns nothing
    if ( ( GetItemTypeId(GetManipulatedItem()) == 'I07D' ) and ( GetItemCharges(GetManipulatedItem()) == 0 ) ) then
        call YDWEPolledWaitNull(4.00)
        call RemoveItem(GetManipulatedItem())
    else
    endif
    if ( ( GetItemTypeId(GetManipulatedItem()) == 'I0KX' ) and ( GetItemCharges(GetManipulatedItem()) == 0 ) ) then
        call YDWEPolledWaitNull(4.00)
        call RemoveItem(GetManipulatedItem())
    else
    endif
endfunction
