    else
        return ( GetUnitAbilityLevel(whichUnit, buff123) > 0 )
    endif
endfunction
function ZEROZAG4 takes unit d1,real s1,real s2,integer z1 returns real
    local real s
            if z1 == 1 then
        set s=( GetUnitX(d1) + ( s1 * CosBJ(s2) ) )
            else
        set s=( GetUnitY(d1) + ( s1 * SinBJ(s2) ) )
            endif
    return s
endfunction
