//读取击晕指令记录数据
function jiyundanwei2 takes nothing returns nothing
 local timer t= GetExpiredTimer()
 local effect tx= LoadEffectHandle(ssdsdsds___hxb, GetHandleId(t), 1)
 local unit u= LoadUnitHandle(ssdsdsds___hxb, GetHandleId(t), 2)
 local unit us= null
	call PauseUnit(u, false)
	call DestroyEffect(tx)
	call DestroyTimer(t)
	set t=null
	set tx=null
	set u=null
	//call BJDebugMsg("计时器到期：清除")
endfunction
//输出击晕指令记录数据
function jiyundanwei takes unit u,unit us,real r,integer z returns nothing
 local timer t= CreateTimer()
 local effect tx= AddSpecialEffectTarget("Abilities\\Spells\\Human\\StormBolt\\StormBoltTarget.mdl", us, "head")
	set ssdsdsds___p=GetOwningPlayer(u)
	call PauseUnit(us, true)
	call SaveEffectHandle(ssdsdsds___hxb, GetHandleId(t), 1, tx)
	call SaveUnitHandle(ssdsdsds___hxb, GetHandleId(t), 2, us)
	call TimerStart(t, r, false, function jiyundanwei2)
	//call BJDebugMsg("计时器运行：开始")
	call SaveUnitHandle(ssdsdsds___hxb, z, 3, us)
	call SaveUnitHandle(ssdsdsds___hxb, z, 4, u)
	set tx=null
	set t=null
endfunction

