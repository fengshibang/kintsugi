    if ( ( GetUnitAbilityLevel(GetEventDamageSource(), 'A0UG') >= 1 ) ) then
        call AdjustPlayerStateBJ(5, GetOwningPlayer(GetEventDamageSource()), PLAYER_STATE_RESOURCE_GOLD)
    else
