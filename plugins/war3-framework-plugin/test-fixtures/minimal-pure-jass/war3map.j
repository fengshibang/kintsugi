    set gg_trg____________________093=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg____________________093, EVENT_PLAYER_UNIT_ATTACKED)
    call TriggerAddAction(gg_trg____________________093, function Trig____________________093Actions)
endfunction
