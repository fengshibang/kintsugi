function Trig____________________093Actions takes nothing returns nothing
    if ( ( GetUnitTypeId(GetAttacker()) == 'n02X' ) ) then
        call DisableTrigger(GetTriggeringTrigger())
        call CreateTextTagUnitBJ("多重雷霆一击！！！", GetAttacker(), 0, 20.00, 100.00, 0.00, 0.00, 0)
        call YDWETimerDestroyTextTag(2 , GetLastCreatedTextTag())
        call YDWEPolledWaitNull(1.00)
        call IssueImmediateOrder(GetAttacker(), "thunderclap")
        call YDWEPolledWaitNull(2.00)
        call CreateNUnitsAtLocFacingLocBJ(1, 'e00Q', Player(4), PolarProjectionBJ(GetUnitLoc(GetAttacker()), 600.00, 90.00), GetUnitLoc(GetAttacker()))
        call IssueImmediateOrder(bj_lastCreatedUnit, "thunderclap")
        call CreateNUnitsAtLocFacingLocBJ(1, 'e00Q', Player(4), PolarProjectionBJ(GetUnitLoc(GetAttacker()), 600.00, 135.00), GetUnitLoc(GetAttacker()))
        call IssueImmediateOrder(bj_lastCreatedUnit, "thunderclap")
        call CreateNUnitsAtLocFacingLocBJ(1, 'e00Q', Player(4), PolarProjectionBJ(GetUnitLoc(GetAttacker()), 600.00, 180.00), GetUnitLoc(GetAttacker()))
        call IssueImmediateOrder(bj_lastCreatedUnit, "thunderclap")
        call CreateNUnitsAtLocFacingLocBJ(1, 'e00Q', Player(4), PolarProjectionBJ(GetUnitLoc(GetAttacker()), 600.00, 225.00), GetUnitLoc(GetAttacker()))
        call IssueImmediateOrder(bj_lastCreatedUnit, "thunderclap")
        call CreateNUnitsAtLocFacingLocBJ(1, 'e00Q', Player(4), PolarProjectionBJ(GetUnitLoc(GetAttacker()), 600.00, 270.00), GetUnitLoc(GetAttacker()))
        call IssueImmediateOrder(bj_lastCreatedUnit, "thunderclap")
        call CreateNUnitsAtLocFacingLocBJ(1, 'e00Q', Player(4), PolarProjectionBJ(GetUnitLoc(GetAttacker()), 600.00, 315.00), GetUnitLoc(GetAttacker()))
        call IssueImmediateOrder(bj_lastCreatedUnit, "thunderclap")
        call CreateNUnitsAtLocFacingLocBJ(1, 'e00Q', Player(4), PolarProjectionBJ(GetUnitLoc(GetAttacker()), 600.00, 360.00), GetUnitLoc(GetAttacker()))
        call IssueImmediateOrder(bj_lastCreatedUnit, "thunderclap")
        call CreateNUnitsAtLocFacingLocBJ(1, 'e00Q', Player(4), PolarProjectionBJ(GetUnitLoc(GetAttacker()), 600.00, 45.00), GetUnitLoc(GetAttacker()))
        call IssueImmediateOrder(bj_lastCreatedUnit, "thunderclap")
        call YDWEPolledWaitNull(9.00)
        call EnableTrigger(GetTriggeringTrigger())
    else
    endif
    if ( ( GetUnitTypeId(GetAttacker()) == 'n03K' ) ) then
        call DisableTrigger(GetTriggeringTrigger())
        call CreateTextTagUnitBJ("震荡冲击！！！", GetAttacker(), 0, 20.00, 100.00, 0.00, 0.00, 0)
        call YDWETimerDestroyTextTag(2 , GetLastCreatedTextTag())
        call YDWEPolledWaitNull(1.00)
        call CreateNUnitsAtLocFacingLocBJ(1, 'e013', Player(4), PolarProjectionBJ(GetUnitLoc(GetAttacker()), 200.00, GetUnitFacing(GetAttacker())), GetUnitLoc(GetAttacker()))
        call IssueImmediateOrder(bj_lastCreatedUnit, "thunderclap")
        call CreateNUnitsAtLocFacingLocBJ(1, 'e013', Player(4), PolarProjectionBJ(GetUnitLoc(GetAttacker()), 400.00, GetUnitFacing(GetAttacker())), GetUnitLoc(GetAttacker()))
        call IssueImmediateOrder(bj_lastCreatedUnit, "thunderclap")
        call CreateNUnitsAtLocFacingLocBJ(1, 'e013', Player(4), PolarProjectionBJ(GetUnitLoc(GetAttacker()), 600.00, GetUnitFacing(GetAttacker())), GetUnitLoc(GetAttacker()))
        call IssueImmediateOrder(bj_lastCreatedUnit, "thunderclap")
        call CreateNUnitsAtLocFacingLocBJ(1, 'e013', Player(4), PolarProjectionBJ(GetUnitLoc(GetAttacker()), 800.00, GetUnitFacing(GetAttacker())), GetUnitLoc(GetAttacker()))
        call IssueImmediateOrder(bj_lastCreatedUnit, "thunderclap")
        call YDWEPolledWaitNull(9.00)
        call EnableTrigger(GetTriggeringTrigger())
    else
    endif
    if ( ( GetUnitTypeId(GetAttacker()) == 'n03O' ) ) then
        // RushSlide 已迁移到 ECS Lua 系统 (UnitAttackTriggerRushSlide) — 以下仅保留后续震荡波逻辑
        call DisableTrigger(GetTriggeringTrigger())
        call YDWEPolledWaitNull(1.00)
        call UnitAddAbility(GetAttacker(), 'A0L6')
        call CreateNUnitsAtLocFacingLocBJ(1, 'e00D', Player(4), PolarProjectionBJ(GetUnitLoc(GetAttacker()), 300.00, GetUnitFacing(GetAttacker())), GetUnitLoc(GetAttacker()))
        call IssuePointOrderLoc(GetAttacker(), "shockwave", GetUnitLoc(bj_lastCreatedUnit))
        call YDWEPolledWaitNull(1.00)
        call UnitRemoveAbility(GetAttacker(), 'A074')
        call YDWEPolledWaitNull(9.00)
        call EnableTrigger(GetTriggeringTrigger())
    else
    endif
    if ( ( GetUnitTypeId(GetAttacker()) == 'n057' ) ) then
        call AddSpecialEffectTargetUnitBJ("origin", GetAttacker(), "Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl")
    else
    endif
endfunction
