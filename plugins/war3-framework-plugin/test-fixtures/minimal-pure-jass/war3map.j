function Trig_danmuConditions takes nothing returns boolean
    return ( ( GetSpellAbilityId() == 'A0CL' ) )
endfunction
function Trig_danmuFunc005Func001Func003Func003Func001Func008005 takes nothing returns boolean
    return ( ( ( IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xA1614B4D))) == true ) and ( IsUnitAliveBJ(GetFilterUnit()) == true ) ) )
