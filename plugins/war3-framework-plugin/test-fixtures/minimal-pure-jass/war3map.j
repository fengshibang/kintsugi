//===========================================================================
// Trigger: 未命名触发器 008
//===========================================================================
function Trig____________________008Actions takes nothing returns nothing
    call AdjustPlayerStateBJ(100, Player(0), PLAYER_STATE_RESOURCE_GOLD)
    call AdjustPlayerStateBJ(100, Player(1), PLAYER_STATE_RESOURCE_GOLD)
    call AdjustPlayerStateBJ(100, Player(2), PLAYER_STATE_RESOURCE_GOLD)
    call FogMaskEnable(true)
    call FogEnable(true)
    call SetPlayerHandicapXP(Player(0), 0.00)
    call SetPlayerHandicapXP(Player(1), 0.00)
    call SetPlayerHandicapXP(Player(2), 0.00)
    call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_UPDATED, "游戏快捷说话：
1： 我准备好了！
2： 好了吗？
3： 等等，先别开！
4： 救救我！
5： ？
6： GG

|cffffff00输入 -1 可以查看拥有皮肤|r
|cffffff00输入 -2 可以查看未拥有皮肤|r

|cffff0000一局泡点上限 60 点|r")
    call SetPlayerAllianceStateBJ(Player(4), Player(PLAYER_NEUTRAL_PASSIVE), bj_ALLIANCE_ALLIED_VISION)
    call SetPlayerAllianceStateBJ(Player(PLAYER_NEUTRAL_PASSIVE), Player(4), bj_ALLIANCE_ALLIED_VISION)
endfunction
//===========================================================================
function InitTrig____________________008 takes nothing returns nothing
    set gg_trg____________________008=CreateTrigger()
    call TriggerAddAction(gg_trg____________________008, function Trig____________________008Actions)
endfunction
//===========================================================================
// Trigger: 未命名触发器 005
//===========================================================================
function Trig____________________005Actions takes nothing returns nothing
    if ( ( GetPlayerSlotState(Player(1)) == PLAYER_SLOT_STATE_PLAYING ) and ( GetPlayerController(Player(1)) == MAP_CONTROL_USER ) ) then
        call AddPlayerTechResearched(Player(4), 'R000', 2)
    else
    endif
    if ( ( GetPlayerSlotState(Player(2)) == PLAYER_SLOT_STATE_PLAYING ) and ( GetPlayerController(Player(2)) == MAP_CONTROL_USER ) ) then
        call AddPlayerTechResearched(Player(4), 'R000', 2)
    else
    endif
endfunction
//===========================================================================
function InitTrig____________________005 takes nothing returns nothing
    set gg_trg____________________005=CreateTrigger()
    call TriggerAddAction(gg_trg____________________005, function Trig____________________005Actions)
endfunction
