//===========================================================================
// Trigger: 未命名触发器 002
//===========================================================================
function Trig____________________002Actions takes nothing returns nothing
    // RushSlide + fly height 已迁移到 ECS Lua 系统 (UnitSpellEffectRushSlide)
    return
    if ( ( GetSpellAbilityId() == 'A0G6' ) ) then
        call YDWETimerPatternRushSlide(GetSpellAbilityUnit() , GetUnitFacing(GetSpellAbilityUnit()) , 500.00 , 1 , 0.03 , 0 , false , false , false , "origin" , "Abilities\\Weapons\\Bolt\\BoltImpact.mdl" , "Abilities\\Weapons\\Bolt\\BoltImpact.mdl")
    else
    endif
    if ( ( GetSpellAbilityId() == 'A0G6' ) ) then
        if ( ( GetUnitAbilityLevel(GetSpellAbilityUnit(), 'A0QH') >= 1 ) ) then
            call YDWEPolledWaitNull(1.00)
            call UnitAddAbility(GetSpellAbilityUnit(), 'Amrf')
            call SetUnitFlyHeight(GetSpellAbilityUnit(), 200.00, 0.00)
            call UnitRemoveAbility(GetSpellAbilityUnit(), 'Amrf')
            call EXSetUnitMoveType(GetSpellAbilityUnit(), 0x04)
        else
        endif
    else
    endif
    if ( ( GetSpellAbilityId() == 'A0G6' ) ) then
        if ( ( GetUnitAbilityLevel(GetSpellAbilityUnit(), 'A0A0') >= 1 ) ) then
            call YDWEPolledWaitNull(1.00)
            call UnitAddAbility(GetSpellAbilityUnit(), 'Amrf')
            call SetUnitFlyHeight(GetSpellAbilityUnit(), 200.00, 0.00)
            call UnitRemoveAbility(GetSpellAbilityUnit(), 'Amrf')
            call EXSetUnitMoveType(GetSpellAbilityUnit(), 0x04)
        else
        endif
    else
    endif
    if ( ( GetSpellAbilityId() == 'A0G6' ) ) then
        if ( ( GetUnitAbilityLevel(GetSpellAbilityUnit(), 'A0TE') >= 1 ) ) then
            call YDWEPolledWaitNull(1.00)
            call UnitAddAbility(GetSpellAbilityUnit(), 'Amrf')
            call SetUnitFlyHeight(GetSpellAbilityUnit(), 200.00, 0.00)
            call UnitRemoveAbility(GetSpellAbilityUnit(), 'Amrf')
            call EXSetUnitMoveType(GetSpellAbilityUnit(), 0x04)
        else
        endif
    else
    endif
endfunction
//===========================================================================
function InitTrig____________________002 takes nothing returns nothing
    set gg_trg____________________002=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg____________________002, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddAction(gg_trg____________________002, function Trig____________________002Actions)
endfunction
//===========================================================================
// Trigger: 未命名触发器 006 复制 2
//===========================================================================
function Trig____________________006________2Conditions takes nothing returns boolean
    return ( ( IsUnitType(GetManipulatingUnit(), UNIT_TYPE_HERO) == true ) )
endfunction
