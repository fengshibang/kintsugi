function ZEROZAG6 takes integer i,integer n returns string
        local string s=I2S(i)
        local integer l=StringLength(s)
        if i > 0 then
            if l > n then
                set l=0
                set s=""
                loop
                    set l=l + 1
                    set s=s + "9"
                    exitwhen l == n
                endloop
            else
                if l != n then
                    loop
                        set l=l + 1
                        set s="0" + s
                        exitwhen l == n
                    endloop
                endif
            endif
        else
            set l=0
            set s=""
            loop
                set l=l + 1
                set s=s + "0"
                exitwhen l == n
            endloop
        endif
        return s
    endfunction
