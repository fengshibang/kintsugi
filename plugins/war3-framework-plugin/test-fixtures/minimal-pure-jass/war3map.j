        else
        endif
    else
    endif
    if ( ( GetUnitAbilityLevel(GetEventDamageSource(), 'A0FU') < 10 ) and ( GetUnitAbilityLevel(GetEventDamageSource(), 'A0FU') >= 1 ) ) then
        if ( ( GetRandomInt(1, 100) <= 1 ) ) then
            call IncUnitAbilityLevel(GetEventDamageSource(), 'A0FU')
            call DisplayTextToPlayer(GetOwningPlayer(GetEventDamageSource()), 0, 0, "英雄经过长时间的战斗，|cffff0000幸运者|r等级提升了！！")
        else
        endif
    else
    endif
    if ( ( GetUnitAbilityLevel(GetEventDamageSource(), 'A0J4') < 10 ) and ( GetUnitAbilityLevel(GetEventDamageSource(), 'A0J4') >= 1 ) ) then
        if ( ( GetRandomInt(1, 100) <= 1 ) ) then
            call IncUnitAbilityLevel(GetEventDamageSource(), 'A0J4')
