    else
    endif
    endif
    else
    endif
    if ( ( GetPlayerSlotState(GetOwningPlayer(d1)) == PLAYER_SLOT_STATE_LEFT ) ) then
    call KillUnit(dan)
    call KillUnit(danE)
    call SaveBoolean(YDHT, GetHandleId(d1), 0x37FDCE3D, false)
