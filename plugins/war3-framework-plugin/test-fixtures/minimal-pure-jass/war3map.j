//===========================================================================
// Trigger: 未命名触发器 203
//===========================================================================
function Trig____________________203Conditions takes nothing returns boolean
    return ( ( GetOwningPlayer(GetTriggerUnit()) == Player(4) ) )
endfunction
function Trig____________________203Actions takes nothing returns nothing
    if ( ( GetUnitAbilityLevel(GetEventDamageSource(), 'A0KW') < 9 ) and ( GetUnitAbilityLevel(GetEventDamageSource(), 'A0KW') >= 1 ) ) then
        if ( ( GetRandomInt(1, 100) <= 1 ) ) then
