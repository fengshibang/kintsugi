        call CreateNUnitsAtLocFacingLocBJ(1, 'h019', Player(4), PolarProjectionBJ(GetUnitLoc(GetAttacker()), 200.00, 270.00), GetUnitLoc(GetAttacker()))
        call YDWEPolledWaitNull(1.00)
        call CreateNUnitsAtLocFacingLocBJ(1, 'h019', Player(4), GetRectCenter(gg_rct______________018), GetUnitLoc(GetAttacker()))
        call CreateNUnitsAtLocFacingLocBJ(1, 'h019', Player(4), GetRectCenter(gg_rct______________019), GetUnitLoc(GetAttacker()))
        call CreateNUnitsAtLocFacingLocBJ(1, 'h019', Player(4), GetRectCenter(gg_rct______________020), GetUnitLoc(GetAttacker()))
        call CreateNUnitsAtLocFacingLocBJ(1, 'h019', Player(4), GetRectCenter(gg_rct______________021), GetUnitLoc(GetAttacker()))
        call YDWEPolledWaitNull(9.00)
        call EnableTrigger(GetTriggeringTrigger())
