function Trig____________________044Actions takes nothing returns nothing
    local integer ydl_localvar_step= LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76)
 set ydl_localvar_step=ydl_localvar_step + 3
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76, ydl_localvar_step)
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7, ydl_localvar_step)
    if ( ( GetItemTypeId(GetSoldItem()) == 'I03I' ) ) then
        // [ECS_MIGRATED] 福利关卡生成器已迁移到 WelfareLevelSystem (监听 AnyUnitSellItem 事件自动启动)
        // 原 JASS 通过 EnableTrigger/DisableTrigger 控制 045 的 1 秒周期生成，现由 ECS 接管
        // call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_UPDATED, "福利关卡挑战开始！！！")
        // call EnableTrigger(gg_trg____________________045)
        // call StartTimerBJ(CreateTimer(), false, 20.00)
        // call CreateTimerDialogBJ(GetLastCreatedTimerBJ(), "结束时间：")
        // call TimerDialogDisplay(bj_lastCreatedTimerDialog, true)
        // call SaveTimerDialogHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x437E2A40, GetLastCreatedTimerDialogBJ())
        // call YDWEPolledWaitNull(19.00)
        // call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7, ydl_localvar_step)
        // call DestroyTimerDialog(LoadTimerDialogHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x437E2A40))
        // call DisableTrigger(gg_trg____________________045)
        // call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_UPDATED, "福利关卡结束！！！")
    else
    endif
    if ( ( GetItemTypeId(GetSoldItem()) == 'I07A' ) ) then
        call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_UPDATED, "福利关卡挑战开始！！！")
        call ForGroupBJ(YDWEGetUnitsOfPlayerMatchingNull(Player(0) , Condition(function Trig____________________044Func002Func002001002)), function Trig____________________044Func002Func002002)
        call ForGroupBJ(YDWEGetUnitsOfPlayerMatchingNull(Player(0) , Condition(function Trig____________________044Func002Func003001002)), function Trig____________________044Func002Func003002)
        call ForGroupBJ(YDWEGetUnitsOfPlayerMatchingNull(Player(1) , Condition(function Trig____________________044Func002Func004001002)), function Trig____________________044Func002Func004002)
        call ForGroupBJ(YDWEGetUnitsOfPlayerMatchingNull(Player(1) , Condition(function Trig____________________044Func002Func005001002)), function Trig____________________044Func002Func005002)
        call ForGroupBJ(YDWEGetUnitsOfPlayerMatchingNull(Player(2) , Condition(function Trig____________________044Func002Func006001002)), function Trig____________________044Func002Func006002)
        call ForGroupBJ(YDWEGetUnitsOfPlayerMatchingNull(Player(2) , Condition(function Trig____________________044Func002Func007001002)), function Trig____________________044Func002Func007002)
    else
    endif
    if ( ( GetItemTypeId(GetSoldItem()) == 'I07B' ) ) then
        call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_UPDATED, "福利关卡挑战开始！！！")
        call ForGroupBJ(YDWEGetUnitsOfPlayerMatchingNull(Player(0) , Condition(function Trig____________________044Func003Func002001002)), function Trig____________________044Func003Func002002)
        call ForGroupBJ(YDWEGetUnitsOfPlayerMatchingNull(Player(0) , Condition(function Trig____________________044Func003Func003001002)), function Trig____________________044Func003Func003002)
        call ForGroupBJ(YDWEGetUnitsOfPlayerMatchingNull(Player(1) , Condition(function Trig____________________044Func003Func004001002)), function Trig____________________044Func003Func004002)
        call ForGroupBJ(YDWEGetUnitsOfPlayerMatchingNull(Player(1) , Condition(function Trig____________________044Func003Func005001002)), function Trig____________________044Func003Func005002)
        call ForGroupBJ(YDWEGetUnitsOfPlayerMatchingNull(Player(2) , Condition(function Trig____________________044Func003Func006001002)), function Trig____________________044Func003Func006002)
        call ForGroupBJ(YDWEGetUnitsOfPlayerMatchingNull(Player(2) , Condition(function Trig____________________044Func003Func007001002)), function Trig____________________044Func003Func007002)
    else
    endif
    if ( ( GetItemTypeId(GetSoldItem()) == 'I07S' ) ) then
        call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_UPDATED, "福利关卡挑战开始！！！")
        call ForGroupBJ(YDWEGetUnitsOfPlayerMatchingNull(Player(0) , Condition(function Trig____________________044Func004Func002001002)), function Trig____________________044Func004Func002002)
        call ForGroupBJ(YDWEGetUnitsOfPlayerMatchingNull(Player(0) , Condition(function Trig____________________044Func004Func003001002)), function Trig____________________044Func004Func003002)
        call ForGroupBJ(YDWEGetUnitsOfPlayerMatchingNull(Player(1) , Condition(function Trig____________________044Func004Func004001002)), function Trig____________________044Func004Func004002)
        call ForGroupBJ(YDWEGetUnitsOfPlayerMatchingNull(Player(1) , Condition(function Trig____________________044Func004Func005001002)), function Trig____________________044Func004Func005002)
        call ForGroupBJ(YDWEGetUnitsOfPlayerMatchingNull(Player(2) , Condition(function Trig____________________044Func004Func006001002)), function Trig____________________044Func004Func006002)
        call ForGroupBJ(YDWEGetUnitsOfPlayerMatchingNull(Player(2) , Condition(function Trig____________________044Func004Func007001002)), function Trig____________________044Func004Func007002)
        if ( ( GetRandomInt(1, 100) <= 80 ) ) then
            call ForGroupBJ(YDWEGetUnitsOfPlayerMatchingNull(Player(0) , Condition(function Trig____________________044Func004Func008Func004001002)), function Trig____________________044Func004Func008Func004002)
            call ForGroupBJ(YDWEGetUnitsOfPlayerMatchingNull(Player(1) , Condition(function Trig____________________044Func004Func008Func005001002)), function Trig____________________044Func004Func008Func005002)
            call ForGroupBJ(YDWEGetUnitsOfPlayerMatchingNull(Player(2) , Condition(function Trig____________________044Func004Func008Func006001002)), function Trig____________________044Func004Func008Func006002)
        else
            call ForGroupBJ(YDWEGetUnitsOfPlayerMatchingNull(Player(0) , Condition(function Trig____________________044Func004Func008Func001001002)), function Trig____________________044Func004Func008Func001002)
            call ForGroupBJ(YDWEGetUnitsOfPlayerMatchingNull(Player(1) , Condition(function Trig____________________044Func004Func008Func002001002)), function Trig____________________044Func004Func008Func002002)
            call ForGroupBJ(YDWEGetUnitsOfPlayerMatchingNull(Player(2) , Condition(function Trig____________________044Func004Func008Func003001002)), function Trig____________________044Func004Func008Func003002)
        endif
    else
    endif
    call FlushChildHashtable(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step)
endfunction
