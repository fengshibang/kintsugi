            call IncUnitAbilityLevel(GetAttacker(), 'A099')
            call YDWEGeneralBounsSystemUnitSetBonus(GetAttacker() , 3 , 0 , 50)
            call DisplayTextToPlayer(GetOwningPlayer(GetAttacker()), 0, 0, "英雄经过长时间的战斗，|cffff0000分裂攻击|r等级提升了！！")
        else
        endif
    else
    endif
    if ( ( GetUnitAbilityLevel(GetAttacker(), 'A06D') < 9 ) and ( GetUnitAbilityLevel(GetAttacker(), 'A06D') >= 1 ) ) then
        if ( ( GetRandomInt(1, 100) <= 1 ) ) then
            call IncUnitAbilityLevel(GetAttacker(), 'A06D')
            call DisplayTextToPlayer(GetOwningPlayer(GetAttacker()), 0, 0, "英雄经过长时间的战斗，|cffff0000燃尽|r等级提升了！！")
        else
        endif
    else
    endif
endfunction
