function Trig____________________087Actions takes nothing returns nothing
    if ( ( GetUnitTypeId(GetAttacker()) == 'n02T' ) ) then
        call DisableTrigger(GetTriggeringTrigger())
        call CreateTextTagUnitBJ("火箭弹！！！", GetAttacker(), 0, 20.00, 100.00, 0.00, 0.00, 0)
        call YDWETimerDestroyTextTag(2 , GetLastCreatedTextTag())
        call YDWEPolledWaitNull(1.00)
        call CreateNUnitsAtLoc(1, 'e00M', Player(4), GetUnitLoc(GetAttacker()), bj_UNIT_FACING)
        call IssuePointOrderLoc(bj_lastCreatedUnit, "clusterrockets", GetUnitLoc(GetAttacker()))
        call YDWEPolledWaitNull(10.00)
        call EnableTrigger(GetTriggeringTrigger())
    else
    endif
    if ( ( GetUnitTypeId(GetAttacker()) == 'n02U' ) ) then
        call DisableTrigger(GetTriggeringTrigger())
        call CreateTextTagUnitBJ("烈焰风暴！！！", GetAttacker(), 0, 20.00, 100.00, 0.00, 0.00, 0)
        call YDWETimerDestroyTextTag(2 , GetLastCreatedTextTag())
        call YDWEPolledWaitNull(1.00)
        call CreateNUnitsAtLoc(1, 'e00N', Player(4), GetUnitLoc(GetAttacker()), bj_UNIT_FACING)
        call IssuePointOrderLoc(bj_lastCreatedUnit, "flamestrike", GetUnitLoc(GetAttacker()))
        call YDWEPolledWaitNull(10.00)
        call EnableTrigger(GetTriggeringTrigger())
    else
    endif
    if ( ( GetUnitTypeId(GetAttacker()) == 'n017' ) ) then
        call DisableTrigger(GetTriggeringTrigger())
        call CreateTextTagUnitBJ("火焰之路！！！", GetAttacker(), 0, 20.00, 100.00, 0.00, 0.00, 0)
        call YDWETimerDestroyTextTag(2 , GetLastCreatedTextTag())
        call YDWEPolledWaitNull(1.00)
        call UnitAddAbility(GetAttacker(), 'A03N')
        call IssueImmediateOrder(GetAttacker(), "waterelemental")
        call YDWEPolledWaitNull(1.00)
        call UnitRemoveAbility(GetAttacker(), 'A03N')
        call YDWEPolledWaitNull(8.00)
        call EnableTrigger(GetTriggeringTrigger())
    else
    endif
    if ( ( GetUnitTypeId(GetAttacker()) == 'n02V' ) ) then
        call DisableTrigger(GetTriggeringTrigger())
        call CreateTextTagUnitBJ("火焰雨！！！", GetAttacker(), 0, 20.00, 100.00, 0.00, 0.00, 0)
        call YDWETimerDestroyTextTag(2 , GetLastCreatedTextTag())
        call YDWEPolledWaitNull(1.00)
        call CreateNUnitsAtLoc(1, 'e00O', Player(4), GetUnitLoc(GetAttacker()), bj_UNIT_FACING)
        call IssuePointOrderLoc(bj_lastCreatedUnit, "rainoffire", GetUnitLoc(GetAttacker()))
        call YDWEPolledWaitNull(10.00)
        call EnableTrigger(GetTriggeringTrigger())
    else
    endif
    if ( ( GetUnitTypeId(GetAttacker()) == 'n038' ) ) then
        call DisableTrigger(GetTriggeringTrigger())
        call CreateTextTagUnitBJ("火元素！！！", GetAttacker(), 0, 20.00, 100.00, 0.00, 0.00, 0)
        call YDWETimerDestroyTextTag(2 , GetLastCreatedTextTag())
        call YDWEPolledWaitNull(1.00)
        call CreateUnitAtLoc(Player(4), 'h01N', GetRandomLocInRect(gg_rct______________003), 0)
        call CreateUnitAtLoc(Player(4), 'h01N', GetRandomLocInRect(gg_rct______________003), 0)
        call CreateUnitAtLoc(Player(4), 'h01N', GetRandomLocInRect(gg_rct______________003), 0)
        call YDWEPolledWaitNull(10.00)
        call EnableTrigger(GetTriggeringTrigger())
    else
    endif
    if ( ( GetUnitTypeId(GetAttacker()) == 'n03D' ) ) then
        call DisableTrigger(GetTriggeringTrigger())
        call CreateTextTagUnitBJ("火焰吐息！！！", GetAttacker(), 0, 20.00, 100.00, 0.00, 0.00, 0)
        call YDWETimerDestroyTextTag(2 , GetLastCreatedTextTag())
        call YDWEPolledWaitNull(1.00)
        call UnitAddAbility(GetAttacker(), 'A0K2')
        call CreateNUnitsAtLocFacingLocBJ(1, 'e00D', Player(4), PolarProjectionBJ(GetUnitLoc(GetAttacker()), 300.00, GetUnitFacing(GetAttacker())), GetUnitLoc(GetAttacker()))
        call IssuePointOrderLoc(GetAttacker(), "breathoffire", GetUnitLoc(bj_lastCreatedUnit))
        call YDWEPolledWaitNull(1.00)
        call UnitRemoveAbility(GetAttacker(), 'A0K2')
        call YDWEPolledWaitNull(8.00)
        call EnableTrigger(GetTriggeringTrigger())
    else
    endif
endfunction
