//===========================================================================
// Trigger: 未命名触发器 131
//===========================================================================
function Trig____________________131Actions takes nothing returns nothing
    if ( ( GetItemTypeId(GetManipulatedItem()) == 'I06X' ) ) then
        call CreateNUnitsAtLoc(1, 'n009', GetOwningPlayer(GetManipulatingUnit()), PolarProjectionBJ(GetUnitLoc(GetManipulatingUnit()), 100.00, GetUnitFacing(GetManipulatingUnit())), bj_UNIT_FACING)
        call SetUnitState(bj_lastCreatedUnit, ConvertUnitState(0x12), Xcalld(GetManipulatingUnit() , (LoadInteger(XGGetHeroMainAttr__htb, GetUnitTypeId((GetManipulatingUnit())), 0)) , true , 1.00)) // INLINED!!
    else
    endif
    if ( ( GetItemTypeId(GetManipulatedItem()) == 'I06Z' ) ) then
        call CreateNUnitsAtLoc(1, 'n00D', GetOwningPlayer(GetManipulatingUnit()), PolarProjectionBJ(GetUnitLoc(GetManipulatingUnit()), 100.00, GetUnitFacing(GetManipulatingUnit())), bj_UNIT_FACING)
        call SetUnitState(bj_lastCreatedUnit, ConvertUnitState(0x12), Xcalld(GetManipulatingUnit() , (LoadInteger(XGGetHeroMainAttr__htb, GetUnitTypeId((GetManipulatingUnit())), 0)) , true , 2.00)) // INLINED!!
    else
    endif
    if ( ( GetItemTypeId(GetManipulatedItem()) == 'I08N' ) ) then
        call CreateNUnitsAtLoc(1, 'n02H', GetOwningPlayer(GetManipulatingUnit()), PolarProjectionBJ(GetUnitLoc(GetManipulatingUnit()), 100.00, GetUnitFacing(GetManipulatingUnit())), bj_UNIT_FACING)
        call SetUnitState(bj_lastCreatedUnit, ConvertUnitState(0x12), Xcalld(GetManipulatingUnit() , (LoadInteger(XGGetHeroMainAttr__htb, GetUnitTypeId((GetManipulatingUnit())), 0)) , true , 3.00)) // INLINED!!
    else
    endif
    if ( ( GetItemTypeId(GetManipulatedItem()) == 'I0IR' ) ) then
        call CreateNUnitsAtLoc(1, 'n04P', GetOwningPlayer(GetManipulatingUnit()), PolarProjectionBJ(GetUnitLoc(GetManipulatingUnit()), 100.00, GetUnitFacing(GetManipulatingUnit())), bj_UNIT_FACING)
        call SetUnitState(bj_lastCreatedUnit, ConvertUnitState(0x12), Xcalld(GetManipulatingUnit() , (LoadInteger(XGGetHeroMainAttr__htb, GetUnitTypeId((GetManipulatingUnit())), 0)) , true , 4.00)) // INLINED!!
    else
    endif
endfunction
