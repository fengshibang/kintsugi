//===========================================================================
// Trigger: 未命名触发器 130 复制 2
//===========================================================================
function Trig____________________130________2Actions takes nothing returns nothing
    if ( ( GetItemTypeId(GetManipulatedItem()) == 'I0BU' ) and ( IsUnitType(GetManipulatingUnit(), UNIT_TYPE_HERO) == true ) ) then
        call SetUnitPositionLocEx(GetManipulatingUnit() , GetRectCenterEx(gg_rct______________075))
        call PanCameraToTimedLocForPlayerEx(GetOwningPlayer(GetManipulatingUnit()) , GetRectCenterEx(gg_rct______________075) , 0.50)
    else
    endif
endfunction
