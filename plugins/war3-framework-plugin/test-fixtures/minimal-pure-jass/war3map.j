// Trigger: 未命名触发器 059
//===========================================================================
function Trig____________________059Actions takes nothing returns nothing
    if ( ( GetUnitTypeId(GetAttacker()) == 'n02W' ) ) then
        call DisableTrigger(GetTriggeringTrigger())
        call CreateTextTagUnitBJ("龙卷风潮！！！", GetAttacker(), 0, 20.00, 100.00, 0.00, 0.00, 0)
        call YDWETimerDestroyTextTag(2 , GetLastCreatedTextTag())
        call YDWEPolledWaitNull(1.00)
        call CreateNUnitsAtLoc(1, 'e00P', Player(4), GetUnitLoc(GetAttacker()), bj_UNIT_FACING)
        call IssuePointOrderLoc(bj_lastCreatedUnit, "stampede", GetUnitLoc(GetAttacker()))
        call YDWEPolledWaitNull(31.00)
        call EnableTrigger(GetTriggeringTrigger())
    else
    endif
    if ( ( GetUnitTypeId(GetAttacker()) == 'n01B' ) ) then
        call DisableTrigger(GetTriggeringTrigger())
        call CreateTextTagUnitBJ("无尽风暴！！！", GetAttacker(), 0, 20.00, 100.00, 0.00, 0.00, 0)
        call YDWETimerDestroyTextTag(3.00 , GetLastCreatedTextTag())
        call UnitAddAbility(GetAttacker(), 'A051')
        call IssuePointOrderLoc(GetAttacker(), "ward", GetUnitLoc(GetAttacker()))
        call YDWEPolledWaitNull(9.00)
        call UnitRemoveAbility(GetAttacker(), 'A051')
        call YDWEPolledWaitNull(11.00)
        call EnableTrigger(GetTriggeringTrigger())
    else
    endif
    if ( ( GetUnitTypeId(GetAttacker()) == 'n034' ) ) then
        call DisableTrigger(GetTriggeringTrigger())
        call CreateTextTagUnitBJ("召唤猫头鹰！！！", GetAttacker(), 0, 20.00, 100.00, 0.00, 0.00, 0)
        call YDWETimerDestroyTextTag(2 , GetLastCreatedTextTag())
        call YDWEPolledWaitNull(1.00)
        call CreateUnitAtLoc(Player(4), 'h01P', GetRandomLocInRect(gg_rct______________005), 0)
        call CreateUnitAtLoc(Player(4), 'h01P', GetRandomLocInRect(gg_rct______________005), 0)
        call CreateUnitAtLoc(Player(4), 'h01P', GetRandomLocInRect(gg_rct______________005), 0)
        call YDWEPolledWaitNull(10.00)
        call EnableTrigger(GetTriggeringTrigger())
    else
    endif
    if ( ( GetUnitTypeId(GetAttacker()) == 'n03E' ) ) then
        call DisableTrigger(GetTriggeringTrigger())
        call CreateTextTagUnitBJ("疾行之风！！！", GetAttacker(), 0, 20.00, 100.00, 0.00, 0.00, 0)
        call YDWETimerDestroyTextTag(2 , GetLastCreatedTextTag())
        call YDWEPolledWaitNull(1.00)
        call CreateNUnitsAtLocFacingLocBJ(1, 'h01Q', Player(4), PolarProjectionBJ(GetUnitLoc(GetAttacker()), 200.00, 0.00), GetUnitLoc(GetAttacker()))
        call CreateNUnitsAtLocFacingLocBJ(1, 'h01Q', Player(4), PolarProjectionBJ(GetUnitLoc(GetAttacker()), 200.00, 90.00), GetUnitLoc(GetAttacker()))
        call CreateNUnitsAtLocFacingLocBJ(1, 'h01Q', Player(4), PolarProjectionBJ(GetUnitLoc(GetAttacker()), 200.00, 180.00), GetUnitLoc(GetAttacker()))
        call CreateNUnitsAtLocFacingLocBJ(1, 'h01Q', Player(4), PolarProjectionBJ(GetUnitLoc(GetAttacker()), 200.00, 270.00), GetUnitLoc(GetAttacker()))
        call YDWEPolledWaitNull(9.00)
        call EnableTrigger(GetTriggeringTrigger())
    else
    endif
    if ( ( GetUnitTypeId(GetAttacker()) == 'n04G' ) ) then
        call DisableTrigger(GetTriggeringTrigger())
        call CreateTextTagUnitBJ("风来！！！", GetAttacker(), 0, 20.00, 100.00, 0.00, 0.00, 0)
        call YDWETimerDestroyTextTag(2 , GetLastCreatedTextTag())
        call YDWEPolledWaitNull(1.00)
        call CreateNUnitsAtLocFacingLocBJ(1, 'h01Q', Player(4), GetRectCenter(gg_rct______________018), GetUnitLoc(GetAttacker()))
        call CreateNUnitsAtLocFacingLocBJ(1, 'h01Q', Player(4), GetRectCenter(gg_rct______________019), GetUnitLoc(GetAttacker()))
        call CreateNUnitsAtLocFacingLocBJ(1, 'h01Q', Player(4), GetRectCenter(gg_rct______________020), GetUnitLoc(GetAttacker()))
        call CreateNUnitsAtLocFacingLocBJ(1, 'h01Q', Player(4), GetRectCenter(gg_rct______________021), GetUnitLoc(GetAttacker()))
        call YDWEPolledWaitNull(9.00)
        call EnableTrigger(GetTriggeringTrigger())
    else
    endif
endfunction
//===========================================================================
function InitTrig____________________059 takes nothing returns nothing
    set gg_trg____________________059=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg____________________059, EVENT_PLAYER_UNIT_ATTACKED)
    call TriggerAddAction(gg_trg____________________059, function Trig____________________059Actions)
endfunction
