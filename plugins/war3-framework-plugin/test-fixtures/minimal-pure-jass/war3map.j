//===========================================================================
// Trigger: 未命名触发器 036
//===========================================================================
function Trig____________________036Conditions takes nothing returns boolean
    return ( ( GetOwningPlayer(GetTriggerUnit()) == Player(4) ) )
endfunction
function Trig____________________036Actions takes nothing returns nothing
    if ( ( GetUnitAbilityLevel(GetEventDamageSource(), 'A0FV') >= 1 ) ) then
        call DisableTrigger(GetTriggeringTrigger())
        call SoAddUnitLife(GetEventDamageSource() , (((0 )*1.0) + ( GetUnitAbilityLevel(( GetEventDamageSource() ), ( 'A0FV' )) * (( 20.00)*1.0) ))) // INLINED!!
        call EnableTrigger(GetTriggeringTrigger())
    else
    endif
    if ( ( GetUnitAbilityLevel(GetEventDamageSource(), 'A005') >= 1 ) ) then
        if ( ( (GetRandomInt(1, 100)) <= 10 ) ) then // INLINED!!
            call DisableTrigger(GetTriggeringTrigger())
            call Xg_SDL(GetEventDamageSource() , GetTriggerUnit() , - 0.12 , 9 , Xcalld(GetEventDamageSource() , (LoadInteger(XGGetHeroMainAttr__htb, GetUnitTypeId((GetEventDamageSource())), 0)) , true , 1) , 600.00 , false , false , "CLPB" , "CLSB") // INLINED!!
            call EnableTrigger(GetTriggeringTrigger())
        else
        endif
    else
    endif
    if ( ( GetUnitAbilityLevel(GetEventDamageSource(), 'A004') >= 1 ) ) then
        call DisableTrigger(GetTriggeringTrigger())
        call ModifyHeroStat((LoadInteger(XGGetHeroMainAttr__htb, GetUnitTypeId((GetEventDamageSource())), 0)), GetEventDamageSource(), bj_MODIFYMETHOD_ADD, 1) // INLINED!!
        call EnableTrigger(GetTriggeringTrigger())
    else
    endif
    if ( ( GetUnitAbilityLevel(GetEventDamageSource(), 'A0SD') >= 1 ) ) then
        if ( ( (GetRandomInt(1, 100)) <= 10 ) ) then // INLINED!!
            call DisableTrigger(GetTriggeringTrigger())
            call Xg_SDL(GetEventDamageSource() , GetTriggerUnit() , - 0.12 , 9 , Xcalld(GetEventDamageSource() , (LoadInteger(XGGetHeroMainAttr__htb, GetUnitTypeId((GetEventDamageSource())), 0)) , true , 1) , 600.00 , false , false , "CLPB" , "CLSB") // INLINED!!
            call EnableTrigger(GetTriggeringTrigger())
        else
        endif
    else
    endif
endfunction
//===========================================================================
// [ECS_MIGRATED] InitTrig 函数 -- 036 穿刺/践踏/永久属性
// function InitTrig____________________036 takes nothing returns nothing
//     set gg_trg____________________036=CreateTrigger()
//     call YDWESyStemAnyUnitDamagedRegistTrigger(gg_trg____________________036)
//     call TriggerAddCondition(gg_trg____________________036, Condition(function Trig____________________036Conditions))
