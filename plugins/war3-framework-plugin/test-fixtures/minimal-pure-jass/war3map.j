//===========================================================================
// Trigger: 未命名触发器 254
//===========================================================================
function Trig____________________254Conditions takes nothing returns boolean
    return ( ( GetOwningPlayer(GetTriggerUnit()) == Player(4) ) )
endfunction
function Trig____________________254Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    if ( ( GetUnitAbilityLevel(GetEventDamageSource(), 'A0RI') >= 1 ) ) then
        call SoAddUnitState(GetEventDamageSource() , 3.00 , UNIT_STATE_MAX_LIFE)
        call SoAddUnitState(GetEventDamageSource() , 3.00 , UNIT_STATE_LIFE)
    else
    endif
    if ( ( GetUnitAbilityLevel(GetEventDamageSource(), 'A0RK') >= 1 ) ) then
        call SoAddUnitState(GetEventDamageSource() , 9.00 , UNIT_STATE_MAX_LIFE)
        call SoAddUnitState(GetEventDamageSource() , 9.00 , UNIT_STATE_LIFE)
    else
    endif
    if ( ( GetUnitAbilityLevel(GetEventDamageSource(), 'A0RM') >= 1 ) ) then
        call SoAddUnitState(GetEventDamageSource() , 15.00 , UNIT_STATE_MAX_LIFE)
        call SoAddUnitState(GetEventDamageSource() , 15.00 , UNIT_STATE_LIFE)
    else
    endif
    if ( ( GetUnitAbilityLevel(GetEventDamageSource(), 'A0RR') >= 1 ) ) then
        call SoAddUnitState(GetEventDamageSource() , 30.00 , UNIT_STATE_MAX_LIFE)
        call SoAddUnitState(GetEventDamageSource() , 30.00 , UNIT_STATE_LIFE)
    else
    endif
    if ( ( GetUnitAbilityLevel(GetEventDamageSource(), 'A0RT') >= 1 ) ) then
        call SoAddUnitState(GetEventDamageSource() , 60.00 , UNIT_STATE_MAX_LIFE)
        call SoAddUnitState(GetEventDamageSource() , 60.00 , UNIT_STATE_LIFE)
    else
    endif
    call EnableTrigger(GetTriggeringTrigger())
endfunction
