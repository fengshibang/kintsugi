//===========================================================================
// Trigger: 未命名触发器 030
//===========================================================================
function Trig____________________030Conditions takes nothing returns boolean
    return ( ( GetOwningPlayer(GetTriggerUnit()) == Player(4) ) )
endfunction
function Trig____________________030Actions takes nothing returns nothing
    if ( ( GetUnitAbilityLevel(GetEventDamageSource(), 'A00D') < 9 ) and ( GetUnitAbilityLevel(GetEventDamageSource(), 'A00D') >= 1 ) ) then
        if ( ( GetRandomInt(1, 100) <= 1 ) ) then
            call IncUnitAbilityLevel(GetEventDamageSource(), 'A00D')
            call DisplayTextToPlayer(GetOwningPlayer(GetEventDamageSource()), 0, 0, "英雄经过长时间的战斗，|cffff0000战争践踏|r等级提升了！！")
        else
        endif
    else
    endif
    if ( ( GetUnitAbilityLevel(GetEventDamageSource(), 'A0FV') < 9 ) and ( GetUnitAbilityLevel(GetEventDamageSource(), 'A0FV') >= 1 ) ) then
        if ( ( GetRandomInt(1, 100) <= 1 ) ) then
            call IncUnitAbilityLevel(GetEventDamageSource(), 'A0FV')
            call DisplayTextToPlayer(GetOwningPlayer(GetEventDamageSource()), 0, 0, "英雄经过长时间的战斗，|cffff0000攻击回血|r等级提升了！！")
        else
        endif
    else
    endif
    if ( ( GetUnitAbilityLevel(GetEventDamageSource(), 'A07K') < 9 ) and ( GetUnitAbilityLevel(GetEventDamageSource(), 'A07K') >= 1 ) ) then
        if ( ( GetRandomInt(1, 100) <= 1 ) ) then
            call IncUnitAbilityLevel(GetEventDamageSource(), 'A07K')
            call YDWEGeneralBounsSystemUnitSetBonus(GetEventDamageSource() , 3 , 0 , 50)
            call DisplayTextToPlayer(GetOwningPlayer(GetEventDamageSource()), 0, 0, "英雄经过长时间的战斗，|cffff0000霜冻攻击|r等级提升了！！")
        else
        endif
    else
    endif
    if ( ( GetUnitAbilityLevel(GetEventDamageSource(), 'A02W') < 10 ) and ( GetUnitAbilityLevel(GetEventDamageSource(), 'A02W') >= 1 ) ) then
        if ( ( GetRandomInt(1, 100) <= 1 ) ) then
            call IncUnitAbilityLevel(GetEventDamageSource(), 'A02W')
            call DisplayTextToPlayer(GetOwningPlayer(GetEventDamageSource()), 0, 0, "英雄经过长时间的战斗，|cffff0000浸毒武器|r等级提升了！！")
        else
        endif
    else
    endif
endfunction
//===========================================================================
function InitTrig____________________030 takes nothing returns nothing
    set gg_trg____________________030=CreateTrigger()
    call YDWESyStemAnyUnitDamagedRegistTrigger(gg_trg____________________030)
    call TriggerAddCondition(gg_trg____________________030, Condition(function Trig____________________030Conditions))
    call TriggerAddAction(gg_trg____________________030, function Trig____________________030Actions)
endfunction
