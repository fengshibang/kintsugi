// [ECS_MIGRATED] 266______________u InitTrig - migrated to ECS
function InitTrig____________________266______________u takes nothing returns nothing
    set gg_trg____________________266______________u=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg____________________266______________u, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddAction(gg_trg____________________266______________u, function Trig____________________266______________uActions)
endfunction
