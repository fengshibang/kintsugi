// Trigger: 未命名触发器 266 复制 复制
//===========================================================================
function Trig____________________266______________uFunc001Func006001002 takes nothing returns boolean
    return ( ( IsUnitType(GetFilterUnit(), UNIT_TYPE_HERO) == false ) )
endfunction
function Trig____________________266______________uFunc001Func006A takes nothing returns nothing
    call KillUnit(GetEnumUnit())
endfunction
function Trig____________________266______________uFunc002Func006001002 takes nothing returns boolean
    return ( ( IsUnitType(GetFilterUnit(), UNIT_TYPE_HERO) == false ) )
endfunction
function Trig____________________266______________uFunc002Func006A takes nothing returns nothing
    call KillUnit(GetEnumUnit())
endfunction
// [ECS_MIGRATED] 266______________u Actions - migrated to ECS
function Trig____________________266______________uActions takes nothing returns nothing
    local group ydl_group
    local unit ydl_unit
    if ( ( GetUnitTypeId(GetDyingUnit()) == 'N06I' ) ) then
        call YDWERPGAddKey(Player(0) , "zuanshi" , 1)
        call YDWERPGAddKey(Player(1) , "zuanshi" , 1)
        call YDWERPGAddKey(Player(2) , "zuanshi" , 1)
        call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_UPDATED, "钻石积分+1

清除场上单位！！")
        call ForGroupBJ(YDWEGetUnitsInRectMatchingNull(gg_rct______________117 , Condition(function Trig____________________266______________uFunc001Func006001002)), function Trig____________________266______________uFunc001Func006A)
        call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_UPDATED, "倒计时 3")
        call YDWEPolledWaitNull(1.00)
        call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_UPDATED, "倒计时 2")
        call YDWEPolledWaitNull(1.00)
        call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_UPDATED, "倒计时 1")
        call YDWEPolledWaitNull(1.00)
        call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_UPDATED, "无尽第六关开始！！！")
        call CreateUnitAtLoc(Player(4), 'N06H', GetRectCenter(gg_rct______________009), 0)
    else
    endif
    if ( ( GetUnitTypeId(GetDyingUnit()) == 'N06H' ) ) then
        call YDWERPGAddKey(Player(0) , "dashi" , 1)
        call YDWERPGAddKey(Player(1) , "dashi" , 1)
        call YDWERPGAddKey(Player(2) , "dashi" , 1)
        call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_UPDATED, "大师积分+1

清除场上单位！！")
        call ForGroupBJ(YDWEGetUnitsInRectMatchingNull(gg_rct______________117 , Condition(function Trig____________________266______________uFunc002Func006001002)), function Trig____________________266______________uFunc002Func006A)
        call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_UPDATED, "倒计时 3")
        call YDWEPolledWaitNull(1.00)
        call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_UPDATED, "倒计时 2")
        call YDWEPolledWaitNull(1.00)
        call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_UPDATED, "倒计时 1")
        call YDWEPolledWaitNull(1.00)
        call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_UPDATED, "无尽第七关开始！！！")
        call CreateUnitAtLoc(Player(4), 'N06G', GetRectCenter(gg_rct______________009), 0)
    else
    endif
    if ( ( GetUnitTypeId(GetDyingUnit()) == 'N06G' ) ) then
        call YDWERPGAddKey(Player(0) , "wangzhe" , 1)
        call YDWERPGAddKey(Player(1) , "wangzhe" , 1)
        call YDWERPGAddKey(Player(2) , "wangzhe" , 1)
        call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_UPDATED, "王者积分+1

清除场上单位！！")
    else
    endif
    set ydl_group=null
    set ydl_unit=null
endfunction
// [END_ECS_MIGRATED]
