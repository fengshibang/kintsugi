function ZEROZAG26A takes nothing returns nothing
   
    local timer j= GetExpiredTimer()
    local integer z= GetHandleId(j)
    
    local unit d1= LoadUnitHandle(YDHT, z, 1)
    local unit dan= LoadUnitHandle(YDHT, z, 2)
    call SetUnitPosition(dan, ( GetUnitX(d1) + 15.00 ), ( GetUnitY(d1) + 0 ))
    call SetUnitAnimationByIndex(dan, R2I(GetUnitLifePercent(d1)))
    if ( ( IsUnitDeadBJ(d1) == true ) ) then
    call KillUnit(dan)
    call SaveBoolean(YDHT, GetHandleId(d1), 0x37FDCE3D, false)
    call FlushChildHashtable(YDHT, z)
    call PauseTimer(j)
    call DestroyTimer(j)
    else
    endif
    set j=null
    
endfunction
function ZEROZAG26 takes unit d1,integer z1 returns nothing
    local real s
    local timer j= CreateTimer()
    local unit dan
       if ( ( LoadBoolean(YDHT, GetHandleId(d1), 0x37FDCE3D) == false ) ) then
       set dan=CreateUnit(GetOwningPlayer(d1), z1, GetUnitX(d1), GetUnitY(d1), 0)
    set s=( 3.00 * GetUnitTurnSpeed(d1) )
    call SetUnitScale(dan, s, s, s)
    set s=( 350.00 * GetUnitTurnSpeed(d1) ) + GetUnitFlyHeight(d1)
    call SetUnitFlyHeight(dan, s, 100000.00)
    call SaveBoolean(YDHT, GetHandleId(d1), 0x37FDCE3D, true)
    // 123
    call SaveUnitHandle(YDHT, GetHandleId(j), 1, d1)
    call SaveUnitHandle(YDHT, GetHandleId(j), 2, dan)
    call TimerStart(j, 0.03, true, function ZEROZAG26A)
    else
    endif
    
    set j=null
endfunction
function ZEROZAG25 takes integer z1,integer z2 returns integer
local integer z= z1
local integer b1= 1
local integer b2= z2 - 1
    if ( b2 == 0 ) then
    else
    loop
        exitwhen b1 > b2
        set z=( z * 2 )
        set b1=b1 + 1
    endloop
    endif
return z
endfunction
