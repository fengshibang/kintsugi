//library XGbase:
 function InitXG takes nothing returns nothing
		// call TimerStart(CreateTimer(), 30.00, false, function Show_WE_Info)
		set XG_Map_Loc[1]=GetCameraBoundMinX() - GetCameraMargin(CAMERA_MARGIN_LEFT) //MinX
        set XG_Map_Loc[2]=GetCameraBoundMinY() - GetCameraMargin(CAMERA_MARGIN_BOTTOM) //MinY
        set XG_Map_Loc[3]=GetCameraBoundMaxX() + GetCameraMargin(CAMERA_MARGIN_RIGHT) //MaxX
        set XG_Map_Loc[4]=GetCameraBoundMaxY() + GetCameraMargin(CAMERA_MARGIN_TOP) //MaxY
endfunction

//library XGbase ends
//library Xcall:
	
	//��λ���ԡ�ʵ��
 function Xcallf takes unit u,unitstate l,real s returns real
		return ( GetUnitState(u, l) * s )
	endfunction
	//�жϵ�λ��Ŀ������
 function Xcallg takes unit gj,unit ad returns boolean
  local boolean z
		if ( ( CosBJ(( ( GetUnitFacing(ad) ) - ( bj_RADTODEG * Atan2(GetUnitY(ad) - GetUnitY(gj), GetUnitX(ad) - GetUnitX(gj)) ) )) >= 0.50 ) ) then
			set z=true
		else
			set z=false
		endif
		return z
	endfunction
	//�жϵ�λ��Ŀ����ǰ
 function Xcallh takes unit gj,unit ad returns boolean
  local boolean z
		if ( ( CosBJ(( ( GetUnitFacing(ad) ) - ( bj_RADTODEG * Atan2(GetUnitY(ad) - GetUnitY(gj), GetUnitX(ad) - GetUnitX(gj)) ) )) <= - 0.50 ) ) then
			set z=true
		else
		set z=false
		endif
		return z
	endfunction
	//Ӣ�����ԡ�ʵ��
 function Xcalld takes unit u,integer s,boolean b,real ss returns real
		return ( I2R(GetHeroStatBJ(s, u, b)) * ss )
	endfunction 
	//��λ�ȼ���ʵ��
 function Xcalle takes unit u,real i returns real
		return ( I2R(GetUnitLevel(u)) * i )
	endfunction
	//���ʵ��
 function Xcallb takes nothing returns real
		return GetRandomReal(0, 100.00)
	endfunction
	//�������
 function Xcallc takes nothing returns integer
		return GetRandomInt(1, 100)
	endfunction
	//ȡֵ
 function Xcalla takes integer a,integer b returns boolean
                //AС��B�򷵻ؼ�
		if ( a < b ) then
			return false
		else
		endif
                //A����B�򷵻���
		if ( ( a > b ) ) then
			return true
		else
		endif
                //����������������A����B �������������߼�
		if ( ( GetRandomInt(1, 2) == 1 ) ) then
			return true
		else
			return false
		endif
  endfunction

//library Xcall ends
//library XwZswpsjWpCs:
 function Xwei_GetItemOfTypeFromUnitBJNull takes unit whichUnit,integer itemId returns item
     local integer index= 0
    	loop
    	    set Xwei_NullTempItem=UnitItemInSlot(whichUnit, index)
    	    if GetItemTypeId(Xwei_NullTempItem) == itemId then
    	        return Xwei_NullTempItem
    	    endif
    	    set index=index + 1
    	    exitwhen index >= bj_MAX_INVENTORY
    	endloop
    	return null
	endfunction
 function XweiUI_UnitHasItemOfTypeBJNull takes unit whichUnit,integer itemId returns boolean
     local integer index= 0
		if itemId != 0 then
			loop
				if GetItemTypeId(UnitItemInSlot(whichUnit, index)) == itemId then
					return true
				endif
				set index=index + 1
				exitwhen index >= bj_MAX_INVENTORY
			endloop
		endif
	    return false
	endfunction
 function Xw_Zswpsj_WpCs takes unit Jlunit,integer Before,integer After_the,integer SDX,string XsWb returns nothing
		if XweiUI_UnitHasItemOfTypeBJNull(Jlunit , Before) == true then
			call SetItemCharges(Xwei_GetItemOfTypeFromUnitBJNull(Jlunit , Before), ( GetItemCharges(Xwei_GetItemOfTypeFromUnitBJNull(Jlunit , Before)) + 1 ))
			if GetItemCharges(Xwei_GetItemOfTypeFromUnitBJNull(Jlunit , Before)) == SDX then
				call RemoveItem(Xwei_GetItemOfTypeFromUnitBJNull(Jlunit , Before))
				call UnitAddItemByIdSwapped(After_the, Jlunit)
				if XsWb != "" then
					call DisplayTextToPlayer(GetOwningPlayer(Jlunit), 0, 0, XsWb)
				endif
			endif
			return
	    endif
	endfunction

//library XwZswpsjWpCs ends
//library YDTriggerSaveLoadSystem:
    function YDTriggerSaveLoadSystem__Init takes nothing returns nothing
            set YDHT=InitHashtable()
        set YDLOC=InitHashtable()
    endfunction

//library YDTriggerSaveLoadSystem ends
//library YDWEBase:
//===========================================================================
//HashTable
//===========================================================================
//===========================================================================
//Return bug
//===========================================================================
function YDWEH2I takes handle h returns integer
    return GetHandleId(h)
endfunction
//����
function YDWEFlushAllData takes nothing returns nothing
    call FlushParentHashtable(YDHT)
endfunction
function YDWEFlushMissionByInteger takes integer i returns nothing
    call FlushChildHashtable(YDHT, i)
endfunction
function YDWEFlushMissionByString takes string s returns nothing
    call FlushChildHashtable(YDHT, StringHash(s))
endfunction
function YDWEFlushStoredIntegerByInteger takes integer i,integer j returns nothing
    call RemoveSavedInteger(YDHT, i, j)
endfunction
function YDWEFlushStoredIntegerByString takes string s1,string s2 returns nothing
