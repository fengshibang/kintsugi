// Trigger: 未命名触发器 088
//===========================================================================
function Trig____________________088Conditions takes nothing returns boolean
    return ( ( GetOwningPlayer(GetTriggerUnit()) == Player(4) ) )
endfunction
function Trig____________________088Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    if ( ( YDWEUnitHasItemOfTypeBJNull(GetEventDamageSource() , 'I05S') == true ) ) then
        if ( ( (GetRandomInt(1, 100)) <= 10 ) ) then // INLINED!!
            call ModifyHeroStat((LoadInteger(XGGetHeroMainAttr__htb, GetUnitTypeId((GetEventDamageSource())), 0)), GetEventDamageSource(), bj_MODIFYMETHOD_ADD, 1) // INLINED!!
        else
        endif
    else
    endif
    if ( ( YDWEUnitHasItemOfTypeBJNull(GetEventDamageSource() , 'I05T') == true ) ) then
        if ( ( (GetRandomInt(1, 100)) <= 20 ) ) then // INLINED!!
            call ModifyHeroStat((LoadInteger(XGGetHeroMainAttr__htb, GetUnitTypeId((GetEventDamageSource())), 0)), GetEventDamageSource(), bj_MODIFYMETHOD_ADD, 1) // INLINED!!
        else
        endif
    else
    endif
    if ( ( YDWEUnitHasItemOfTypeBJNull(GetEventDamageSource() , 'I05U') == true ) ) then
        if ( ( (GetRandomInt(1, 100)) <= 30 ) ) then // INLINED!!
            call ModifyHeroStat((LoadInteger(XGGetHeroMainAttr__htb, GetUnitTypeId((GetEventDamageSource())), 0)), GetEventDamageSource(), bj_MODIFYMETHOD_ADD, 1) // INLINED!!
        else
        endif
    else
    endif
    if ( ( YDWEUnitHasItemOfTypeBJNull(GetEventDamageSource() , 'I05V') == true ) ) then
        if ( ( (GetRandomInt(1, 100)) <= 40 ) ) then // INLINED!!
            call ModifyHeroStat((LoadInteger(XGGetHeroMainAttr__htb, GetUnitTypeId((GetEventDamageSource())), 0)), GetEventDamageSource(), bj_MODIFYMETHOD_ADD, 1) // INLINED!!
        else
        endif
    else
    endif
    if ( ( YDWEUnitHasItemOfTypeBJNull(GetEventDamageSource() , 'I05W') == true ) ) then
        if ( ( (GetRandomInt(1, 100)) <= 50 ) ) then // INLINED!!
            call ModifyHeroStat((LoadInteger(XGGetHeroMainAttr__htb, GetUnitTypeId((GetEventDamageSource())), 0)), GetEventDamageSource(), bj_MODIFYMETHOD_ADD, 1) // INLINED!!
        else
        endif
    else
    endif
    call EnableTrigger(GetTriggeringTrigger())
endfunction
//===========================================================================
function InitTrig____________________088 takes nothing returns nothing
    set gg_trg____________________088=CreateTrigger()
    call YDWESyStemAnyUnitDamagedRegistTrigger(gg_trg____________________088)
    call TriggerAddCondition(gg_trg____________________088, Condition(function Trig____________________088Conditions))
    call TriggerAddAction(gg_trg____________________088, function Trig____________________088Actions)
endfunction
