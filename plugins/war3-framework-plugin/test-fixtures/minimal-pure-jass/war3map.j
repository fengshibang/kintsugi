//===========================================================================
// Trigger: 未命名触发器 193
//===========================================================================
function Trig____________________193Conditions takes nothing returns boolean
    return ( ( GetOwningPlayer(GetTriggerUnit()) == Player(4) ) )
endfunction
function Trig____________________193Actions takes nothing returns nothing
    call Xw_Zswpsj_WpCs(GetEventDamageSource() , 'I0CS' , 'I0CR' , 30 , "练气修行大成，当前修行：筑基篇！")
    call Xw_Zswpsj_WpCs(GetEventDamageSource() , 'I0CR' , 'I0CQ' , 30 , "筑基修行大成，当前修行：金丹篇！")
    call Xw_Zswpsj_WpCs(GetEventDamageSource() , 'I0CQ' , 'I0CN' , 30 , "金丹修行大成，当前修行：元婴篇！")
    call Xw_Zswpsj_WpCs(GetEventDamageSource() , 'I0CN' , 'I0CT' , 30 , "元婴修行大成，当前修行：化神篇！")
    call Xw_Zswpsj_WpCs(GetEventDamageSource() , 'I0CT' , 'I0CM' , 30 , "化神修行大成，当前修行：返虚篇！")
endfunction
//===========================================================================
function InitTrig____________________193 takes nothing returns nothing
    set gg_trg____________________193=CreateTrigger()
    call YDWESyStemAnyUnitDamagedRegistTrigger(gg_trg____________________193)
    call TriggerAddCondition(gg_trg____________________193, Condition(function Trig____________________193Conditions))
    call TriggerAddAction(gg_trg____________________193, function Trig____________________193Actions)
endfunction
//===========================================================================
// Trigger: 未命名触发器 193 复制
//===========================================================================
function Trig____________________193_______uConditions takes nothing returns boolean
    return ( ( GetOwningPlayer(GetTriggerUnit()) == Player(4) ) )
endfunction
function Trig____________________193_______uActions takes nothing returns nothing
    call Xw_Zswpsj_WpCs(GetEventDamageSource() , 'I0CM' , 'I0CL' , 30 , "返虚修行大成，当前修行：合体篇！")
    call Xw_Zswpsj_WpCs(GetEventDamageSource() , 'I0CL' , 'I0CO' , 30 , "合体修行大成，当前修行：渡劫篇！")
    call Xw_Zswpsj_WpCs(GetEventDamageSource() , 'I0CO' , 'I0CK' , 30 , "渡劫修行大成，当前修行：大乘篇！")
    call Xw_Zswpsj_WpCs(GetEventDamageSource() , 'I0CK' , 'I0CP' , 30 , "合成 |cffff0000仙人转职证明|r")
endfunction
//===========================================================================
function InitTrig____________________193_______u takes nothing returns nothing
    set gg_trg____________________193_______u=CreateTrigger()
    call YDWESyStemAnyUnitDamagedRegistTrigger(gg_trg____________________193_______u)
    call TriggerAddCondition(gg_trg____________________193_______u, Condition(function Trig____________________193_______uConditions))
    call TriggerAddAction(gg_trg____________________193_______u, function Trig____________________193_______uActions)
endfunction
