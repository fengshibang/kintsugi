    if ( ( GetItemTypeId(GetManipulatedItem()) == 'I0N1' ) ) then
        call UnitAddItemByIdSwapped(GetItemTypeId(UnitItemInSlotBJ(GetManipulatingUnit(), 1)), GetManipulatingUnit())
