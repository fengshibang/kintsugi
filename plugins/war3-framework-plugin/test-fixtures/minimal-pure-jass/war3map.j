//library LocToLocEx:
    function LocToLocEx___s__LocEx__allocate takes nothing returns integer
        local integer this=LocToLocEx___si__LocEx_F
            if ( this != 0 ) then
                set LocToLocEx___si__LocEx_F=LocToLocEx___si__LocEx_V[this]
            else
                set LocToLocEx___si__LocEx_I=LocToLocEx___si__LocEx_I + 1
                set this=LocToLocEx___si__LocEx_I
            endif
            if ( this > 8190 ) then
                return 0
            endif
            set LocToLocEx___si__LocEx_V[this]=- 1
        return this
    endfunction
    function LocToLocEx___s__LocEx_deallocate takes integer this returns nothing
        if this == null then
            return
        elseif ( LocToLocEx___si__LocEx_V[this] != - 1 ) then
            return
        endif
        set LocToLocEx___si__LocEx_V[this]=LocToLocEx___si__LocEx_F
        set LocToLocEx___si__LocEx_F=this
    endfunction
    function LocToLocEx___s__LocEx_create takes real x,real y returns integer
        local integer l=LocToLocEx___s__LocEx__allocate()
        set LocToLocEx___s__LocEx_x[l]=x
        set LocToLocEx___s__LocEx_y[l]=y
        return l
    endfunction
    function LocEx2Integer takes integer i returns integer
        return i
    endfunction
    function Integer2LocEx takes integer i returns integer
        return i
    endfunction
    function GetUnitLocEx takes unit u returns integer
        return LocToLocEx___s__LocEx_create(GetUnitX(u) , GetUnitY(u))
    endfunction
    function GetDestructableLocEx takes destructable whichDestructable returns integer
        return LocToLocEx___s__LocEx_create(GetDestructableX(whichDestructable) , GetDestructableY(whichDestructable))
    endfunction
    function GetOrderPointLocEx takes nothing returns integer
        return LocToLocEx___s__LocEx_create(GetOrderPointX() , GetOrderPointY())
    endfunction
    function GetPlayerStartLocationLocEx takes player whichPlayer returns integer
        return LocToLocEx___s__LocEx_create(GetStartLocationX(GetPlayerStartLocation(whichPlayer)) , GetStartLocationY(GetPlayerStartLocation(whichPlayer)))
    endfunction
    function GetItemLocEx takes item whichItem returns integer
        return LocToLocEx___s__LocEx_create(GetItemX(whichItem) , GetItemY(whichItem))
    endfunction
    function WaygateGetDestinationLocBJEx takes unit waygate returns integer
        return LocToLocEx___s__LocEx_create(WaygateGetDestinationX(waygate) , WaygateGetDestinationY(waygate))
    endfunction
    function GetUnitRallyPointEx takes unit u returns integer
        local location l=GetUnitRallyPoint(u)
        local real x=GetLocationX(l)
        local real y=GetLocationY(l)
        call RemoveLocation(l)
        set l=null
        return LocToLocEx___s__LocEx_create(x , y)
    endfunction
    function GetRectCenterEx takes rect r returns integer
        return LocToLocEx___s__LocEx_create(GetRectCenterX(r) , GetRectCenterY(r))
    endfunction
    function GetRandomLocInRectEx takes rect r returns integer
        return LocToLocEx___s__LocEx_create(GetRandomReal(GetRectMinX(r), GetRectMaxX(r)) , GetRandomReal(GetRectMinY(r), GetRectMaxY(r)))
    endfunction
    function PolarProjectionBJEx takes integer l,real dist,real angle returns integer
        local real x=LocToLocEx___s__LocEx_x[l] + dist * Cos(angle * bj_DEGTORAD)
        local real y=LocToLocEx___s__LocEx_y[l] + dist * Sin(angle * bj_DEGTORAD)
        call LocToLocEx___s__LocEx_deallocate(l)
        return LocToLocEx___s__LocEx_create(x , y)
    endfunction
    function CameraSetupGetDestPositionLocEx takes camerasetup whichSetup returns integer
        return LocToLocEx___s__LocEx_create(CameraSetupGetDestPositionX(whichSetup) , CameraSetupGetDestPositionY(whichSetup))
    endfunction
    function GetSpellTargetLocEx takes nothing returns integer
        return LocToLocEx___s__LocEx_create(GetSpellTargetX() , GetSpellTargetY())
    endfunction
    function SetUnitPositionLocEx takes unit u,integer l returns nothing
        call SetUnitPosition(u, LocToLocEx___s__LocEx_x[l], LocToLocEx___s__LocEx_y[l])
        call LocToLocEx___s__LocEx_deallocate(l)
    endfunction
    function SetUnitXYEx takes unit u,integer l returns nothing
        call SetUnitX(u, LocToLocEx___s__LocEx_x[l])
        call SetUnitY(u, LocToLocEx___s__LocEx_y[l])
        call LocToLocEx___s__LocEx_deallocate(l)
    endfunction
    function CreateNUnitsAtLocEx takes integer count,integer unitid,player whichPlayer,integer loc,real face returns group
        call GroupClear(bj_lastCreatedGroup)
        loop
            set count=count - 1
            exitwhen count < 0
            if ( unitid == 'ugol' ) then
                set bj_lastCreatedUnit=CreateBlightedGoldmine(whichPlayer, LocToLocEx___s__LocEx_x[loc], LocToLocEx___s__LocEx_y[loc], face)
            else
                set bj_lastCreatedUnit=CreateUnit(whichPlayer, unitid, LocToLocEx___s__LocEx_x[loc], LocToLocEx___s__LocEx_y[loc], face)
            endif
            call GroupAddUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop
        call LocToLocEx___s__LocEx_deallocate(loc)
        return bj_lastCreatedGroup
    endfunction
    function AngleBetweenPointsEx takes integer locA,integer locB returns real
        local real y=LocToLocEx___s__LocEx_y[locB] - LocToLocEx___s__LocEx_y[locA]
        local real x=LocToLocEx___s__LocEx_x[locB] - LocToLocEx___s__LocEx_x[locA]
        call LocToLocEx___s__LocEx_deallocate(locB)
        call LocToLocEx___s__LocEx_deallocate(locA)
        return bj_RADTODEG * Atan2(y, x)
    endfunction
    function CreateCorpseLocBJEx takes integer unitid,player p,integer loc returns unit
        set bj_lastCreatedUnit=CreateCorpse(p, unitid, LocToLocEx___s__LocEx_x[loc], LocToLocEx___s__LocEx_y[loc], GetRandomReal(0, 360))
        call LocToLocEx___s__LocEx_deallocate(loc)
        return bj_lastCreatedUnit
    endfunction
    function IssuePointOrderLocEx takes unit u,string s,integer l returns nothing
        call IssuePointOrder(u, s, LocToLocEx___s__LocEx_x[l], LocToLocEx___s__LocEx_y[l])
        call LocToLocEx___s__LocEx_deallocate(l)
    endfunction
    function GetLocationZEx takes integer loc returns real
        local location l=Location(LocToLocEx___s__LocEx_x[loc], LocToLocEx___s__LocEx_y[loc])
        local real z=GetLocationZ(l)
        call RemoveLocation(l)
        set l=null
        call LocToLocEx___s__LocEx_deallocate(loc)
        return z
    endfunction
    function PanCameraToTimedLocForPlayerEx takes player p,integer loc,real d returns nothing
        if ( GetLocalPlayer() == p ) then
            call PanCameraToTimed(LocToLocEx___s__LocEx_x[loc], LocToLocEx___s__LocEx_y[loc], d)
        endif
        call LocToLocEx___s__LocEx_deallocate(loc)
    endfunction
    function CreateItemLocEx takes integer itemId,integer loc returns item
        set bj_lastCreatedItem=CreateItem(itemId, LocToLocEx___s__LocEx_x[loc], LocToLocEx___s__LocEx_y[loc])
        call LocToLocEx___s__LocEx_deallocate(loc)
        return bj_lastCreatedItem
    endfunction
    function SetItemPositionLocEx takes item whichItem,integer loc returns nothing
        call SetItemPosition(whichItem, LocToLocEx___s__LocEx_x[loc], LocToLocEx___s__LocEx_y[loc])
        call LocToLocEx___s__LocEx_deallocate(loc)
    endfunction
    function ReviveHeroLocEx takes unit u,integer l,boolean b returns nothing
        call ReviveHero(u, LocToLocEx___s__LocEx_x[l], LocToLocEx___s__LocEx_y[l], b)
        call LocToLocEx___s__LocEx_deallocate(l)
    endfunction
    function AddSpecialEffectLocBJEx takes integer where,string modelName returns nothing
	    call DestroyEffect(AddSpecialEffect(modelName, LocToLocEx___s__LocEx_x[where], LocToLocEx___s__LocEx_y[where]))
	    call LocToLocEx___s__LocEx_deallocate(where)
	endfunction

//library LocToLocEx ends
//library SoBaseL:
		
	//坐标间距 
 function SoSpacing takes real x1,real y1,real x2,real y2 returns real
     local real fx= x2 - x1
     local real fy= y2 - y1
    	return SquareRoot(fx * fx + fy * fy)
	endfunction
	//坐标间方向
 function SoC2A takes real x1,real y1,real x2,real y2 returns real
    	return bj_RADTODEG * Atan2(y2 - y1, x2 - x1)
	endfunction
    function SoBaseL___SRabs takes real a returns real
        if ( a < 0 ) then
            return - a
        else
            return a
        endif
    endfunction
    //三点所在的矩形面积
    function SoGetRectAera takes real xa,real ya,real xb,real yb,real xc,real yc returns real
        return SoBaseL___SRabs(xa * yb - xa * yc + xb * yc - xb * ya + xc * ya - xc * yb)
    endfunction
    //单位技能等级
    function SoGetUnitAbilityRealLevel takes unit WhichUnit,integer aid returns real
        return I2R(GetUnitAbilityLevel(WhichUnit, aid))
    endfunction
    //英雄属性
    function SoGetHeroRealState takes unit WhichUnit,integer HowState,boolean ttf returns real
        return I2R(GetHeroStatBJ(HowState, WhichUnit, ttf))
    endfunction
    //单位属性(返回整数)
    function SoGetUnitIntState takes unit WhichUnit,unitstate us returns integer
        return R2I(GetUnitState(WhichUnit, us))
    endfunction
	//设置单位坐标
 function SoSetUnitXY takes unit u,real Howx,real Howy returns nothing
  local real x= Howx
  local real y= Howy
    	if IsTerrainPathable(x, y, PATHING_TYPE_ANY) == true then
    		if x < GetRectMinX(GetWorldBounds()) then
    			set x=GetRectMinX(GetWorldBounds())
    		elseif x > GetRectMaxX(GetWorldBounds()) then
    			set x=GetRectMaxX(GetWorldBounds())
    		endif
    		if y < GetRectMinY(GetWorldBounds()) then
    			set y=GetRectMinY(GetWorldBounds())
    		elseif y > GetRectMaxY(GetWorldBounds()) then
    			set y=GetRectMaxY(GetWorldBounds())
    		endif
        	call SetUnitX(u, x)
        	call SetUnitY(u, y)
    	endif
	endfunction
	//位移单位(角度)
 function SoMoveUnitForAngle takes unit WhichUnit,real an,real skpu returns nothing
     local unit u= WhichUnit
     local real x= GetUnitX(u) + CosBJ(an) * skpu
     local real y= GetUnitY(u) + SinBJ(an) * skpu
    	if ( x > GetRectMaxX(GetWorldBounds()) ) then
        	set x=GetRectMaxX(GetWorldBounds())
    	endif
    	if ( x < GetRectMinX(GetWorldBounds()) ) then
        	set x=GetRectMinX(GetWorldBounds())
    	endif
    	if ( y > GetRectMaxY(GetWorldBounds()) ) then
        	set y=GetRectMaxY(GetWorldBounds())
    	endif
   		if ( y < GetRectMinY(GetWorldBounds()) ) then
        	set y=GetRectMinY(GetWorldBounds())
    	endif
    	call SetUnitX(u, x)
    	call SetUnitY(u, y)
    	set u=null
	endfunction
	//位移点(角度)
 function SoMoveLocForAngle takes location WhichLoc,real skpu,real an returns nothing
     local location l= WhichLoc
     local real x= GetLocationX(l) + CosBJ(an) * skpu
     local real y= GetLocationY(l) + SinBJ(an) * skpu
    	if ( x > GetRectMaxX(GetWorldBounds()) ) then
        	set x=GetRectMaxX(GetWorldBounds())
    	endif
    	if ( x < GetRectMinX(GetWorldBounds()) ) then
        	set x=GetRectMinX(GetWorldBounds())
    	endif
    	if ( y > GetRectMaxY(GetWorldBounds()) ) then
        	set y=GetRectMaxY(GetWorldBounds())
    	endif
    	if ( y < GetRectMinY(GetWorldBounds()) ) then
        	set y=GetRectMinY(GetWorldBounds())
    	endif
    	call MoveLocation(l, x, y)
    	set l=null
	endfunction
	//显示特效
	//不能显示延时特效
 function SoShowEffect takes string tx,real x,real y returns nothing
    	call DestroyEffect(AddSpecialEffect(tx, x, y))
	endfunction
	//物品分类转换表
 function SoGetItemTypeForVal takes integer nve returns itemtype
    	if ( nve == SoBaseL___Itemtype_SouL_RenHe ) then
        	set SoBaseL___ITEM_TYPE_CBACK=ITEM_TYPE_ANY
    	elseif ( nve == SoBaseL___Itemtype_SouL_YongJiu ) then
        	set SoBaseL___ITEM_TYPE_CBACK=ITEM_TYPE_PERMANENT
   	 	elseif ( nve == SoBaseL___Itemtype_SouL_KeChong ) then
        	set SoBaseL___ITEM_TYPE_CBACK=ITEM_TYPE_CHARGED
    	elseif ( nve == SoBaseL___Itemtype_SouL_NengLiangTiSheng ) then
        	set SoBaseL___ITEM_TYPE_CBACK=ITEM_TYPE_POWERUP
    	elseif ( nve == SoBaseL___Itemtype_SouL_RenZao ) then
        	set SoBaseL___ITEM_TYPE_CBACK=ITEM_TYPE_ARTIFACT
    	elseif ( nve == SoBaseL___Itemtype_SouL_KeGouMai ) then
        	set SoBaseL___ITEM_TYPE_CBACK=ITEM_TYPE_PURCHASABLE
    	elseif ( nve == SoBaseL___Itemtype_SouL_ZhanYi ) then
        	set SoBaseL___ITEM_TYPE_CBACK=ITEM_TYPE_CAMPAIGN
    	elseif ( nve == SoBaseL___Itemtype_SouL_HunZa ) then
        	set SoBaseL___ITEM_TYPE_CBACK=ITEM_TYPE_MISCELLANEOUS
    	endif
    	return SoBaseL___ITEM_TYPE_CBACK
	endfunction
 function SoGetValForItemType takes itemtype nve returns integer
    	if ( nve == ITEM_TYPE_ANY ) then
        	set SoBaseL___ITEM_TYPE_VBACK=SoBaseL___Itemtype_SouL_RenHe
    	elseif ( nve == ITEM_TYPE_PERMANENT ) then
        	set SoBaseL___ITEM_TYPE_VBACK=SoBaseL___Itemtype_SouL_YongJiu
    	elseif ( nve == ITEM_TYPE_CHARGED ) then
        	set SoBaseL___ITEM_TYPE_VBACK=SoBaseL___Itemtype_SouL_KeChong
    	elseif ( nve == ITEM_TYPE_POWERUP ) then
        	set SoBaseL___ITEM_TYPE_VBACK=SoBaseL___Itemtype_SouL_NengLiangTiSheng
    	elseif ( nve == ITEM_TYPE_ARTIFACT ) then
        	set SoBaseL___ITEM_TYPE_VBACK=SoBaseL___Itemtype_SouL_RenZao
    	elseif ( nve == ITEM_TYPE_PURCHASABLE ) then
        	set SoBaseL___ITEM_TYPE_VBACK=SoBaseL___Itemtype_SouL_KeGouMai
    	elseif ( nve == ITEM_TYPE_CAMPAIGN ) then
        	set SoBaseL___ITEM_TYPE_VBACK=SoBaseL___Itemtype_SouL_ZhanYi
    	elseif ( nve == ITEM_TYPE_MISCELLANEOUS ) then
        	set SoBaseL___ITEM_TYPE_VBACK=SoBaseL___Itemtype_SouL_HunZa
    	endif
    	return SoBaseL___ITEM_TYPE_VBACK
	endfunction
    function EnumUnits takes real r,real x,real y,boolexpr f returns group
        set SO_GROUP_SELCR=CreateGroup()
        call GroupEnumUnitsInRange(SO_GROUP_SELCR, x, y, r, f)
        call DestroyBoolExpr(f)
        return SO_GROUP_SELCR
    endfunction
