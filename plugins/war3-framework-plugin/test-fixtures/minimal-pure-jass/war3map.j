            call AdjustPlayerStateBJ(100, GetOwningPlayer(GetBuyingUnit()), PLAYER_STATE_RESOURCE_GOLD)
            call DisplayTextToPlayer(GetOwningPlayer(GetBuyingUnit()), 0, 0, "|cffffff00你的属性不够了，转换失败！|r")
        else
        endif
    endif
    if ( ( GetItemTypeId(GetSoldItem()) == 'I0C9' ) and ( GetHeroInt(GetBuyingUnit(), false) > 100 ) ) then
        call CreateTextTagUnitBJ("智力转换敏捷！！", GetBuyingUnit(), 0, 20.00, 0.00, 0.00, 100.00, 0)
        call YDWETimerDestroyTextTag(2.00 , GetLastCreatedTextTag())
        call ModifyHeroStat(bj_HEROSTAT_INT, GetBuyingUnit(), bj_MODIFYMETHOD_SUB, 100)
        call ModifyHeroStat(bj_HEROSTAT_AGI, GetBuyingUnit(), bj_MODIFYMETHOD_ADD, 100)
        call AddSpecialEffectLocBJ(GetUnitLoc(GetBuyingUnit()), "Abilities\\Spells\\Human\\Polymorph\\PolyMorphDoneGround.mdl")
    else
        if ( ( GetItemTypeId(GetSoldItem()) == 'I0C9' ) and ( GetHeroInt(GetBuyingUnit(), false) <= 100 ) ) then
            call AdjustPlayerStateBJ(100, GetOwningPlayer(GetBuyingUnit()), PLAYER_STATE_RESOURCE_GOLD)
            call DisplayTextToPlayer(GetOwningPlayer(GetBuyingUnit()), 0, 0, "|cffffff00你的属性不够了，转换失败！|r")
        else
        endif
    endif
endfunction
//===========================================================================
function InitTrig____________________185_______u takes nothing returns nothing
    set gg_trg____________________185_______u=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg____________________185_______u, EVENT_PLAYER_UNIT_SELL_ITEM)
    call TriggerAddAction(gg_trg____________________185_______u, function Trig____________________185_______uActions)
endfunction
