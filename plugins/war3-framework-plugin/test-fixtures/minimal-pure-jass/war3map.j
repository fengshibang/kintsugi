// Trigger: 未命名触发器 127
//===========================================================================
function Trig____________________127Actions takes nothing returns nothing
    if ( ( GetUnitTypeId(GetAttacker()) == 'n00L' ) ) then
        call DisableTrigger(GetTriggeringTrigger())
        call CreateTextTagUnitBJ("四方之风！！！", GetAttacker(), 0, 20.00, 100.00, 0.00, 0.00, 0)
        call YDWETimerDestroyTextTag(2 , GetLastCreatedTextTag())
        call YDWEPolledWaitNull(1.00)
        call CreateNUnitsAtLocFacingLocBJ(1, 'h019', Player(4), PolarProjectionBJ(GetUnitLoc(GetAttacker()), 200.00, 0.00), GetUnitLoc(GetAttacker()))
        call CreateNUnitsAtLocFacingLocBJ(1, 'h019', Player(4), PolarProjectionBJ(GetUnitLoc(GetAttacker()), 200.00, 90.00), GetUnitLoc(GetAttacker()))
        call CreateNUnitsAtLocFacingLocBJ(1, 'h019', Player(4), PolarProjectionBJ(GetUnitLoc(GetAttacker()), 200.00, 180.00), GetUnitLoc(GetAttacker()))
        call CreateNUnitsAtLocFacingLocBJ(1, 'h019', Player(4), PolarProjectionBJ(GetUnitLoc(GetAttacker()), 200.00, 270.00), GetUnitLoc(GetAttacker()))
        call YDWEPolledWaitNull(1.00)
        call CreateNUnitsAtLocFacingLocBJ(1, 'h019', Player(4), PolarProjectionBJ(GetUnitLoc(GetAttacker()), 200.00, 45.00), GetUnitLoc(GetAttacker()))
        call CreateNUnitsAtLocFacingLocBJ(1, 'h019', Player(4), PolarProjectionBJ(GetUnitLoc(GetAttacker()), 200.00, 135.00), GetUnitLoc(GetAttacker()))
        call CreateNUnitsAtLocFacingLocBJ(1, 'h019', Player(4), PolarProjectionBJ(GetUnitLoc(GetAttacker()), 200.00, 225.00), GetUnitLoc(GetAttacker()))
        call CreateNUnitsAtLocFacingLocBJ(1, 'h019', Player(4), PolarProjectionBJ(GetUnitLoc(GetAttacker()), 200.00, 315.00), GetUnitLoc(GetAttacker()))
        call YDWEPolledWaitNull(9.00)
        call EnableTrigger(GetTriggeringTrigger())
    else
    endif
    if ( ( GetUnitTypeId(GetAttacker()) == 'n046' ) ) then
        call DisableTrigger(GetTriggeringTrigger())
        call CreateTextTagUnitBJ("召唤风暴！！！", GetAttacker(), 0, 20.00, 100.00, 0.00, 0.00, 0)
        call YDWETimerDestroyTextTag(2 , GetLastCreatedTextTag())
        call YDWEPolledWaitNull(1.00)
        call CreateNUnitsAtLocFacingLocBJ(1, 'h02R', Player(4), PolarProjectionBJ(GetUnitLoc(GetAttacker()), 600.00, 0.00), GetUnitLoc(GetAttacker()))
        call CreateNUnitsAtLocFacingLocBJ(1, 'h02R', Player(4), PolarProjectionBJ(GetUnitLoc(GetAttacker()), 600.00, 45.00), GetUnitLoc(GetAttacker()))
        call CreateNUnitsAtLocFacingLocBJ(1, 'h02R', Player(4), PolarProjectionBJ(GetUnitLoc(GetAttacker()), 600.00, 90.00), GetUnitLoc(GetAttacker()))
        call CreateNUnitsAtLocFacingLocBJ(1, 'h02R', Player(4), PolarProjectionBJ(GetUnitLoc(GetAttacker()), 600.00, 135.00), GetUnitLoc(GetAttacker()))
        call CreateNUnitsAtLocFacingLocBJ(1, 'h02R', Player(4), PolarProjectionBJ(GetUnitLoc(GetAttacker()), 600.00, 180.00), GetUnitLoc(GetAttacker()))
        call CreateNUnitsAtLocFacingLocBJ(1, 'h02R', Player(4), PolarProjectionBJ(GetUnitLoc(GetAttacker()), 600.00, 225.00), GetUnitLoc(GetAttacker()))
        call CreateNUnitsAtLocFacingLocBJ(1, 'h02R', Player(4), PolarProjectionBJ(GetUnitLoc(GetAttacker()), 600.00, 270.00), GetUnitLoc(GetAttacker()))
        call CreateNUnitsAtLocFacingLocBJ(1, 'h02R', Player(4), PolarProjectionBJ(GetUnitLoc(GetAttacker()), 600.00, 315.00), GetUnitLoc(GetAttacker()))
        call YDWEPolledWaitNull(9.00)
        call EnableTrigger(GetTriggeringTrigger())
    else
    endif
    if ( ( GetUnitTypeId(GetAttacker()) == 'n047' ) ) then
        call DisableTrigger(GetTriggeringTrigger())
        call CreateTextTagUnitBJ("龙卷风冲击！！！", GetAttacker(), 0, 20.00, 100.00, 0.00, 0.00, 0)
        call YDWETimerDestroyTextTag(2 , GetLastCreatedTextTag())
        call YDWEPolledWaitNull(1.00)
        call CreateNUnitsAtLoc(1, 'e017', Player(4), GetUnitLoc(GetAttacker()), bj_UNIT_FACING)
        call IssuePointOrderLoc(bj_lastCreatedUnit, "stampede", GetUnitLoc(GetAttacker()))
        call YDWEPolledWaitNull(10.00)
        call EnableTrigger(GetTriggeringTrigger())
    else
    endif
    if ( ( GetUnitTypeId(GetAttacker()) == 'n04I' ) ) then
        call DisableTrigger(GetTriggeringTrigger())
        call CreateTextTagUnitBJ("交叉之风！！！", GetAttacker(), 0, 20.00, 100.00, 0.00, 0.00, 0)
        call YDWETimerDestroyTextTag(2 , GetLastCreatedTextTag())
        call YDWEPolledWaitNull(1.00)
        call CreateNUnitsAtLocFacingLocBJ(1, 'h019', Player(4), PolarProjectionBJ(GetUnitLoc(GetAttacker()), 200.00, 0.00), GetUnitLoc(GetAttacker()))
        call CreateNUnitsAtLocFacingLocBJ(1, 'h019', Player(4), PolarProjectionBJ(GetUnitLoc(GetAttacker()), 200.00, 90.00), GetUnitLoc(GetAttacker()))
