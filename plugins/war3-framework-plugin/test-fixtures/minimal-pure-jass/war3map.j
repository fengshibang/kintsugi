// endfunction
// [END_ECS_MIGRATED]
//===========================================================================
// Trigger: 未命名触发器 036 复制
//===========================================================================
function Trig____________________036_______uConditions takes nothing returns boolean
    return ( ( GetOwningPlayer(GetTriggerUnit()) == Player(4) ) )
endfunction
function Trig____________________036_______uActions takes nothing returns nothing
    if ( ( GetUnitAbilityLevel(GetAttacker(), 'A09A') >= 1 ) ) then
        if ( ( (GetRandomInt(1, 100)) <= 10 ) ) then // INLINED!!
            call DYCImpaleLinear(GetAttacker() , Xcalld(GetAttacker() , bj_HEROSTAT_AGI , true , 10.00) , 700 , 150 , GetUnitX(GetAttacker()) , GetUnitY(GetAttacker()) , 1000.00 , GetUnitFacing(GetAttacker()) , GetOwningPlayer(GetAttacker()) , 1 , 'AEsh' , 'e002' , "thunderbolt")
            call CreateTextTagUnitBJ("穿刺！！！", GetAttacker(), 0, 20.00, 100.00, 0.00, 0.00, 0)
            call YDWETimerDestroyTextTag(2 , GetLastCreatedTextTag())
        else
        endif
    else
    endif
    if ( ( GetUnitTypeId(GetAttacker()) == 'H002' ) ) then
        call AddSpecialEffectTargetUnitBJ("origin", GetAttacker(), "Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl")
    else
    endif
    if ( ( GetUnitAbilityLevel(GetAttacker(), 'A0VD') >= 1 ) ) then
        call DisableTrigger(GetTriggeringTrigger())
        call ModifyHeroStat((LoadInteger(XGGetHeroMainAttr__htb, GetUnitTypeId((GetAttacker())), 0)), GetAttacker(), bj_MODIFYMETHOD_ADD, 1) // INLINED!!
        call EnableTrigger(GetTriggeringTrigger())
    else
    endif
endfunction
