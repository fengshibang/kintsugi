function InitTrig____________________099_______u takes nothing returns nothing
    set gg_trg____________________099_______u=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg____________________099_______u, EVENT_PLAYER_UNIT_ATTACKED)
    call TriggerAddAction(gg_trg____________________099_______u, function Trig____________________099_______uActions)
endfunction
