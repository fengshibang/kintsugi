//===========================================================================
// Trigger: 未命名触发器 128
//===========================================================================
function Trig____________________128Actions takes nothing returns nothing
    if ( ( GetUnitTypeId(GetAttacker()) == 'n00P' ) ) then
        if ( ( GetRandomInt(1, 100) <= 33 ) ) then
            call DisableTrigger(GetTriggeringTrigger())
            call CreateTextTagUnitBJ("小型地刺！！！", GetAttacker(), 0, 20.00, 100.00, 0.00, 0.00, 0)
            call YDWETimerDestroyTextTag(3.00 , GetLastCreatedTextTag())
            call YDWEPolledWaitNull(1.00)
            call DYCImpaleSector(GetAttacker() , 200000.00 , 700 , 150 , GetUnitX(GetAttacker()) , GetUnitY(GetAttacker()) , 2000 , GetUnitFacing(GetAttacker()) , 10.00 , GetOwningPlayer(GetTriggerUnit()) , 1 , 'AEsh' , 'e00D' , "thunderbolt")
            call YDWEPolledWaitNull(5.00)
            call EnableTrigger(GetTriggeringTrigger())
        else
            if ( ( GetRandomInt(1, 100) <= 50 ) ) then
                call DisableTrigger(GetTriggeringTrigger())
                call CreateTextTagUnitBJ("中型地刺！！！", GetAttacker(), 0, 20.00, 100.00, 0.00, 0.00, 0)
                call YDWETimerDestroyTextTag(3.00 , GetLastCreatedTextTag())
                call YDWEPolledWaitNull(1.00)
                call DYCImpaleSector(GetAttacker() , 15000.00 , 700 , 150 , GetUnitX(GetAttacker()) , GetUnitY(GetAttacker()) , 2000 , GetUnitFacing(GetAttacker()) , 45.00 , GetOwningPlayer(GetTriggerUnit()) , 1 , 'AEsh' , 'e00D' , "thunderbolt")
                call YDWEPolledWaitNull(5.00)
                call EnableTrigger(GetTriggeringTrigger())
            else
                call DisableTrigger(GetTriggeringTrigger())
                call CreateTextTagUnitBJ("大型地刺！！！", GetAttacker(), 0, 20.00, 100.00, 0.00, 0.00, 0)
                call YDWETimerDestroyTextTag(3.00 , GetLastCreatedTextTag())
                call YDWEPolledWaitNull(1.00)
                call DYCImpaleSector(GetAttacker() , 8000.00 , 700 , 150 , GetUnitX(GetAttacker()) , GetUnitY(GetAttacker()) , 2000 , GetUnitFacing(GetAttacker()) , 90.00 , GetOwningPlayer(GetTriggerUnit()) , 1 , 'AEsh' , 'e00D' , "thunderbolt")
                call YDWEPolledWaitNull(5.00)
                call EnableTrigger(GetTriggeringTrigger())
            endif
        endif
    else
    endif
    if ( ( GetUnitTypeId(GetAttacker()) == 'n048' ) ) then
        call DisableTrigger(GetTriggeringTrigger())
        call CreateTextTagUnitBJ("地刺！！！", GetAttacker(), 0, 20.00, 100.00, 0.00, 0.00, 0)
        call YDWETimerDestroyTextTag(2 , GetLastCreatedTextTag())
        call YDWEPolledWaitNull(1.00)
        call CreateNUnitsAtLocFacingLocBJ(1, 'e018', Player(4), GetRandomLocInRect(gg_rct______________006), GetUnitLoc(GetAttacker()))
        call AddSpecialEffectLocBJ(GetUnitLoc(bj_lastCreatedUnit), "Abilities\\Spells\\Undead\\Impale\\ImpaleMissTarget.mdl")
        call CreateNUnitsAtLocFacingLocBJ(1, 'e018', Player(4), GetRandomLocInRect(gg_rct______________006), GetUnitLoc(GetAttacker()))
        call AddSpecialEffectLocBJ(GetUnitLoc(bj_lastCreatedUnit), "Abilities\\Spells\\Undead\\Impale\\ImpaleMissTarget.mdl")
        call CreateNUnitsAtLocFacingLocBJ(1, 'e018', Player(4), GetRandomLocInRect(gg_rct______________006), GetUnitLoc(GetAttacker()))
        call AddSpecialEffectLocBJ(GetUnitLoc(bj_lastCreatedUnit), "Abilities\\Spells\\Undead\\Impale\\ImpaleMissTarget.mdl")
        call CreateNUnitsAtLocFacingLocBJ(1, 'e018', Player(4), GetRandomLocInRect(gg_rct______________006), GetUnitLoc(GetAttacker()))
        call AddSpecialEffectLocBJ(GetUnitLoc(bj_lastCreatedUnit), "Abilities\\Spells\\Undead\\Impale\\ImpaleMissTarget.mdl")
        call CreateNUnitsAtLocFacingLocBJ(1, 'e018', Player(4), GetRandomLocInRect(gg_rct______________006), GetUnitLoc(GetAttacker()))
        call AddSpecialEffectLocBJ(GetUnitLoc(bj_lastCreatedUnit), "Abilities\\Spells\\Undead\\Impale\\ImpaleMissTarget.mdl")
        call CreateNUnitsAtLocFacingLocBJ(1, 'e018', Player(4), GetRandomLocInRect(gg_rct______________006), GetUnitLoc(GetAttacker()))
        call AddSpecialEffectLocBJ(GetUnitLoc(bj_lastCreatedUnit), "Abilities\\Spells\\Undead\\Impale\\ImpaleMissTarget.mdl")
        call CreateNUnitsAtLocFacingLocBJ(1, 'e018', Player(4), GetRandomLocInRect(gg_rct______________006), GetUnitLoc(GetAttacker()))
        call AddSpecialEffectLocBJ(GetUnitLoc(bj_lastCreatedUnit), "Abilities\\Spells\\Undead\\Impale\\ImpaleMissTarget.mdl")
        call CreateNUnitsAtLocFacingLocBJ(1, 'e018', Player(4), GetRandomLocInRect(gg_rct______________006), GetUnitLoc(GetAttacker()))
        call AddSpecialEffectLocBJ(GetUnitLoc(bj_lastCreatedUnit), "Abilities\\Spells\\Undead\\Impale\\ImpaleMissTarget.mdl")
        call CreateNUnitsAtLocFacingLocBJ(1, 'e018', Player(4), GetRandomLocInRect(gg_rct______________006), GetUnitLoc(GetAttacker()))
        call AddSpecialEffectLocBJ(GetUnitLoc(bj_lastCreatedUnit), "Abilities\\Spells\\Undead\\Impale\\ImpaleMissTarget.mdl")
        call YDWEPolledWaitNull(3.00)
        call EnableTrigger(GetTriggeringTrigger())
    else
    endif
    if ( ( GetUnitTypeId(GetAttacker()) == 'n049' ) ) then
        call DisableTrigger(GetTriggeringTrigger())
        call CreateTextTagUnitBJ("大死亡凋零！！！", GetAttacker(), 0, 20.00, 100.00, 0.00, 0.00, 0)
        call YDWETimerDestroyTextTag(2 , GetLastCreatedTextTag())
        call YDWEPolledWaitNull(1.00)
        call CreateNUnitsAtLoc(1, 'e019', Player(4), GetUnitLoc(GetAttacker()), bj_UNIT_FACING)
        call IssuePointOrderLoc(bj_lastCreatedUnit, "deathanddecay", GetUnitLoc(GetAttacker()))
        call YDWEPolledWaitNull(4.00)
        call EnableTrigger(GetTriggeringTrigger())
    else
    endif
endfunction
