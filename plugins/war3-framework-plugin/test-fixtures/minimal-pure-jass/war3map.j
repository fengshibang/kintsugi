function Trig____________________042_______uActions takes nothing returns nothing
    call CreateQuestBJ(bj_QUESTTYPE_REQ_DISCOVERED, "二星装备合成说明
", "TRIGSTR_0", "ReplaceableTextures\\CommandButtons\\BTNHeartOfAszune.blp")
    call CreateQuestBJ(bj_QUESTTYPE_REQ_DISCOVERED, "三星装备合成说明
", "TRIGSTR_1", "ReplaceableTextures\\CommandButtons\\BTNHeartOfAszune.blp")
    call CreateQuestBJ(bj_QUESTTYPE_REQ_DISCOVERED, "四星装备合成说明
", "TRIGSTR_003", "ReplaceableTextures\\CommandButtons\\BTNHeartOfAszune.blp")
    call CreateQuestBJ(bj_QUESTTYPE_OPT_DISCOVERED, "游戏说话命令", "游戏快捷说话：
1： 我准备好了！
2： 好了吗？
3： 等等，先别开！

", "ReplaceableTextures\\CommandButtons\\BTNStaffOfSanctuary.blp")
    call CreateQuestBJ(bj_QUESTTYPE_OPT_DISCOVERED, "查看皮肤命令", "输入 -1 ，可以查看拥有皮肤

输入 -2 ，可以查看未拥有皮肤
", "ReplaceableTextures\\CommandButtons\\BTNStaffOfSanctuary.blp")
endfunction
