function InitCustomTriggers takes nothing returns nothing
    call InitTrig____________________008()
    call InitTrig____________________005()
    call InitTrig____________________008_______u()
    call InitTrig____________________008______________u()
    call InitTrig____________________208()
    call InitTrig____________________208_______u()
    call InitTrig____________________208________2()
    // call InitTrig____________________208________3()  -- [ECS_MIGRATED] 商店初始库存 208________3
    // call InitTrig____________________208________3_______u()  -- [ECS_MIGRATED] 商店初始库存 208________3_______u
    // call InitTrig____________________048()  -- [ECS_MIGRATED] 准备时间/难度选择 048
    // call InitTrig____________________050()  -- [ECS_MIGRATED] 难度选择(青铜~钻石)
//     call InitTrig____________________050_______u() -- [ECS_MIGRATED] 难度选择对话框
    call InitTrig____________________076()
//     call InitTrig____________________078()  // [ECS_MIGRATED] 078 出售物品→合成(I079系列)
    call InitTrig____________________076_______u()
