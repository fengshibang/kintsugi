//===========================================================================
// Trigger: 未命名触发器 158
//===========================================================================
function Trig____________________158Actions takes nothing returns nothing
    if ( ( GetUnitTypeId(GetAttacker()) == 'n02G' ) ) then
        // RushSlide 已迁移到 ECS Lua 系统 (UnitAttackTriggerRushSlide)
        return
    else
    endif
    if ( ( GetUnitTypeId(GetAttacker()) == 'n04B' ) ) then
        call DisableTrigger(GetTriggeringTrigger())
        call CreateTextTagUnitBJ("疾风步！！！", GetAttacker(), 0, 20.00, 100.00, 0.00, 0.00, 0)
        call YDWETimerDestroyTextTag(2 , GetLastCreatedTextTag())
        call YDWEPolledWaitNull(1.00)
        call UnitAddAbility(GetAttacker(), 'A0LQ')
        call IssueImmediateOrder(GetAttacker(), "windwalk")
        call YDWEPolledWaitNull(1.00)
        call IssueTargetOrder(GetAttacker(), "attack", GetTriggerUnit())
        call YDWEPolledWaitNull(2.00)
        call UnitRemoveAbility(GetAttacker(), 'A0LQ')
        call YDWEPolledWaitNull(3.00)
        call EnableTrigger(GetTriggeringTrigger())
    else
    endif
    if ( ( GetUnitTypeId(GetAttacker()) == 'n04N' ) ) then
        call DisableTrigger(GetTriggeringTrigger())
        call CreateTextTagUnitBJ("召唤食人鬼！！！", GetAttacker(), 0, 20.00, 100.00, 0.00, 0.00, 0)
        call YDWETimerDestroyTextTag(2 , GetLastCreatedTextTag())
        call YDWEPolledWaitNull(1.00)
        call CreateNUnitsAtLocFacingLocBJ(1, 'h03O', Player(4), GetRandomLocInRect(gg_rct______________000), GetUnitLoc(GetAttacker()))
        call CreateNUnitsAtLocFacingLocBJ(1, 'h03O', Player(4), GetRandomLocInRect(gg_rct______________000), GetUnitLoc(GetAttacker()))
        call CreateNUnitsAtLocFacingLocBJ(1, 'h03O', Player(4), GetRandomLocInRect(gg_rct______________000), GetUnitLoc(GetAttacker()))
        call CreateNUnitsAtLocFacingLocBJ(1, 'h03O', Player(4), GetRandomLocInRect(gg_rct______________000), GetUnitLoc(GetAttacker()))
        call CreateNUnitsAtLocFacingLocBJ(1, 'h03O', Player(4), GetRandomLocInRect(gg_rct______________000), GetUnitLoc(GetAttacker()))
        call YDWEPolledWaitNull(5.00)
        call EnableTrigger(GetTriggeringTrigger())
    else
    endif
endfunction
//===========================================================================
function InitTrig____________________158 takes nothing returns nothing
    set gg_trg____________________158=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg____________________158, EVENT_PLAYER_UNIT_ATTACKED)
    call TriggerAddAction(gg_trg____________________158, function Trig____________________158Actions)
endfunction
