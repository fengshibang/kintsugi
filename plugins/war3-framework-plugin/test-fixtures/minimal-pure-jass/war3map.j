//library unWEUnitInventoryCountByType:
 
function unWEUnitInventoryCountByType takes unit whichUnit,integer itemcode returns integer
    local integer index= 0
    local integer count= 0
    loop
        if ( GetItemTypeId(UnitItemInSlot(whichUnit, index)) == itemcode ) then
            set count=count + 1
        endif
        set index=index + 1
        exitwhen index >= bj_MAX_INVENTORY
    endloop
    return count
endfunction
 

