    if ( ( GetUnitTypeId(GetAttacker()) == 'n03F' ) ) then
        // RushSlide 已迁移到 ECS Lua 系统 (UnitAttackTriggerRushSlide)
        return
    else
    endif
    if ( ( GetUnitTypeId(GetAttacker()) == 'n04C' ) ) then
