    if ( b ) then
    if ( ( s != - 1.00 ) ) then
    call SetUnitLifePercentBJ(d, s)
    else
    endif
        if ( ( s1 != - 1.00 ) ) then
    call SetUnitManaPercentBJ(d, s1)
    else
    endif
    else
    if ( ( s != - 1.00 ) ) then
    call SetUnitLifeBJ(d, s)
    else
    endif
    if ( ( s1 != - 1.00 ) ) then
    call SetUnitManaBJ(d, s1)
    else
    endif
    endif
endfunction
