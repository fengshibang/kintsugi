//===========================================================================
// Trigger: 未命名触发器 235
//===========================================================================
function Trig____________________235Conditions takes nothing returns boolean
    return ( ( GetOwningPlayer(GetTriggerUnit()) == Player(4) ) )
endfunction
function Trig____________________235Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    if ( ( GetUnitAbilityLevel(GetEventDamageSource(), 'A0O8') >= 1 ) ) then
        call SoHeroStateAmend(GetEventDamageSource() , 0 , 1 , 0)
    else
    endif
    if ( ( GetUnitAbilityLevel(GetEventDamageSource(), 'A0O9') >= 1 ) ) then
        call SoHeroStateAmend(GetEventDamageSource() , 0 , 3 , 0)
    else
    endif
    if ( ( GetUnitAbilityLevel(GetEventDamageSource(), 'A0OA') >= 1 ) ) then
        call SoHeroStateAmend(GetEventDamageSource() , 0 , 5 , 0)
    else
    endif
    if ( ( GetUnitAbilityLevel(GetEventDamageSource(), 'A0OB') >= 1 ) ) then
        call SoHeroStateAmend(GetEventDamageSource() , 0 , 10 , 0)
    else
    endif
    if ( ( GetUnitAbilityLevel(GetEventDamageSource(), 'A0OC') >= 1 ) ) then
        call SoHeroStateAmend(GetEventDamageSource() , 0 , 20 , 0)
    else
    endif
    call EnableTrigger(GetTriggeringTrigger())
endfunction
//===========================================================================
function InitTrig____________________235 takes nothing returns nothing
    set gg_trg____________________235=CreateTrigger()
    call YDWESyStemAnyUnitDamagedRegistTrigger(gg_trg____________________235)
    call TriggerAddCondition(gg_trg____________________235, Condition(function Trig____________________235Conditions))
    call TriggerAddAction(gg_trg____________________235, function Trig____________________235Actions)
endfunction
//===========================================================================
// Trigger: 未命名触发器 235 复制
//===========================================================================
function Trig____________________235_______uConditions takes nothing returns boolean
    return ( ( GetOwningPlayer(GetTriggerUnit()) == Player(4) ) )
endfunction
function Trig____________________235_______uActions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    if ( ( GetUnitAbilityLevel(GetEventDamageSource(), 'A0PN') >= 1 ) ) then
        call SoHeroStateAmend(GetEventDamageSource() , 0 , 5 , 0)
    else
    endif
    if ( ( GetUnitAbilityLevel(GetEventDamageSource(), 'A0Q2') >= 1 ) ) then
        call SoHeroStateAmend(GetEventDamageSource() , 0 , 1 , 0)
    else
    endif
    if ( ( GetUnitAbilityLevel(GetEventDamageSource(), 'A0Q8') >= 1 ) ) then
        call SoHeroStateAmend(GetEventDamageSource() , 0 , 3 , 0)
    else
    endif
    if ( ( GetUnitAbilityLevel(GetEventDamageSource(), 'A0QC') >= 1 ) ) then
        call SoHeroStateAmend(GetEventDamageSource() , 0 , 10 , 0)
    else
    endif
    if ( ( GetUnitAbilityLevel(GetEventDamageSource(), 'A0QD') >= 1 ) ) then
        call SoHeroStateAmend(GetEventDamageSource() , 0 , 20 , 0)
    else
    endif
    call EnableTrigger(GetTriggeringTrigger())
endfunction
//===========================================================================
function InitTrig____________________235_______u takes nothing returns nothing
    set gg_trg____________________235_______u=CreateTrigger()
    call YDWESyStemAnyUnitDamagedRegistTrigger(gg_trg____________________235_______u)
    call TriggerAddCondition(gg_trg____________________235_______u, Condition(function Trig____________________235_______uConditions))
    call TriggerAddAction(gg_trg____________________235_______u, function Trig____________________235_______uActions)
