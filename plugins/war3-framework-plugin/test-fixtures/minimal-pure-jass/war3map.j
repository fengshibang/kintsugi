    endif
    if ( ( GetUnitAbilityLevel(GetEventDamageSource(), 'A0D3') < 10 ) and ( GetUnitAbilityLevel(GetEventDamageSource(), 'A0D3') >= 1 ) ) then
        if ( ( GetRandomInt(1, 100) <= 1 ) ) then
