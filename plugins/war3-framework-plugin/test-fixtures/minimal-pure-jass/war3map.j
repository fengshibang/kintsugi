//===========================================================================
// Trigger: 未命名触发器 191
//===========================================================================
function Trig____________________191Conditions takes nothing returns boolean
    return ( ( GetOwningPlayer(GetTriggerUnit()) == Player(4) ) )
endfunction
function Trig____________________191Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    if ( ( YDWEUnitHasItemOfTypeBJNull(GetEventDamageSource() , 'I0CH') == true ) and ( GetUnitTypeId(GetEventDamageSource()) == 'H02P' ) ) then
        call SoAddUnitState(GetEventDamageSource() , 1.00 , ConvertUnitState(0x13))
    else
    endif
    if ( ( YDWEUnitHasItemOfTypeBJNull(GetEventDamageSource() , 'I0CG') == true ) and ( GetUnitTypeId(GetEventDamageSource()) == 'H02I' ) ) then
        call SoAddUnitState(GetEventDamageSource() , 3.00 , UNIT_STATE_MAX_LIFE)
        call SoAddUnitState(GetEventDamageSource() , 3.00 , UNIT_STATE_LIFE)
    else
    endif
    if ( ( YDWEUnitHasItemOfTypeBJNull(GetEventDamageSource() , 'I0HJ') == true ) and ( GetUnitTypeId(GetEventDamageSource()) == 'H03G' ) ) then
        call SoHeroStateAmend(GetEventDamageSource() , 0 , 0 , 1)
    else
    endif
    if ( ( YDWEUnitHasItemOfTypeBJNull(GetEventDamageSource() , 'I0HK') == true ) and ( GetUnitTypeId(GetEventDamageSource()) == 'H03B' ) ) then
        if ( ( (GetRandomInt(1, 100)) <= 10 ) ) then // INLINED!!
            call Xg_SDL(GetEventDamageSource() , GetTriggerUnit() , - 0.12 , 9 , Xcalld(GetEventDamageSource() , (LoadInteger(XGGetHeroMainAttr__htb, GetUnitTypeId((GetEventDamageSource())), 0)) , true , 1) , 600.00 , false , false , "CLPB" , "CLSB") // INLINED!!
            call YDWEPolledWaitNull(1.00)
        else
        endif
    else
    endif
    if ( ( YDWEUnitHasItemOfTypeBJNull(GetEventDamageSource() , 'I0HL') == true ) and ( GetUnitTypeId(GetEventDamageSource()) == 'H03A' ) ) then
        call UnitDamageTargetBJ(GetEventDamageSource(), GetTriggerUnit(), ( ( 1.00 ) * ( I2R(GetHeroStatBJ((LoadInteger(XGGetHeroMainAttr__htb, GetUnitTypeId((GetEventDamageSource())), 0)), GetEventDamageSource(), true)) ) ), ATTACK_TYPE_MELEE, DAMAGE_TYPE_NORMAL) // INLINED!!
    else
    endif
    call EnableTrigger(GetTriggeringTrigger())
endfunction
//===========================================================================
function InitTrig____________________191 takes nothing returns nothing
    set gg_trg____________________191=CreateTrigger()
    call YDWESyStemAnyUnitDamagedRegistTrigger(gg_trg____________________191)
    call TriggerAddCondition(gg_trg____________________191, Condition(function Trig____________________191Conditions))
    call TriggerAddAction(gg_trg____________________191, function Trig____________________191Actions)
endfunction
//===========================================================================
// Trigger: 未命名触发器 191 复制
//===========================================================================
function Trig____________________191_______uConditions takes nothing returns boolean
    return ( ( GetOwningPlayer(GetTriggerUnit()) == Player(4) ) )
endfunction
function Trig____________________191_______uActions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    if ( ( YDWEUnitHasItemOfTypeBJNull(GetEventDamageSource() , 'I0HO') == true ) and ( GetUnitTypeId(GetEventDamageSource()) == 'H03C' ) ) then
        if ( ( (GetRandomInt(1, 100)) <= 10 ) ) then // INLINED!!
            call UnitResetCooldown(GetEventDamageSource())
            call CreateTextTagUnitBJ("刷新！！！", GetEventDamageSource(), 0, 20.00, 100.00, 0.00, 0.00, 0)
            call YDWETimerDestroyTextTag(2 , GetLastCreatedTextTag())
        else
        endif
    else
    endif
    call EnableTrigger(GetTriggeringTrigger())
endfunction
//===========================================================================
function InitTrig____________________191_______u takes nothing returns nothing
    set gg_trg____________________191_______u=CreateTrigger()
    call YDWESyStemAnyUnitDamagedRegistTrigger(gg_trg____________________191_______u)
    call TriggerAddCondition(gg_trg____________________191_______u, Condition(function Trig____________________191_______uConditions))
    call TriggerAddAction(gg_trg____________________191_______u, function Trig____________________191_______uActions)
endfunction
